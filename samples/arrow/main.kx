// main.kx — one target at z=30, one arrow launched toward it
int main() {
    var target = spawn {
        Pos3 { x = 0, y = 0, z = 30 },
        Health { hp = 10 },
        tags [Combatant, Spatial]
    };
    spawn {
        Pos3 { x = 0, y = 0, z = 0 },
        Arrow { sender = target },
        tags [Projectile, Spatial]
    };
    run(max, ticks: 35);
    std.println("arrow demo done");
    return 0;
}