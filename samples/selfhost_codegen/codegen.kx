        }
        return "i1 " + r;
    }
    if (e.kind == "member") {
        var base = GenExpr(g, Child(arena, e, 0), arena);
        var bv = XVal(base);
        var bt = XType(base);
        var m = e.value;
        if (m == "Count" && bt == "i64") {
            var r = "%" + Lbl(g, "r");
            Emit(g, "  " + r + " = call i64 @kx_list_size(i64 " + bv + ")");
            return "i64 " + r;
        }
        if (m == "Length" && bt == "ptr") {
            var r = "%" + Lbl(g, "r");
            Emit(g, "  " + r + " = call i64 @kx_str_len(ptr " + bv + ")");
            return "i64 " + r;
        }
        var structName = "";
        var baseExpr = Child(arena, e, 0);
        if (baseExpr.kind == "identifier" && g.lt.Has(baseExpr.value)) {
            var varType = g.lt.Get(baseExpr.value);
            if (varType.StartsWith("struct:")) structName = varType.Substring(7);
        } else if (baseExpr.kind == "call") {
            var innerCallee = Child(arena, baseExpr, 0);
            if (innerCallee.kind == "identifier" && g.sigs.Has(innerCallee.value)) {
                var returned = SigRet(g.sigs.Get(innerCallee.value));
                if (returned.StartsWith("struct:")) structName = returned.Substring(7);
            }
        } else if (baseExpr.kind == "member") {
            var walk = baseExpr;
            var depth = 0;
            while (walk.kind == "member" && depth < 16) {
                walk = Child(arena, walk, 0);
                depth++;
            }
            if (walk.kind == "identifier" && g.lt.Has(walk.value)) {
                var varType = g.lt.Get(walk.value);
                if (varType.StartsWith("struct:")) structName = varType.Substring(7);
            }
        }
        if (structName != "" && g.structs.Has(structName)) {
            var fields = SplitAll(g.structs.Get(structName), ",");
            if (fields.Get(0) == "") fields = List<string>();
            var fidx = -1;
            for (var fi = 0; fi < fields.Count; fi++) {
                if (fields.Get(fi) == m) { fidx = fi; break; }
            }
            if (fidx >= 0) {
                var r = "%" + Lbl(g, "r");
                Emit(g, "  " + r + " = call i64 @kx_struct_get(i64 " + bv + ", i32 " + IntStr(fidx) + ")");
                if (m == "kind" || m == "text" || m == "value") {
                    var p = "%" + Lbl(g, "field");
                    Emit(g, "  " + p + " = inttoptr i64 " + r + " to ptr");
                    return "ptr " + p;
                }
                return "i64 " + r;
            }
        }
        if (bt == "i64" && m != "Count") {
            if (baseExpr.kind == "identifier" && g.lt.Has(baseExpr.value)) {
                var varType = g.lt.Get(baseExpr.value);
                if (varType.StartsWith("struct:")) {
                    var structName = varType.Substring(7);
                    if (g.structs.Has(structName)) {
                        var fieldStr = g.structs.Get(structName);
                        var fields = SplitAll(fieldStr, ",");
                        if (fields.Get(0) == "") fields = List<string>();
                        var fidx = -1;
                        for (var fi = 0; fi < fields.Count; fi++) {
                            if (fields.Get(fi) == m) { fidx = fi; break; }
