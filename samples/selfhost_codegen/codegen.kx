                var want = KxType(wantSemantic);
                var av = Coerce(g, a, want);
                argStr += want + " " + av;
            }
            var r = "%" + Lbl(g, "r");
            var callRetIR = KxType(callRet);
            if (callRetIR == "void") {
                Emit(g, "  call void @" + callee.value + "(" + argStr + ")");
                return "void 0";
            }
            Emit(g, "  " + r + " = call " + callRetIR + " @" + callee.value + "(" + argStr + ")");
            if (callRet.StartsWith("struct:")) {
                return callRet + " " + r;
            }
            return callRetIR + " " + r;
        }
         return "i64 0";
    }
    if (e.kind == "ternary") {
        var cond = GenExpr(g, Child(arena, e, 0), arena);
        var cv = XVal(cond);
        if (XType(cond) == "i64") {
            var ext = "%" + Lbl(g, "ext");
            Emit(g, "  " + ext + " = icmp ne i64 " + cv + ", 0");
            cv = ext;
        }
        var tl = Lbl(g, "tern.then"); var el = Lbl(g, "tern.else"); var ml = Lbl(g, "tern.merge");
        Emit(g, "  br i1 " + cv + ", label %" + tl + ", label %" + el);
        Emit(g, tl + ":");
        var tv = GenExpr(g, Child(arena, e, 1), arena);
        Emit(g, "  br label %" + ml);
        Emit(g, el + ":");
        var fv = GenExpr(g, Child(arena, e, 2), arena);
        Emit(g, "  br label %" + ml);
        Emit(g, ml + ":");
        var t = "%" + Lbl(g, "phi");
        Emit(g, "  " + t + " = phi " + XType(tv) + " [" + XVal(tv) + ", %" + tl + "], [" + XVal(fv) + ", %" + el + "]");
        return XType(tv) + " " + t;
    }
    if (e.kind == "assign") {
        var rhs = GenExpr(g, Child(arena, e, 1), arena);
        var lhs = Child(arena, e, 0);
        var asOp = e.value;
        if (asOp != "assign" && lhs.kind == "identifier" && g.ln.Has(lhs.value)) {
            var lhsType = g.lt.Get(lhs.value);
            var rhsType = XType(rhs);
            var rhsVal = XVal(rhs);
            if (lhsType == "ptr" || rhsType == "ptr") {
                var cur = "%" + Lbl(g, "cur");
                Emit(g, "  " + cur + " = load ptr, ptr " + g.ln.Get(lhs.value));
                var rv2 = rhsVal;
                if (rhsType != "ptr") {
                    var ext2 = "%" + Lbl(g, "ext");
                    Emit(g, "  " + ext2 + " = call ptr @kx_int_str(" + rhsType + " " + rhsVal + ")");
                    rv2 = ext2;
                }
                var cat = "%" + Lbl(g, "cat");
                Emit(g, "  " + cat + " = call ptr @kx_str_cat(ptr " + cur + ", ptr " + rv2 + ")");
                rhsVal = cat; rhsType = "ptr"; g.lt.Set(lhs.value, "ptr");
            } else {
                var lt = lhsType == "i64" ? "i64" : (lhsType == "i32" ? "i32" : "i64");
                var cur = "%" + Lbl(g, "cur");
                Emit(g, "  " + cur + " = load " + lt + ", ptr " + g.ln.Get(lhs.value));
                var rv = rhsVal;
                if (lt != rhsType) {
                    var ext = "%" + Lbl(g, "ext");
                    Emit(g, "  " + ext + " = sext i32 " + rhsVal + " to i64");
                    rv = ext;
                    if (lt == "i32") {
                        var tr = "%" + Lbl(g, "tr");
                        Emit(g, "  " + tr + " = trunc i64 " + rv + " to i32");
                        rv = tr;
                    }
                }
                var op = "add";
                if (asOp == "subassign") op = "sub";
                else if (asOp == "mulassign") op = "mul";
                else if (asOp == "divassign") op = "sdiv";
                else if (asOp == "modassign") op = "srem";
                var res = "%" + Lbl(g, "as");
                Emit(g, "  " + res + " = " + op + " " + lt + " " + cur + ", " + rv);
                rhsVal = res; rhsType = lt;
            }
            Emit(g, "  store " + rhsType + " " + rhsVal + ", ptr " + g.ln.Get(lhs.value));
            return rhsType + " " + rhsVal;
        }
        if (lhs.kind == "identifier" && g.ln.Has(lhs.value)) {
            var lhsType = g.lt.Get(lhs.value);
            var rhsType = XType(rhs);
            var rhsVal = XVal(rhs);
            if (lhsType != rhsType) {
                if (lhsType == "i64" && rhsType == "i32") {
                    var ext = "%" + Lbl(g, "ext");
                    Emit(g, "  " + ext + " = sext i32 " + rhsVal + " to i64");
                    rhsVal = ext; rhsType = "i64";
                } else if (lhsType == "i32" && rhsType == "i64") {
                    var trunc = "%" + Lbl(g, "trunc");
                    Emit(g, "  " + trunc + " = trunc i64 " + rhsVal + " to i32");
                    rhsVal = trunc; rhsType = "i32";
                } else if (lhsType == "ptr" && rhsType == "i64") {
                    var cast = "%" + Lbl(g, "inttoptr");
                    Emit(g, "  " + cast + " = inttoptr i64 " + rhsVal + " to ptr");
                    rhsVal = cast; rhsType = "ptr";
                } else if (lhsType == "i64" && rhsType == "ptr") {
                    var cast = "%" + Lbl(g, "ptrtoint");
                    Emit(g, "  " + cast + " = ptrtoint ptr " + rhsVal + " to i64");
                    rhsVal = cast; rhsType = "i64";
                }
            }
            Emit(g, "  store " + rhsType + " " + rhsVal + ", ptr " + g.ln.Get(lhs.value));
            return lhsType + " " + rhsVal;
        }
        return rhs;
    }
    return "i64 0";
}

// ---- statement codegen ----

var GenStmt(g, s, arena) {
    if (s.kind == "vardecl") {
        var nm = Child(arena, s, 0).value;
        var rhs = GenExpr(g, Child(arena, s, 1), arena);
        var rt = XType(rhs);
        var rv = XVal(rhs);
        var uniqueNm = Lbl(g, nm);
        g.lc.Set(0, g.lc.Get(0) + 1);
        if (Child(arena, s, 1).kind == "structinit") {
            var structName = Child(arena, s, 1).value;
            if (g.structs.Has(structName)) {
                Emit(g, "  %" + uniqueNm + " = alloca i64");
                Emit(g, "  store i64 " + rv + ", ptr %" + uniqueNm);
                g.lt.Set(nm, "struct:" + structName);
                g.ln.Set(nm, "%" + uniqueNm);
                return 0;
            }
        }
        if (rt.StartsWith("struct:")) {
            Emit(g, "  %" + uniqueNm + " = alloca i64");
            Emit(g, "  store i64 " + rv + ", ptr %" + uniqueNm);
            g.lt.Set(nm, rt);
            g.ln.Set(nm, "%" + uniqueNm);
            return 0;
        }
        if (rt == "void") { rt = "i64"; rv = "0"; }
        Emit(g, "  %" + uniqueNm + " = alloca " + rt);
        Emit(g, "  store " + rt + " " + rv + ", ptr %" + uniqueNm);
        g.lt.Set(nm, rt); g.ln.Set(nm, "%" + uniqueNm);
        return 0;
    }
    if (s.kind == "expr") { GenExpr(g, Child(arena, s, 0), arena); return 0; }
     if (s.kind == "return") {
        if (s.children.Count > 0) {
            var v = GenExpr(g, Child(arena, s, 0), arena);
            var vt = XType(v);
            var vv = XVal(v);
            if (g.curFnRet == "i64" && vt == "i1") {
                var ext = "%" + Lbl(g, "ext");
                Emit(g, "  " + ext + " = zext i1 " + vv + " to i64");
                vv = ext; vt = "i64";
            } else if (g.curFnRet == "i64" && vt == "ptr") {
                var ext = "%" + Lbl(g, "ext");
                Emit(g, "  " + ext + " = ptrtoint ptr " + vv + " to i64");
                vv = ext; vt = "i64";
            } else if (g.curFnRet == "i1" && vt == "i64") {
                var ext = "%" + Lbl(g, "ext");
                Emit(g, "  " + ext + " = icmp ne i64 " + vv + ", 0");
                vv = ext; vt = "i1";
            } else if (g.curFnRet == "ptr" && vt == "i64") {
                var ext = "%" + Lbl(g, "ext");
                Emit(g, "  " + ext + " = inttoptr i64 " + vv + " to ptr");
                vv = ext; vt = "ptr";
            }
            if (vt.StartsWith("struct:")) { vt = "i64"; }
            if (vt != g.curFnRet && vt == "i32") {
                var ext2 = "%" + Lbl(g, "ext");
                Emit(g, "  " + ext2 + " = sext i32 " + vv + " to i64");
                vv = ext2; vt = "i64";
            }
            Emit(g, "  ret " + vt + " " + vv);
        } else { Emit(g, "  ret void"); }
        return 0;
    }
    if (s.kind == "block") {
        for (var i = 0; i < s.children.Count; i++) { GenStmt(g, Child(arena, s, i), arena); }
        return 0;
    }
    if (s.kind == "if") {
        var c = GenExpr(g, Child(arena, s, 0), arena);
        var cv = XVal(c);
        if (XType(c) == "i64") {
            var ext = "%" + Lbl(g, "ext");
            Emit(g, "  " + ext + " = icmp ne i64 " + cv + ", 0");
            cv = ext;
        }
        var tl = Lbl(g, "if.then"); var ml = Lbl(g, "if.merge");
        if (s.children.Count > 2) {
            var el = Lbl(g, "if.else");
            Emit(g, "  br i1 " + cv + ", label %" + tl + ", label %" + el);
            Emit(g, tl + ":"); GenStmt(g, Child(arena, s, 1), arena); Emit(g, "  br label %" + ml);
            Emit(g, el + ":"); GenStmt(g, Child(arena, s, 2), arena); Emit(g, "  br label %" + ml);
        } else {
            Emit(g, "  br i1 " + cv + ", label %" + tl + ", label %" + ml);
            Emit(g, tl + ":"); GenStmt(g, Child(arena, s, 1), arena); Emit(g, "  br label %" + ml);
        }
        Emit(g, ml + ":");
        return 0;
    }
    if (s.kind == "while") {
        var cl = Lbl(g, "w.cond"); var bl = Lbl(g, "w.body"); var el = Lbl(g, "w.end");
        Emit(g, "  br label %" + cl); Emit(g, cl + ":");
        var c = GenExpr(g, Child(arena, s, 0), arena);
        var cv = XVal(c);
        if (XType(c) == "i64") {
            var ext = "%" + Lbl(g, "ext");
            Emit(g, "  " + ext + " = icmp ne i64 " + cv + ", 0");
            cv = ext;
        }
        Emit(g, "  br i1 " + cv + ", label %" + bl + ", label %" + el);
        Emit(g, bl + ":");
        if (g.curFnName == "LexAll" && g.ln.Has("pos")) {
            var dbgPos = "%" + Lbl(g, "dbgpos");
            Emit(g, "  " + dbgPos + " = load i32, ptr " + g.ln.Get("pos"));
            var dbgExt = "%" + Lbl(g, "dbgext");
            Emit(g, "  " + dbgExt + " = sext i32 " + dbgPos + " to i64");
            var dbgStr = "%" + Lbl(g, "dbgstr");
            Emit(g, "  " + dbgStr + " = call ptr @kx_int_str(i64 " + dbgExt + ")");
            Emit(g, "  call i64 @kx_println(ptr " + dbgStr + ")");
        }
        g.breakTargets.Add(el);
        g.continueTargets.Add(cl);
        GenStmt(g, Child(arena, s, 1), arena);
        g.breakTargets.RemoveAt(g.breakTargets.Count - 1);
        g.continueTargets.RemoveAt(g.continueTargets.Count - 1);
        Emit(g, "  br label %" + cl);
        Emit(g, el + ":");
        return 0;
    }
    if (s.kind == "for") {
        var bodyIdx = s.children.Count - 1;
        var condLabel = Lbl(g, "for.cond");
        var bodyLabel = Lbl(g, "for.body");
        var incLabel = Lbl(g, "for.inc");
        var endLabel = Lbl(g, "for.end");
        var i = 0;
        if (s.children.Count > 1 && arena.Get(s.children.Get(0)).kind == "vardecl") {
            GenStmt(g, Child(arena, s, 0), arena);
            i = 1;
        }
        Emit(g, "  br label %" + condLabel);
        Emit(g, condLabel + ":");
        if (i < bodyIdx) {
            var cond = GenExpr(g, Child(arena, s, i), arena);
            Emit(g, "  br i1 " + XVal(cond) + ", label %" + bodyLabel + ", label %" + endLabel);
            i++;
        } else {
            Emit(g, "  br label %" + bodyLabel);
        }
        Emit(g, bodyLabel + ":");
        g.breakTargets.Add(endLabel);
        g.continueTargets.Add(incLabel);
        GenStmt(g, Child(arena, s, bodyIdx), arena);
        g.breakTargets.RemoveAt(g.breakTargets.Count - 1);
        g.continueTargets.RemoveAt(g.continueTargets.Count - 1);
        Emit(g, "  br label %" + incLabel);
        Emit(g, incLabel + ":");
        if (i < bodyIdx) {
            GenExpr(g, Child(arena, s, i), arena);
        }
        Emit(g, "  br label %" + condLabel);
        Emit(g, endLabel + ":");
        return 0;
    }
    if (s.kind == "foreach") {
        var varNm = Child(arena, s, 0).value;
        var container = GenExpr(g, Child(arena, s, 1), arena);
        var cv = XVal(container);
        if (XType(container) == "ptr") {
            var cvc = "%" + Lbl(g, "c");
            Emit(g, "  " + cvc + " = ptrtoint ptr " + cv + " to i64");
            cv = cvc;
        }
        var idxVar = "%" + Lbl(g, "fe.idx");
        var elemVar = "%" + Lbl(g, "fe.elem");
        Emit(g, "  " + elemVar + " = alloca i64");
        Emit(g, "  " + idxVar + " = alloca i64");
        Emit(g, "  store i64 0, ptr " + idxVar);
        var cl = Lbl(g, "fe.cond");
        var bl = Lbl(g, "fe.body");
        var el = Lbl(g, "fe.end");
        Emit(g, "  br label %" + cl);
        Emit(g, cl + ":");
        var idx = "%" + Lbl(g, "idx");
        Emit(g, "  " + idx + " = load i64, ptr " + idxVar);
        var len = "%" + Lbl(g, "len");
        Emit(g, "  " + len + " = call i64 @kx_list_size(i64 " + cv + ")");
        var cmp = "%" + Lbl(g, "cmp");
        Emit(g, "  " + cmp + " = icmp slt i64 " + idx + ", " + len);
        Emit(g, "  br i1 " + cmp + ", label %" + bl + ", label %" + el);
        Emit(g, bl + ":");
        var elem = "%" + Lbl(g, "elem");
        Emit(g, "  " + elem + " = call i64 @kx_list_get(i64 " + cv + ", i64 " + idx + ")");
        Emit(g, "  store i64 " + elem + ", ptr " + elemVar);
        g.lt.Set(varNm, "i64"); g.ln.Set(varNm, elemVar);
        g.breakTargets.Add(el);
        g.continueTargets.Add(cl);
        GenStmt(g, Child(arena, s, 2), arena);
        g.breakTargets.RemoveAt(g.breakTargets.Count - 1);
        g.continueTargets.RemoveAt(g.continueTargets.Count - 1);
        var nextIdx = "%" + Lbl(g, "next");
        Emit(g, "  " + nextIdx + " = add i64 " + idx + ", 1");
        Emit(g, "  store i64 " + nextIdx + ", ptr " + idxVar);
        Emit(g, "  br label %" + cl);
        Emit(g, el + ":");
        return 0;
    }
    if (s.kind == "switch") {
        var cond = GenExpr(g, Child(arena, s, 0), arena);
        var endLabel = Lbl(g, "sw.end");
        var defaultLabel = endLabel;
        var caseLabels = List<string>();
        for (var ci = 1; ci < s.children.Count; ci++) {
            caseLabels.Add(Lbl(g, "sw.case"));
        }
        var hasDefault = false;
        for (var ci = 1; ci < s.children.Count; ci++) {
            var caseNode = Child(arena, s, ci);
            var blockChild = -1;
            for (var k = 0; k < caseNode.children.Count; k++) {
                if (arena.Get(caseNode.children.Get(k)).kind == "block") {
                    blockChild = k;
                    break;
                }
            }
            if (blockChild >= 0) {
                var last = -1;
                var blk = Child(arena, caseNode, blockChild);
                if (blk.children.Count > 0) {
                    last = blk.children.Count - 1;
                    var lastStmt = arena.Get(blk.children.Get(last));
                    if (lastStmt.kind == "return" || lastStmt.kind == "break") {
                    } else { last = -1; }
                }
            }
        }
        for (var ci = 1; ci < s.children.Count; ci++) {
            var caseNode = Child(arena, s, ci);
            Emit(g, "  br label %" + caseLabels.Get(ci - 1));
            Emit(g, caseLabels.Get(ci - 1) + ":");
            for (var k = 0; k < caseNode.children.Count; k++) {
                var child = Child(arena, caseNode, k);
                if (child.kind == "block") {
                    GenStmt(g, child, arena);
                } else {
                    var cv = GenExpr(g, child, arena);
                    var cmp = "%" + Lbl(g, "cmp");
                    Emit(g, "  " + cmp + " = icmp eq " + XType(cond) + " " + XVal(cond) + ", " + XVal(cv));
                    var trueLabel = Lbl(g, "sw.true");
                    Emit(g, "  br i1 " + cmp + ", label %" + trueLabel + ", label %" + caseLabels.Get(ci));
                    Emit(g, trueLabel + ":");
                }
            }
        }
        Emit(g, endLabel + ":");
        return 0;
    }
    if (s.kind == "break") {
        if (g.breakTargets.Count > 0) Emit(g, "  br label %" + g.breakTargets.Get(g.breakTargets.Count - 1));
        return 0;
    }
    if (s.kind == "continue") {
        if (g.continueTargets.Count > 0) Emit(g, "  br label %" + g.continueTargets.Get(g.continueTargets.Count - 1));
        return 0;
    }
    return 0;
}

// ---- function codegen ----

var GenFunc(g, decl, arena) {
    var nm = Child(arena, decl, 0).value;
    var ret = Child(arena, decl, 1).value;
    var params = List<string>();
    for (var i = 2; i < decl.children.Count; i++) {
        var c = Child(arena, decl, i);
        if (c.kind == "param") params.Add(c.value);
    }
    var sig = g.sigs.Has(nm) ? g.sigs.Get(nm) : KxType(ret) + "|";
    var sigParams = SigParams(sig);
    var irRet = KxType(SigRet(sig)); if (nm == "main") irRet = "i32";
    g.curFnRet = irRet;
    g.curFnName = nm;
    var irP = "";
    if (nm == "main") {
        irP = "i32 %argc, ptr %argv";
    } else {
        for (var i = 0; i < params.Count; i++) {
            if (i > 0) irP += ", ";
            irP += KxType(sigParams.Get(i)) + " %" + params.Get(i);
        }
    }
    Emit(g, "define " + irRet + " @" + nm + "(" + irP + ") {");
    Emit(g, "entry:");
    g.lt = Map<string, string>(); g.ln = Map<string, string>();
    g.breakTargets = List<string>();
    g.continueTargets = List<string>();
    g.terminated.Set(0, 0);
    if (nm == "main") {
        Emit(g, "  call void @kx_save_args(i32 %argc, ptr %argv)");
    }
    for (var i = 0; i < params.Count; i++) {
        var p = params.Get(i);
        var pType = KxType(sigParams.Get(i));
        var allocaNm = "%" + p + ".addr";
        Emit(g, "  " + allocaNm + " = alloca " + pType);
        Emit(g, "  store " + pType + " %" + p + ", ptr " + allocaNm);
        g.lt.Set(p, pType); g.ln.Set(p, allocaNm);
    }
    for (var i = 0; i < params.Count; i++) {
        var sem = sigParams.Get(i);
        if (sem.StartsWith("struct:")) { g.lt.Set(params.Get(i), sem); }
    }
    GenStmt(g, Child(arena, decl, decl.children.Count - 1), arena);
    if (ret == "void") {
        Emit(g, "  ret void");
    } else if (nm == "main") {
        Emit(g, "  ret i32 0");
    } else if (irRet == "ptr") {
        Emit(g, "  ret ptr null");
    } else if (irRet == "i1") {
        Emit(g, "  ret i1 false");
    } else {
        Emit(g, "  ret " + irRet + " 0");
    }
    Emit(g, "}"); Emit(g, "");
    return 0;
}

// ---- main ----

int main() {
    var args = std.args();
    if (args.Count < 3) { std.println("usage: codegen <input.kx> <output.ll>"); return 1; }
    var src = std.readFile(args.Get(1));
    var content = src;
    var tokens = LexAll(content);
    var pos = List<int>(); pos.Add(0);
    var arena = List<AstNode>();
    var errors = List<string>();
    var rootIdx = ParseProgram(tokens, pos, arena, errors, args.Get(1));
    if (errors.Count > 0) { foreach (var e in errors) { std.println(e); } return 1; }
    var root = arena.Get(rootIdx);
    var g = NewIR();
    Emit(g, "target triple = \"x86_64-unknown-linux-gnu\"");
    Emit(g, "");
    EmitDecls(g);
    for (var i = 0; i < root.children.Count; i++) {
        var d = Child(arena, root, i);
        if (d.kind == "struct") {
            var name = Child(arena, d, 0).value;
            var fieldStr = "";
            for (var fi = 1; fi < d.children.Count; fi++) {
                var f = Child(arena, d, fi);
                if (f.kind == "field") {
                    if (fieldStr != "") fieldStr += ",";
                    fieldStr += f.value;
                }
            }
            g.structs.Set(name, fieldStr);
            g.structVars.Add(name);
        }
    }
    InferSignatures(g, root, arena);
    for (var i = 0; i < root.children.Count; i++) {
        var d = Child(arena, root, i);
        if (d.kind == "struct") {
            var name = Child(arena, d, 0).value;
            var fieldStr = "";
            for (var fi = 1; fi < d.children.Count; fi++) {
                var f = Child(arena, d, fi);
                if (f.kind == "field") {
                    if (fieldStr != "") fieldStr += ",";
                    fieldStr += f.value;
                }
            }
            g.structs.Set(name, fieldStr);
            g.structVars.Add(name);
        }
        if (d.kind == "function") GenFunc(g, d, arena);
        if (d.kind == "extern") {
            var name = Child(arena, d, 1).value;
            var retType = Child(arena, d, 0).value;
            var params = List<string>();
            for (var pi = 2; pi < d.children.Count; pi++) {
                var c = Child(arena, d, pi);
                if (c.kind == "paramtype") params.Add(c.value);
            }
            var irRet = KxType(retType);
            var irP = "";
            for (var pi = 0; pi < params.Count; pi++) {
                if (pi > 0) irP += ", ";
                irP += KxType(params.Get(pi));
            }
            Emit(g, "declare " + irRet + " @" + name + "(" + irP + ")");
        }
    }
    var out = ""; for (var i = 0; i < g.lines.Count; i++) { out += g.lines.Get(i) + "\n"; } for (var pi = 0; pi < g.pending.Count; pi++) { out += g.pending.Get(pi) + "\n"; } std.writeFile(args.Get(2), out);
    return 0;
}
