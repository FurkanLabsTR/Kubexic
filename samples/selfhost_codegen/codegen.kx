                    }
                }
            }
            var guessStruct = FindStructWithField(g, m);
            if (guessStruct != "" && g.structs.Has(guessStruct)) {
                var gfields = SplitAll(g.structs.Get(guessStruct), ",");
                if (gfields.Get(0) == "") gfields = List<string>();
                for (var gi = 0; gi < gfields.Count; gi++) {
                    if (gfields.Get(gi) == m) {
