                            var gp = "%" + Lbl(g, "field");
                            Emit(g, "  " + gp + " = inttoptr i64 " + gr + " to ptr");
                            return "ptr " + gp;
                        }
                        return "i64 " + gr;
                    }
                }
            }
        }
        return base;
    }
    if (e.kind == "call") {
        var callee = Child(arena, e, 0);
        if (callee.kind == "member") {
