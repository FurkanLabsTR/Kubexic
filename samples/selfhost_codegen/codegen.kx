// codegen.kx — minimal LLVM IR text code generator for Kubexic
// Self-contained: includes lexer, parser, and IR generator.
// Generates .ll files that can be compiled with clang.

// parser.kx — the Kubexic recursive-descent parser, written in Kubexic.
// Produces an arena-indexed AST and dumps it in the exact format of
// 'kxc dump' so the two implementations can be diffed byte-for-byte.

struct Token {
    var kind = "";
    var text = "";
    var line = 0;
    var col = 0;
}

struct AstNode {
    var kind = "";
    var value = "";
    var line = 0;
    var col = 0;
    var children = List<int>();
}

var IsDigit(c) {
    return c >= "0" && c <= "9";
}

var IsLetter(c) {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z");
}

var IsIdentPart(c) {
    return IsLetter(c) || IsDigit(c) || c == "_";
}

var IsSpace(c) {
    return c == " " || c == "\t" || c == "\n" || c == "\r";
}

var CharAt(s, i) {
    if (i < 0 || i >= s.Length) {
        return "";
    }
    return s.Substring(i, 1);
}

var LexAll(src) {
    var tokens = List<Token>();
    var pos = 0;
    var line = 1;
    var col = 1;
    var n = src.Length;
    while (pos < n) {
        var c = CharAt(src, pos);
        if (IsSpace(c)) {
            pos++;
            col++;
            if (c == "\n") {
                line++;
                col = 1;
            }
            continue;
        }
        if (c == "/" && CharAt(src, pos + 1) == "/") {
            while (pos < n && CharAt(src, pos) != "\n") {
                pos++;
                col++;
            }
            continue;
        }
        if (c == "/" && CharAt(src, pos + 1) == "*") {
            pos += 2;
            col += 2;
            while (pos < n && !(CharAt(src, pos) == "*" && CharAt(src, pos + 1) == "/")) {
                if (CharAt(src, pos) == "\n") {
                    line++;
                    col = 1;
                } else {
                    col++;
                }
                pos++;
            }
            pos += 2;
            col += 2;
            continue;
        }
        if (IsLetter(c) || c == "_") {
            var start = pos;
            var startCol = col;
            var startLine = line;
            while (pos < n && IsIdentPart(CharAt(src, pos))) {
                pos++;
                col++;
            }
            var text = src.Substring(start, pos - start);
            var kind = "id";
            if (text == "component" || text == "system" || text == "tag" ||
                text == "struct" || text == "enum" || text == "const" ||
                text == "var" || text == "void" || text == "int" ||
                text == "long" || text == "float" || text == "double" ||
                text == "bool" || text == "byte" || text == "string" ||
                text == "if" || text == "else" || text == "while" ||
                text == "for" || text == "foreach" || text == "in" ||
                text == "break" || text == "continue" || text == "return" ||
                text == "spawn" || text == "despawn" || text == "attach" ||
                text == "detach" || text == "self" || text == "with" ||
                text == "without" || text == "new" || text == "tags" ||
                text == "using" || text == "true" || text == "false" ||
                text == "is" || text == "exact" || text == "panic" ||
                text == "switch" || text == "case" || text == "default" ||
                text == "extern") {
                kind = "kw";
            }
            tokens.Add(Token { kind = kind, text = text, line = startLine, col = startCol });
            continue;
        }
        if (IsDigit(c)) {
            var start = pos;
            var startCol = col;
            var startLine = line;
            var isFloat = false;
            while (pos < n && IsDigit(CharAt(src, pos))) {
                pos++;
                col++;
            }
            if (CharAt(src, pos) == "." && IsDigit(CharAt(src, pos + 1))) {
                isFloat = true;
                pos++;
                col++;
                while (pos < n && IsDigit(CharAt(src, pos))) {
                    pos++;
                    col++;
                }
            }
            var text = src.Substring(start, pos - start);
            tokens.Add(Token { kind = isFloat ? "float" : "int", text = text,
                               line = startLine, col = startCol });
            continue;
        }
        if (c == "$" && CharAt(src, pos + 1) == "\"") {
            var startCol = col;
            var startLine = line;
            pos += 2;
            col += 2;
            var text = "";
            var depth = 0;
            while (pos < n) {
                var dc = CharAt(src, pos);
                if (dc == "{") {
                    depth++;
                    text += dc;
                    pos++;
                    col++;
                    continue;
                }
                if (dc == "}") {
                    if (depth > 0) {
                        depth--;
                    }
                    text += dc;
                    pos++;
                    col++;
                    continue;
                }
                if (dc == "\"" && depth == 0) {
                    break;
                }
                if (dc == "\"" && depth > 0) {
                    text += dc;
                    pos++;
                    col++;
                    while (pos < n) {
                        var q = CharAt(src, pos);
                        text += q;
                        pos++;
                        col++;
                        if (q == "\\" && pos < n) {
                            text += CharAt(src, pos);
                            pos++;
                            col++;
                            continue;
                        }
                        if (q == "\"") {
                            break;
                        }
                    }
                    continue;
                }
                text += dc;
                pos++;
                col++;
            }
            pos++;
            col++;
            tokens.Add(Token { kind = "dstr", text = text, line = startLine, col = startCol });
            continue;
        }
        if (c == "\"") {
            var startCol = col;
            var startLine = line;
            pos++;
            col++;
            var text = "";
            while (pos < n && CharAt(src, pos) != "\"") {
                if (CharAt(src, pos) == "\\" && pos + 1 < n) {
                    var esc = CharAt(src, pos + 1);
                    if (esc == "n") {
                        text += "\n";
                    } else if (esc == "t") {
                        text += "\t";
                    } else if (esc == "r") {
                        text += "\r";
                    } else if (esc == "\\") {
                        text += "\\";
                    } else if (esc == "\"") {
                        text += "\"";
                    } else if (esc == "'") {
                        text += "'";
                    } else {
                        text += "\\";
                        text += esc;
                    }
                    pos += 2;
                    col += 2;
                } else {
                    text += CharAt(src, pos);
                    pos++;
                    col++;
                }
            }
            pos++;
            col++;
            tokens.Add(Token { kind = "string", text = text, line = startLine, col = startCol });
            continue;
        }
        var two = src.Substring(pos, 2);
        if (two == "==" || two == "!=" || two == "<=" || two == ">=" ||
            two == "&&" || two == "||" || two == "+=" || two == "-=" ||
            two == "*=" || two == "/=" || two == "%=" || two == "++" ||
            two == "--") {
            tokens.Add(Token { kind = "op", text = two, line = line, col = col });
            pos += 2;
            col += 2;
            continue;
        }
        tokens.Add(Token { kind = "punct", text = c, line = line, col = col });
        pos++;
        col++;
    }
    tokens.Add(Token { kind = "eof", text = "", line = line, col = col });
    return tokens;
}

/* ---------------- arena helpers ---------------- */

var NewNode(arena, kind, value, line, col) {
    arena.Add(AstNode { kind = kind, value = value, line = line, col = col,
                        children = List<int>() });
    return arena.Count - 1;
}

var Node(arena, i) {
    return arena.Get(i);
}

var TrimFloat(s) {
    var out = s;
    while (out.Length > 0 && out.EndsWith("0")) {
        out = out.Substring(0, out.Length - 1);
    }
    if (out.Length > 0 && out.EndsWith(".")) {
        out = out.Substring(0, out.Length - 1);
    }
    if (out == "-") {
        out = "-0";
    }
    if (out == "") {
        out = "0";
    }
    return out;
}

void AddChild(arena, parent, child) {
    var children = arena.Get(parent).children;
    children.Add(child);
}

/* ---------------- cursor helpers ---------------- */

var Peek(tokens, pos) {
    return tokens.Get(pos.Get(0));
}

var CurKind(tokens, pos) {
    return Peek(tokens, pos).kind;
}

var CurText(tokens, pos) {
    return Peek(tokens, pos).text;
}

var CurLine(tokens, pos) {
    return Peek(tokens, pos).line;
}

var CurCol(tokens, pos) {
    return Peek(tokens, pos).col;
}

var AtEnd(tokens, pos) {
    return CurKind(tokens, pos) == "eof";
}

void Advance(tokens, pos) {
    pos.Set(0, pos.Get(0) + 1);
}

var IsKw(tokens, pos, w) {
    var t = Peek(tokens, pos);
    return t.kind == "kw" && t.text == w;
}

var IsPunct(tokens, pos, p) {
    var t = Peek(tokens, pos);
    return t.kind == "punct" && t.text == p;
}

var IsOp(tokens, pos, o) {
    var t = Peek(tokens, pos);
    return t.kind == "op" && t.text == o;
}

var IsNameTok(tokens, pos) {
    var t = Peek(tokens, pos);
    return t.kind == "id" || t.kind == "kw";
}

var MatchKw(tokens, pos, w) {
    if (IsKw(tokens, pos, w)) {
        Advance(tokens, pos);
        return true;
    }
    return false;
}

var MatchPunct(tokens, pos, p) {
    if (IsPunct(tokens, pos, p)) {
        Advance(tokens, pos);
        return true;
    }
    return false;
}

var MatchOp(tokens, pos, o) {
    if (IsOp(tokens, pos, o)) {
        Advance(tokens, pos);
        return true;
    }
    return false;
}

var ExpectPunct(tokens, pos, p, errors, what) {
    if (!MatchPunct(tokens, pos, p)) {
        errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected {what}");
        return false;
    }
    return true;
}

var ExpectName(tokens, pos, errors, what) {
    if (IsNameTok(tokens, pos)) {
        Advance(tokens, pos);
        return true;
    }
    errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected {what}");
    return false;
}

var PrevText(tokens, pos) {
    return tokens.Get(pos.Get(0) - 1).text;
}

/* ---------------- expression parsing ---------------- */

var ParsePrimary(tokens, pos, arena, errors) {
    var t = Peek(tokens, pos);
    var loc = NewNode(arena, "loc", "", t.line, t.col);
    if (t.kind == "int") {
        Advance(tokens, pos);
        return NewNode(arena, "int", t.text, t.line, t.col);
    }
    if (t.kind == "float") {
        Advance(tokens, pos);
        return NewNode(arena, "float", t.text, t.line, t.col);
    }
    if (t.kind == "string") {
        Advance(tokens, pos);
        return NewNode(arena, "string", t.text, t.line, t.col);
    }
    if (t.kind == "dstr") {
        Advance(tokens, pos);
        return ParseInterpolated(arena, t.text, t.line, t.col);
    }
    if (t.kind == "kw" && t.text == "true") {
        Advance(tokens, pos);
        return NewNode(arena, "bool", "true", t.line, t.col);
    }
    if (t.kind == "kw" && t.text == "false") {
        Advance(tokens, pos);
        return NewNode(arena, "bool", "false", t.line, t.col);
    }
    if (t.kind == "kw" && t.text == "self") {
        Advance(tokens, pos);
        return NewNode(arena, "identifier", "self", t.line, t.col);
    }
    if (t.kind == "kw" && t.text == "spawn") {
        Advance(tokens, pos);
        return ParseSpawn(tokens, pos, arena, errors);
    }
    if (t.kind == "id") {
        Advance(tokens, pos);
        if (IsPunct(tokens, pos, "{")) {
            Advance(tokens, pos);
            var node = NewNode(arena, "structinit", t.text, t.line, t.col);
            while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
                if (!IsNameTok(tokens, pos)) {
                    break;
                }
                var fname = CurText(tokens, pos);
                Advance(tokens, pos);
                if (!ExpectPunct(tokens, pos, "=", errors, "'=' in component initializer")) {
                    break;
                }
                var initNode = NewNode(arena, "field", fname, t.line, t.col);
                AddChild(arena, initNode, ParseExpression(tokens, pos, arena, errors));
                AddChild(arena, node, initNode);
                if (!MatchPunct(tokens, pos, ",")) {
                    break;
                }
            }
            ExpectPunct(tokens, pos, "}", errors, "'}' to close component initializer");
            return node;
        }
        if (IsPunct(tokens, pos, "(")) {
            return ParseCall(tokens, pos, arena, errors, NewNode(arena, "identifier",
                                                                 t.text, t.line, t.col), List<string>());
        }
        return NewNode(arena, "identifier", t.text, t.line, t.col);
    }
    if (IsPunct(tokens, pos, "(")) {
        Advance(tokens, pos);
        var inner = ParseExpression(tokens, pos, arena, errors);
        ExpectPunct(tokens, pos, ")", errors, "')'");
        return inner;
    }
    errors.Add($"{t.line}:{t.col}: expected an expression");
    Advance(tokens, pos);
    return NewNode(arena, "int", "0", t.line, t.col);
}

var ParseCall(tokens, pos, arena, errors, callee, typeArgs) {
    var node = NewNode(arena, "call", "", CurLine(tokens, pos), CurCol(tokens, pos));
    AddChild(arena, node, callee);
    foreach (var ta in typeArgs) {
        var taNode = NewNode(arena, "typearg", ta, 0, 0);
        AddChild(arena, node, taNode);
    }
    if (!ExpectPunct(tokens, pos, "(", errors, "'('")) {
        return node;
    }
    while (!IsPunct(tokens, pos, ")") && !AtEnd(tokens, pos)) {
        var argNode = NewNode(arena, "arg", "", CurLine(tokens, pos), CurCol(tokens, pos));
        if (IsNameTok(tokens, pos)) {
            var maybeName = Peek(tokens, pos);
            var next = tokens.Get(pos.Get(0) + 1);
            if (next.kind == "punct" && next.text == ":") {
                Advance(tokens, pos);
                Advance(tokens, pos);
                var nameNode = NewNode(arena, "argname", maybeName.text, maybeName.line,
                                       maybeName.col);
                AddChild(arena, argNode, nameNode);
            }
        }
        AddChild(arena, argNode, ParseExpression(tokens, pos, arena, errors));
        AddChild(arena, node, argNode);
        if (!MatchPunct(tokens, pos, ",")) {
            break;
        }
    }
    ExpectPunct(tokens, pos, ")", errors, "')'");
    return node;
}

var ParseTypeArgs(tokens, pos) {
    var out = List<string>();
    if (!IsPunct(tokens, pos, "<")) {
        return out;
    }
    var save = pos.Get(0);
    Advance(tokens, pos);
    while (IsNameTok(tokens, pos) && !IsPunct(tokens, pos, ">")) {
        out.Add(CurText(tokens, pos));
        Advance(tokens, pos);
        if (!MatchPunct(tokens, pos, ",")) {
            break;
        }
    }
    if (!MatchPunct(tokens, pos, ">")) {
        pos.Set(0, save);
        return List<string>();
    }
    return out;
}

var ParsePostfix(tokens, pos, arena, errors) {
    var e = ParsePrimary(tokens, pos, arena, errors);
    for (;;) {
        if (MatchPunct(tokens, pos, ".")) {
            if (!IsNameTok(tokens, pos)) {
                errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected member name after '.'");
                return e;
            }
            var m = NewNode(arena, "member", CurText(tokens, pos), CurLine(tokens, pos),
                            CurCol(tokens, pos));
            Advance(tokens, pos);
            AddChild(arena, m, e);
            e = m;
            continue;
        }
        if (IsPunct(tokens, pos, "<")) {
            var savePos = pos.Get(0);
            var typeArgs = ParseTypeArgs(tokens, pos);
            if (typeArgs.Count > 0 && IsPunct(tokens, pos, "(")) {
                e = ParseCall(tokens, pos, arena, errors, e, typeArgs);
                continue;
            }
            pos.Set(0, savePos);
            return e;
        }
        if (IsPunct(tokens, pos, "(")) {
            e = ParseCall(tokens, pos, arena, errors, e, List<string>());
            continue;
        }
        if (IsKw(tokens, pos, "is")) {
            Advance(tokens, pos);
            var isNode = NewNode(arena, "is", "", CurLine(tokens, pos), CurCol(tokens, pos));
            AddChild(arena, isNode, e);
            if (IsNameTok(tokens, pos)) {
                var typeNode = NewNode(arena, "istype", CurText(tokens, pos),
                                       CurLine(tokens, pos), CurCol(tokens, pos));
                Advance(tokens, pos);
                AddChild(arena, isNode, typeNode);
            }
            if (IsNameTok(tokens, pos)) {
                var varNode = NewNode(arena, "isvar", CurText(tokens, pos),
                                      CurLine(tokens, pos), CurCol(tokens, pos));
                Advance(tokens, pos);
                AddChild(arena, isNode, varNode);
            }
            e = isNode;
            continue;
        }
        if (IsOp(tokens, pos, "++") || IsOp(tokens, pos, "--")) {
            var uOp = CurText(tokens, pos);
            Advance(tokens, pos);
            var u = NewNode(arena, "unary", uOp == "++" ? "postinc" : "postdec",
                            CurLine(tokens, pos), CurCol(tokens, pos));
            AddChild(arena, u, e);
            e = u;
            continue;
        }
        return e;
    }
}

var ParseBinaryFrom(e, tokens, pos, arena, errors, opText) {
    Advance(tokens, pos);
    var node = NewNode(arena, "binary", opText, CurLine(tokens, pos), CurCol(tokens, pos));
    AddChild(arena, node, e);
    AddChild(arena, node, ParseUnary(tokens, pos, arena, errors));
    return node;
}

var ParseUnary(tokens, pos, arena, errors) {
    if (IsKw(tokens, pos, "exact")) {
        Advance(tokens, pos);
        var u = NewNode(arena, "unary", "exact", CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, u, ParseUnary(tokens, pos, arena, errors));
        return u;
    }
    if (IsPunct(tokens, pos, "!")) {
        Advance(tokens, pos);
        var u = NewNode(arena, "unary", "not", CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, u, ParseUnary(tokens, pos, arena, errors));
        return u;
    }
    if (IsPunct(tokens, pos, "-")) {
        Advance(tokens, pos);
        var u = NewNode(arena, "unary", "neg", CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, u, ParseUnary(tokens, pos, arena, errors));
        return u;
    }
    return ParsePostfix(tokens, pos, arena, errors);
}

var ParseMultiplicative(tokens, pos, arena, errors) {
    var lhs = ParseUnary(tokens, pos, arena, errors);
    for (;;) {
        var op = "";
        if (IsPunct(tokens, pos, "*")) {
            op = "mul";
        } else if (IsPunct(tokens, pos, "/")) {
            op = "div";
        } else if (IsPunct(tokens, pos, "%")) {
            op = "mod";
        } else {
            return lhs;
        }
        Advance(tokens, pos);
        var node = NewNode(arena, "binary", op, CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, node, lhs);
        AddChild(arena, node, ParseUnary(tokens, pos, arena, errors));
        lhs = node;
    }
}

var ParseAdditive(tokens, pos, arena, errors) {
    var lhs = ParseMultiplicative(tokens, pos, arena, errors);
    for (;;) {
        var op = "";
        if (IsPunct(tokens, pos, "+")) {
            op = "add";
        } else if (IsPunct(tokens, pos, "-")) {
            op = "sub";
        } else {
            return lhs;
        }
        Advance(tokens, pos);
        var node = NewNode(arena, "binary", op, CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, node, lhs);
        AddChild(arena, node, ParseMultiplicative(tokens, pos, arena, errors));
        lhs = node;
    }
}

var ParseRelational(tokens, pos, arena, errors) {
    var lhs = ParseAdditive(tokens, pos, arena, errors);
    for (;;) {
        var op = "";
        if (IsPunct(tokens, pos, "<")) {
            op = "lt";
        } else if (IsPunct(tokens, pos, ">")) {
            op = "gt";
        } else if (IsOp(tokens, pos, "<=")) {
            op = "le";
        } else if (IsOp(tokens, pos, ">=")) {
            op = "ge";
        } else {
            return lhs;
        }
        Advance(tokens, pos);
        var node = NewNode(arena, "binary", op, CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, node, lhs);
        AddChild(arena, node, ParseAdditive(tokens, pos, arena, errors));
        lhs = node;
    }
}

var ParseEquality(tokens, pos, arena, errors) {
    var lhs = ParseRelational(tokens, pos, arena, errors);
    for (;;) {
        var op = "";
        if (IsOp(tokens, pos, "==")) {
            op = "eq";
        } else if (IsOp(tokens, pos, "!=")) {
            op = "ne";
        } else {
            return lhs;
        }
        Advance(tokens, pos);
        var node = NewNode(arena, "binary", op, CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, node, lhs);
        AddChild(arena, node, ParseRelational(tokens, pos, arena, errors));
        lhs = node;
    }
}

var ParseLogicalAnd(tokens, pos, arena, errors) {
    var lhs = ParseEquality(tokens, pos, arena, errors);
    for (;;) {
        if (!IsOp(tokens, pos, "&&")) {
            return lhs;
        }
        Advance(tokens, pos);
        var node = NewNode(arena, "binary", "and", CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, node, lhs);
        AddChild(arena, node, ParseEquality(tokens, pos, arena, errors));
        lhs = node;
    }
}

var ParseLogicalOr(tokens, pos, arena, errors) {
    var lhs = ParseLogicalAnd(tokens, pos, arena, errors);
    for (;;) {
        if (!IsOp(tokens, pos, "||")) {
            return lhs;
        }
        Advance(tokens, pos);
        var node = NewNode(arena, "binary", "or", CurLine(tokens, pos), CurCol(tokens, pos));
        AddChild(arena, node, lhs);
        AddChild(arena, node, ParseLogicalAnd(tokens, pos, arena, errors));
        lhs = node;
    }
}

var ParseTernary(tokens, pos, arena, errors) {
    var cond = ParseLogicalOr(tokens, pos, arena, errors);
    if (!IsPunct(tokens, pos, "?")) {
        return cond;
    }
    Advance(tokens, pos);
    var node = NewNode(arena, "ternary", "", CurLine(tokens, pos), CurCol(tokens, pos));
    AddChild(arena, node, cond);
    AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
    ExpectPunct(tokens, pos, ":", errors, "':' in ternary");
    AddChild(arena, node, ParseTernary(tokens, pos, arena, errors));
    return node;
}

var ParseAssignOp(tokens, pos) {
    if (MatchPunct(tokens, pos, "=")) {
        return "assign";
    }
    if (MatchOp(tokens, pos, "+=")) {
        return "addassign";
    }
    if (MatchOp(tokens, pos, "-=")) {
        return "subassign";
    }
    if (MatchOp(tokens, pos, "*=")) {
        return "mulassign";
    }
    if (MatchOp(tokens, pos, "/=")) {
        return "divassign";
    }
    if (MatchOp(tokens, pos, "%=")) {
        return "modassign";
    }
    return "";
}

var ParseExpression(tokens, pos, arena, errors) {
    var lhs = ParseTernary(tokens, pos, arena, errors);
    var eqLine = CurLine(tokens, pos);
    var eqCol = CurCol(tokens, pos);
    var op = ParseAssignOp(tokens, pos);
    if (op == "") {
        return lhs;
    }
    var node = NewNode(arena, "assign", op, eqLine, eqCol);
    AddChild(arena, node, lhs);
    AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
    return node;
}

/* ---------------- spawn / interpolation ---------------- */

var ParseSpawn(tokens, pos, arena, errors) {
    var node = NewNode(arena, "spawn", "", CurLine(tokens, pos), CurCol(tokens, pos));
    if (!ExpectPunct(tokens, pos, "{", errors, "'{' after spawn")) {
        return node;
    }
    while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
        if (IsKw(tokens, pos, "tags")) {
            Advance(tokens, pos);
            if (ExpectPunct(tokens, pos, "[", errors, "'[' after tags")) {
                while (IsNameTok(tokens, pos) && !IsPunct(tokens, pos, "]")) {
                    var tn = NewNode(arena, "spawntag", CurText(tokens, pos),
                                     CurLine(tokens, pos), CurCol(tokens, pos));
                    Advance(tokens, pos);
                    AddChild(arena, node, tn);
                    if (!MatchPunct(tokens, pos, ",")) {
                        break;
                    }
                }
                ExpectPunct(tokens, pos, "]", errors, "']' to close tags");
            }
        } else {
            var ci = ParseComponentInit(tokens, pos, arena, errors);
            AddChild(arena, node, ci);
        }
        if (!MatchPunct(tokens, pos, ",")) {
            break;
        }
    }
    ExpectPunct(tokens, pos, "}", errors, "'}' to close spawn");
    return node;
}

var ParseComponentInit(tokens, pos, arena, errors) {
    var node = NewNode(arena, "compinit", "", CurLine(tokens, pos), CurCol(tokens, pos));
    if (IsNameTok(tokens, pos)) {
        var tn = NewNode(arena, "compname", CurText(tokens, pos), CurLine(tokens, pos),
                         CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, tn);
    }
    if (ExpectPunct(tokens, pos, "{", errors, "'{' after component type")) {
        while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
            if (!IsNameTok(tokens, pos)) {
                break;
            }
            var fname = CurText(tokens, pos);
            Advance(tokens, pos);
            if (!ExpectPunct(tokens, pos, "=", errors, "'=' in component initializer")) {
                break;
            }
            var initNode = NewNode(arena, "field", fname, CurLine(tokens, pos),
                                   CurCol(tokens, pos));
            AddChild(arena, initNode, ParseExpression(tokens, pos, arena, errors));
            AddChild(arena, node, initNode);
            if (!MatchPunct(tokens, pos, ",")) {
                break;
            }
        }
        ExpectPunct(tokens, pos, "}", errors, "'}' to close component initializer");
    }
    return node;
}

var ParseInterpolated(arena, content, line, col) {
    var node = NewNode(arena, "interpolated", "", line, col);
    var lit = "";
    var i = 0;
    var n = content.Length;
    while (i < n) {
        var c = CharAt(content, i);
        if (c == "{") {
            var ln = NewNode(arena, "lit", lit, line, col);
            AddChild(arena, node, ln);
            lit = "";
            var depth = 1;
            var j = i + 1;
            var inner = "";
            while (j < n && depth > 0) {
                var d = CharAt(content, j);
                if (d == "{") {
                    depth++;
                } else if (d == "}") {
                    depth--;
                }
                if (depth > 0) {
                    inner += d;
                }
                j++;
            }
            var sub = LexAll(inner);
            var sp = List<int>();
            sp.Add(0);
            var expr = ParseExpression(sub, sp, arena, List<string>());
            var en = NewNode(arena, "interpexpr", "", line, col);
            AddChild(arena, en, expr);
            AddChild(arena, node, en);
            i = j;
        } else {
            lit += c;
            i++;
        }
    }
    var ln = NewNode(arena, "lit", lit, line, col);
    AddChild(arena, node, ln);
    return node;
}

/* ---------------- statements ---------------- */

var ParseBlock(tokens, pos, arena, errors) {
    var node = NewNode(arena, "block", "", CurLine(tokens, pos), CurCol(tokens, pos));
    if (!ExpectPunct(tokens, pos, "{", errors, "'{' to start block")) {
        return node;
    }
    while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
        AddChild(arena, node, ParseStatement(tokens, pos, arena, errors));
    }
    ExpectPunct(tokens, pos, "}", errors, "'}' to close block");
    return node;
}

var ParseStatement(tokens, pos, arena, errors) {
    if (IsPunct(tokens, pos, "{")) {
        return ParseBlock(tokens, pos, arena, errors);
    }
    if (IsKw(tokens, pos, "var")) {
        var node = NewNode(arena, "vardecl", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (IsNameTok(tokens, pos)) {
            var vn = NewNode(arena, "varname", CurText(tokens, pos), CurLine(tokens, pos),
                             CurCol(tokens, pos));
            Advance(tokens, pos);
            AddChild(arena, node, vn);
        }
        if (ExpectPunct(tokens, pos, "=", errors, "'=' in variable declaration")) {
            AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
        }
        ExpectPunct(tokens, pos, ";", errors, "';' after variable declaration");
        return node;
    }
    if (IsKw(tokens, pos, "if")) {
        var node = NewNode(arena, "if", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (ExpectPunct(tokens, pos, "(", errors, "'(' after if")) {
            AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
            ExpectPunct(tokens, pos, ")", errors, "')' after if condition");
        }
        AddChild(arena, node, ParseStatement(tokens, pos, arena, errors));
        if (MatchKw(tokens, pos, "else")) {
            AddChild(arena, node, ParseStatement(tokens, pos, arena, errors));
        }
        return node;
    }
    if (IsKw(tokens, pos, "while")) {
        var node = NewNode(arena, "while", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (ExpectPunct(tokens, pos, "(", errors, "'(' after while")) {
            AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
            ExpectPunct(tokens, pos, ")", errors, "')' after while condition");
        }
        AddChild(arena, node, ParseStatement(tokens, pos, arena, errors));
        return node;
    }
    if (IsKw(tokens, pos, "for")) {
        var node = NewNode(arena, "for", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (!ExpectPunct(tokens, pos, "(", errors, "'(' after for")) {
            return node;
        }
        if (!IsPunct(tokens, pos, ";")) {
            if (IsKw(tokens, pos, "var")) {
                var init = NewNode(arena, "vardecl", "", CurLine(tokens, pos),
                                   CurCol(tokens, pos));
                Advance(tokens, pos);
                if (IsNameTok(tokens, pos)) {
                    var vn = NewNode(arena, "varname", CurText(tokens, pos),
                                     CurLine(tokens, pos), CurCol(tokens, pos));
                    Advance(tokens, pos);
                    AddChild(arena, init, vn);
                }
                if (ExpectPunct(tokens, pos, "=", errors, "'=' in variable declaration")) {
                    AddChild(arena, init, ParseExpression(tokens, pos, arena, errors));
                }
                AddChild(arena, node, init);
            } else {
                AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
            }
        }
        ExpectPunct(tokens, pos, ";", errors, "';' after for init");
        if (!IsPunct(tokens, pos, ";")) {
            AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
        }
        ExpectPunct(tokens, pos, ";", errors, "';' after for condition");
        if (!IsPunct(tokens, pos, ")")) {
            AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
        }
        ExpectPunct(tokens, pos, ")", errors, "')' after for clauses");
        AddChild(arena, node, ParseStatement(tokens, pos, arena, errors));
        return node;
    }
    if (IsKw(tokens, pos, "foreach")) {
        var node = NewNode(arena, "foreach", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (ExpectPunct(tokens, pos, "(", errors, "'(' after foreach")) {
            MatchKw(tokens, pos, "var");
            if (IsNameTok(tokens, pos)) {
                var vn = NewNode(arena, "varname", CurText(tokens, pos), CurLine(tokens, pos),
                                 CurCol(tokens, pos));
                Advance(tokens, pos);
                AddChild(arena, node, vn);
            }
            if (!MatchKw(tokens, pos, "in")) {
                errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected 'in' in foreach");
                return node;
            }
            AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
            ExpectPunct(tokens, pos, ")", errors, "')' after foreach container");
        }
        AddChild(arena, node, ParseStatement(tokens, pos, arena, errors));
        return node;
    }
    if (IsKw(tokens, pos, "return")) {
        var node = NewNode(arena, "return", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (!IsPunct(tokens, pos, ";")) {
            AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
        }
        ExpectPunct(tokens, pos, ";", errors, "';' after return");
        return node;
    }
    if (IsKw(tokens, pos, "break")) {
        var node = NewNode(arena, "break", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        ExpectPunct(tokens, pos, ";", errors, "';' after break");
        return node;
    }
    if (IsKw(tokens, pos, "continue")) {
        var node = NewNode(arena, "continue", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        ExpectPunct(tokens, pos, ";", errors, "';' after continue");
        return node;
    }
    if (IsKw(tokens, pos, "switch")) {
        var node = NewNode(arena, "switch", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (ExpectPunct(tokens, pos, "(", errors, "'(' after switch")) {
            AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
            ExpectPunct(tokens, pos, ")", errors, "')' after switch condition");
        }
        if (!ExpectPunct(tokens, pos, "{", errors, "'{' to start switch")) {
            return node;
        }
        while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
            var caseNode = NewNode(arena, "case", "", CurLine(tokens, pos), CurCol(tokens, pos));
            if (MatchKw(tokens, pos, "case")) {
                for (;;) {
                    AddChild(arena, caseNode, ParseExpression(tokens, pos, arena, errors));
                    if (!MatchPunct(tokens, pos, ",")) {
                        break;
                    }
                }
                if (!ExpectPunct(tokens, pos, ":", errors, "':' after case value")) {
                    return node;
                }
            } else if (MatchKw(tokens, pos, "default")) {
                if (!ExpectPunct(tokens, pos, ":", errors, "':' after default")) {
                    return node;
                }
            } else {
                errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected 'case' or 'default'");
                return node;
            }
            var block = NewNode(arena, "block", "", CurLine(tokens, pos), CurCol(tokens, pos));
            while (!IsKw(tokens, pos, "case") && !IsKw(tokens, pos, "default") &&
                   !IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
                AddChild(arena, block, ParseStatement(tokens, pos, arena, errors));
            }
            AddChild(arena, caseNode, block);
            AddChild(arena, node, caseNode);
        }
        ExpectPunct(tokens, pos, "}", errors, "'}' to close switch");
        return node;
    }
    if (IsKw(tokens, pos, "attach")) {
        var node = NewNode(arena, "attach", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (!ExpectPunct(tokens, pos, "(", errors, "'(' after attach")) {
            return node;
        }
        AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
        if (ExpectPunct(tokens, pos, ",", errors, "',' between target and component")) {
            MatchKw(tokens, pos, "new");
            AddChild(arena, node, ParseComponentInit(tokens, pos, arena, errors));
        }
        ExpectPunct(tokens, pos, ")", errors, "')' after attach");
        ExpectPunct(tokens, pos, ";", errors, "';' after attach");
        return node;
    }
    if (IsKw(tokens, pos, "detach")) {
        var node = NewNode(arena, "detach", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        if (!ExpectPunct(tokens, pos, "(", errors, "'(' after detach")) {
            return node;
        }
        AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
        if (ExpectPunct(tokens, pos, ",", errors, "',' between target and component type")) {
            if (IsNameTok(tokens, pos)) {
                var tnText = CurText(tokens, pos);
                var tnLine = CurLine(tokens, pos);
                var tnCol = CurCol(tokens, pos);
                if (ExpectName(tokens, pos, errors, "component type name")) {
                    AddChild(arena, node, NewNode(arena, "typename", tnText, tnLine, tnCol));
                }
            }
        }
        ExpectPunct(tokens, pos, ")", errors, "')' after detach");
        ExpectPunct(tokens, pos, ";", errors, "';' after detach");
        return node;
    }
    if (IsKw(tokens, pos, "despawn")) {
        var node = NewNode(arena, "despawn", "", CurLine(tokens, pos), CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
        ExpectPunct(tokens, pos, ";", errors, "';' after despawn");
        return node;
    }
    var exprNode = NewNode(arena, "expr", "", CurLine(tokens, pos), CurCol(tokens, pos));
    AddChild(arena, exprNode, ParseExpression(tokens, pos, arena, errors));
    ExpectPunct(tokens, pos, ";", errors, "';' after expression");
    return exprNode;
}

/* ---------------- declarations ---------------- */

var ParseComponentDecl(tokens, pos, arena, errors, kind) {
    var node = NewNode(arena, kind, "", CurLine(tokens, pos), CurCol(tokens, pos));
    Advance(tokens, pos);
    if (IsNameTok(tokens, pos)) {
        var dn = NewNode(arena, "declname", CurText(tokens, pos), CurLine(tokens, pos),
                         CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, dn);
    }
    if (!ExpectPunct(tokens, pos, "{", errors,
                     kind == "component" ? "'{' after component name" : "'{' after struct name")) {
        return node;
    }
    while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
        if (!MatchKw(tokens, pos, "var")) {
            errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected field name");
            break;
        }
        if (IsNameTok(tokens, pos)) {
            var fn = NewNode(arena, "field", CurText(tokens, pos), CurLine(tokens, pos),
                             CurCol(tokens, pos));
            Advance(tokens, pos);
            if (ExpectPunct(tokens, pos, "=", errors, "'=' in field default")) {
                AddChild(arena, fn, ParseExpression(tokens, pos, arena, errors));
            }
            AddChild(arena, node, fn);
        }
        ExpectPunct(tokens, pos, ";", errors, "';' after field");
    }
    ExpectPunct(tokens, pos, "}", errors,
                 kind == "component" ? "'}' to close component" : "'}' to close struct");
    return node;
}

var ParseFunctionDecl(tokens, pos, arena, errors) {
    var node = NewNode(arena, "function", "", CurLine(tokens, pos), CurCol(tokens, pos));
    var retText = "";
    var nameText = "";
    if (IsNameTok(tokens, pos)) {
        retText = CurText(tokens, pos);
        Advance(tokens, pos);
    }
    if (IsNameTok(tokens, pos)) {
        nameText = CurText(tokens, pos);
        Advance(tokens, pos);
    }
    if (nameText != "") {
        AddChild(arena, node, NewNode(arena, "declname", nameText, CurLine(tokens, pos),
                                      CurCol(tokens, pos)));
    }
    if (retText != "") {
        AddChild(arena, node, NewNode(arena, "ret", retText, CurLine(tokens, pos),
                                      CurCol(tokens, pos)));
    }
    if (!ExpectPunct(tokens, pos, "(", errors, "'(' after function name")) {
        return node;
    }
    while (IsNameTok(tokens, pos) && !IsPunct(tokens, pos, ")")) {
        var pn = NewNode(arena, "param", CurText(tokens, pos), CurLine(tokens, pos),
                         CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, pn);
        if (!MatchPunct(tokens, pos, ",")) {
            break;
        }
    }
    ExpectPunct(tokens, pos, ")", errors, "')' after parameters");
    AddChild(arena, node, ParseBlock(tokens, pos, arena, errors));
    return node;
}

var ParseTagDecl(tokens, pos, arena, errors) {
    var node = NewNode(arena, "tag", "", CurLine(tokens, pos), CurCol(tokens, pos));
    Advance(tokens, pos);
    if (IsNameTok(tokens, pos)) {
        var dn = NewNode(arena, "declname", CurText(tokens, pos), CurLine(tokens, pos),
                         CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, dn);
    }
    if (MatchPunct(tokens, pos, ":")) {
        if (IsNameTok(tokens, pos)) {
            var pnText = CurText(tokens, pos);
            var pnLine = CurLine(tokens, pos);
            var pnCol = CurCol(tokens, pos);
            if (ExpectName(tokens, pos, errors, "parent tag name")) {
                AddChild(arena, node, NewNode(arena, "parent", pnText, pnLine, pnCol));
            }
        }
    }
    ExpectPunct(tokens, pos, ";", errors, "';' after tag");
    return node;
}

var ParseEnumDecl(tokens, pos, arena, errors) {
    var node = NewNode(arena, "enum", "", CurLine(tokens, pos), CurCol(tokens, pos));
    Advance(tokens, pos);
    if (IsNameTok(tokens, pos)) {
        var dn = NewNode(arena, "declname", CurText(tokens, pos), CurLine(tokens, pos),
                         CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, dn);
    }
    if (!ExpectPunct(tokens, pos, "{", errors, "'{' after enum name")) {
        return node;
    }
    while (IsNameTok(tokens, pos) && !IsPunct(tokens, pos, "}")) {
        var mn = NewNode(arena, "member", CurText(tokens, pos), CurLine(tokens, pos),
                         CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, mn);
        if (!MatchPunct(tokens, pos, ",")) {
            break;
        }
    }
    ExpectPunct(tokens, pos, "}", errors, "'}' to close enum");
    return node;
}

var ParseConstDecl(tokens, pos, arena, errors) {
    var node = NewNode(arena, "const", "", CurLine(tokens, pos), CurCol(tokens, pos));
    Advance(tokens, pos);
    if (IsNameTok(tokens, pos)) {
        var dn = NewNode(arena, "declname", CurText(tokens, pos), CurLine(tokens, pos),
                         CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, dn);
    }
    if (ExpectPunct(tokens, pos, "=", errors, "'=' in const")) {
        AddChild(arena, node, ParseExpression(tokens, pos, arena, errors));
    }
    ExpectPunct(tokens, pos, ";", errors, "';' after const");
    return node;
}

var ParseSystemDecl(tokens, pos, arena, errors) {
    var node = NewNode(arena, "system", "", CurLine(tokens, pos), CurCol(tokens, pos));
    Advance(tokens, pos);
    if (IsNameTok(tokens, pos)) {
        var dn = NewNode(arena, "declname", CurText(tokens, pos), CurLine(tokens, pos),
                         CurCol(tokens, pos));
        Advance(tokens, pos);
        AddChild(arena, node, dn);
    }
    for (;;) {
        if (MatchKw(tokens, pos, "with")) {
            if (ExpectPunct(tokens, pos, "(", errors, "'(' after with")) {
                while (IsNameTok(tokens, pos) && !IsPunct(tokens, pos, ")")) {
                    var wn = NewNode(arena, "with", CurText(tokens, pos), CurLine(tokens, pos),
                                     CurCol(tokens, pos));
                    Advance(tokens, pos);
                    AddChild(arena, node, wn);
                    if (!MatchPunct(tokens, pos, ",")) {
                        break;
                    }
                }
                ExpectPunct(tokens, pos, ")", errors, "')' after with list");
            }
            continue;
        }
        if (MatchKw(tokens, pos, "without")) {
            if (ExpectPunct(tokens, pos, "(", errors, "'(' after without")) {
                while (IsNameTok(tokens, pos) && !IsPunct(tokens, pos, ")")) {
                    var wn = NewNode(arena, "without", CurText(tokens, pos),
                                     CurLine(tokens, pos), CurCol(tokens, pos));
                    Advance(tokens, pos);
                    AddChild(arena, node, wn);
                    if (!MatchPunct(tokens, pos, ",")) {
                        break;
                    }
                }
                ExpectPunct(tokens, pos, ")", errors, "')' after without list");
            }
            continue;
        }
        break;
    }
    while (IsPunct(tokens, pos, "[")) {
        Advance(tokens, pos);
        var attr = NewNode(arena, "attr", "", CurLine(tokens, pos), CurCol(tokens, pos));
        if (IsNameTok(tokens, pos)) {
            var an = NewNode(arena, "attrname", CurText(tokens, pos), CurLine(tokens, pos),
                             CurCol(tokens, pos));
            Advance(tokens, pos);
            AddChild(arena, attr, an);
        }
        if (MatchPunct(tokens, pos, "(")) {
            while (!IsPunct(tokens, pos, ")") && !AtEnd(tokens, pos)) {
                AddChild(arena, attr, ParseExpression(tokens, pos, arena, errors));
                if (!MatchPunct(tokens, pos, ",")) {
                    break;
                }
            }
            ExpectPunct(tokens, pos, ")", errors, "')' after attribute args");
        }
        ExpectPunct(tokens, pos, "]", errors, "']' to close attribute");
        AddChild(arena, node, attr);
    }
    AddChild(arena, node, ParseBlock(tokens, pos, arena, errors));
    return node;
}

var ParseProgram(tokens, pos, arena, errors, file) {
    var root = NewNode(arena, "program", file, 0, 0);
    while (!AtEnd(tokens, pos)) {
        if (IsKw(tokens, pos, "using")) {
            Advance(tokens, pos);
            var un = NewNode(arena, "using", "", CurLine(tokens, pos), CurCol(tokens, pos));
            while (IsNameTok(tokens, pos)) {
                var nn = NewNode(arena, "useg", CurText(tokens, pos), CurLine(tokens, pos),
                                 CurCol(tokens, pos));
                Advance(tokens, pos);
                AddChild(arena, un, nn);
                if (!MatchPunct(tokens, pos, ".")) {
                    break;
                }
            }
            ExpectPunct(tokens, pos, ";", errors, "';' after using directive");
            AddChild(arena, root, un);
            continue;
        }
        if (IsKw(tokens, pos, "component")) {
            AddChild(arena, root, ParseComponentDecl(tokens, pos, arena, errors, "component"));
            continue;
        }
        if (IsKw(tokens, pos, "struct")) {
            AddChild(arena, root, ParseComponentDecl(tokens, pos, arena, errors, "struct"));
            continue;
        }
        if (IsKw(tokens, pos, "system")) {
            AddChild(arena, root, ParseSystemDecl(tokens, pos, arena, errors));
            continue;
        }
        if (IsKw(tokens, pos, "tag")) {
            AddChild(arena, root, ParseTagDecl(tokens, pos, arena, errors));
            continue;
        }
        if (IsKw(tokens, pos, "enum")) {
            AddChild(arena, root, ParseEnumDecl(tokens, pos, arena, errors));
            continue;
        }
        if (IsKw(tokens, pos, "const")) {
            AddChild(arena, root, ParseConstDecl(tokens, pos, arena, errors));
            continue;
        }
        if (IsKw(tokens, pos, "extern")) {
            Advance(tokens, pos);
            var en = NewNode(arena, "extern", "", CurLine(tokens, pos), CurCol(tokens, pos));
            if (IsNameTok(tokens, pos)) {
                var rn = NewNode(arena, "ret", CurText(tokens, pos), CurLine(tokens, pos),
                                 CurCol(tokens, pos));
                Advance(tokens, pos);
                AddChild(arena, en, rn);
            }
            if (IsNameTok(tokens, pos)) {
                var dn = NewNode(arena, "declname", CurText(tokens, pos), CurLine(tokens, pos),
                                 CurCol(tokens, pos));
                Advance(tokens, pos);
                AddChild(arena, en, dn);
            }
            if (!ExpectPunct(tokens, pos, "(", errors, "'(' after function name")) {
                AddChild(arena, root, en);
                continue;
            }
            while (!IsPunct(tokens, pos, ")") && !AtEnd(tokens, pos)) {
                if (IsNameTok(tokens, pos)) {
                    var pt = NewNode(arena, "paramtype", CurText(tokens, pos),
                                     CurLine(tokens, pos), CurCol(tokens, pos));
                    Advance(tokens, pos);
                    AddChild(arena, en, pt);
                }
                if (IsNameTok(tokens, pos)) {
                    var pn = NewNode(arena, "param", CurText(tokens, pos), CurLine(tokens, pos),
                                     CurCol(tokens, pos));
                    Advance(tokens, pos);
                    AddChild(arena, en, pn);
                }
                if (!MatchPunct(tokens, pos, ",")) {
                    break;
                }
            }
            ExpectPunct(tokens, pos, ")", errors, "')' after parameters");
            ExpectPunct(tokens, pos, ";", errors, "';' after extern declaration");
            AddChild(arena, root, en);
            continue;
        }
        if (IsKw(tokens, pos, "var") || IsKw(tokens, pos, "void") ||
            IsKw(tokens, pos, "int")) {
            AddChild(arena, root, ParseFunctionDecl(tokens, pos, arena, errors));
            continue;
        }
        if (IsPunct(tokens, pos, "[")) {
            Advance(tokens, pos);
            var attr = NewNode(arena, "attr", "", CurLine(tokens, pos), CurCol(tokens, pos));
            if (IsNameTok(tokens, pos)) {
                var an = NewNode(arena, "attrname", CurText(tokens, pos), CurLine(tokens, pos),
                                 CurCol(tokens, pos));
                Advance(tokens, pos);
                AddChild(arena, attr, an);
            }
            if (MatchPunct(tokens, pos, "(")) {
                while (!IsPunct(tokens, pos, ")") && !AtEnd(tokens, pos)) {
                    AddChild(arena, attr, ParseExpression(tokens, pos, arena, errors));
                    if (!MatchPunct(tokens, pos, ",")) {
                        break;
                    }
                }
                ExpectPunct(tokens, pos, ")", errors, "')' after attribute args");
            }
            ExpectPunct(tokens, pos, "]", errors, "']' to close attribute");
            if (MatchKw(tokens, pos, "extern")) {
                var en = NewNode(arena, "extern", "", CurLine(tokens, pos), CurCol(tokens, pos));
                AddChild(arena, en, attr);
                if (IsNameTok(tokens, pos)) {
                    var rn = NewNode(arena, "ret", CurText(tokens, pos), CurLine(tokens, pos),
                                     CurCol(tokens, pos));
                    Advance(tokens, pos);
                    AddChild(arena, en, rn);
                }
                if (IsNameTok(tokens, pos)) {
                    var dn = NewNode(arena, "declname", CurText(tokens, pos),
                                     CurLine(tokens, pos), CurCol(tokens, pos));
                    Advance(tokens, pos);
                    AddChild(arena, en, dn);
                }
                if (!ExpectPunct(tokens, pos, "(", errors, "'(' after function name")) {
                    AddChild(arena, root, en);
                    continue;
                }
                while (!IsPunct(tokens, pos, ")") && !AtEnd(tokens, pos)) {
                    if (IsNameTok(tokens, pos)) {
                        var pt = NewNode(arena, "paramtype", CurText(tokens, pos),
                                         CurLine(tokens, pos), CurCol(tokens, pos));
                        Advance(tokens, pos);
                        AddChild(arena, en, pt);
                    }
                    if (IsNameTok(tokens, pos)) {
                        var pn = NewNode(arena, "param", CurText(tokens, pos),
                                         CurLine(tokens, pos), CurCol(tokens, pos));
                        Advance(tokens, pos);
                        AddChild(arena, en, pn);
                    }
                    if (!MatchPunct(tokens, pos, ",")) {
                        break;
                    }
                }
                ExpectPunct(tokens, pos, ")", errors, "')' after parameters");
                ExpectPunct(tokens, pos, ";", errors, "';' after extern declaration");
                AddChild(arena, root, en);
                continue;
            }
            errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: attributes before a declaration require 'extern'");
            continue;
        }
        errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected a top-level declaration");
        Advance(tokens, pos);
    }
    return root;
}

/* ---------------- dump (mirrors kxc dump exactly) ---------------- */

var Dump(arena, i) {
    var n = arena.Get(i);
    var out = "";
    var kind = n.kind;
    if (kind == "program") {
        var s = "(program";
        if (n.value != "") {
            s += " file:" + n.value;
        }
        foreach (var c in n.children) {
            s += " " + Dump(arena, c);
        }
        return s + ")";
    }

    if (kind == "string") {
        return "(string \"" + n.value + "\")";
    }
    if (kind == "bool") {
        return "(bool " + n.value + ")";
    }
    if (kind == "identifier") {
        return "(identifier " + n.value + ")";
    }
    if (kind == "declname" || kind == "ret" || kind == "param" ||
        kind == "varname" || kind == "typename" || kind == "compname" ||
        kind == "istype" || kind == "isvar" ||
        kind == "with" || kind == "without" ||
        kind == "attrname" || kind == "useg" || kind == "spawntag") {
        return n.value;
    }
    if (kind == "int" || kind == "float") {
        if (kind == "float") {
            return "(float " + TrimFloat(n.value) + ")";
        }
        return "(int " + n.value + ")";
    }
    if (kind == "typearg") {
        return "<" + n.value + ">";
    }
    if (kind == "component" || kind == "struct" || kind == "tag" ||
        kind == "enum" || kind == "const" || kind == "system" ||
        kind == "function" || kind == "extern") {
        return DumpDecl(arena, i);
    }
    if (kind == "binary" || kind == "unary" || kind == "assign") {
        var s = "(" + kind + " " + n.value;
        foreach (var c in n.children) {
            s += " " + Dump(arena, c);
        }
        return s + ")";
    }
    if (kind == "member") {
        return "(member " + Dump(arena, n.children.Get(0)) + " " + n.value + ")";
    }
    if (kind == "call") {
        var s = "(call";
        var first = true;
        foreach (var c in n.children) {
            var cn = arena.Get(c);
            if (cn.kind == "typearg") {
                s += " <" + cn.value + ">";
            } else {
                s += " " + Dump(arena, c);
            }
            first = false;
        }
        return s + ")";
    }
    if (kind == "arg") {
        if (n.children.Count == 2 && arena.Get(n.children.Get(0)).kind == "argname") {
            return arena.Get(n.children.Get(0)).value + ":" + Dump(arena, n.children.Get(1));
        }
        return Dump(arena, n.children.Get(0));
    }
    if (kind == "interpolated") {
        var s = "(interpolated";
        foreach (var c in n.children) {
            var cn = arena.Get(c);
            if (cn.kind == "lit") {
                s += " \"" + cn.value + "\"";
            } else {
                s += " {";
                s += Dump(arena, cn.children.Get(0));
                s += "}";
            }
        }
        return s + ")";
    }
    if (kind == "compinit") {
        var s = "(";
        foreach (var c in n.children) {
            var cn = arena.Get(c);
            if (cn.kind == "compname") {
                s += cn.value;
            } else if (cn.kind == "field") {
                s += " " + cn.value + "=";
                s += Dump(arena, cn.children.Get(0));
            }
        }
        return s + ")";
    }
    if (kind == "spawn") {
        var s = "(spawn";
        foreach (var c in n.children) {
            var cn = arena.Get(c);
            if (cn.kind == "compinit") {
                s += " " + Dump(arena, c);
            } else if (cn.kind == "spawntag") {
                s += " tag:" + cn.value;
            }
        }
        return s + ")";
    }
    if (kind == "structinit") {
        var s = "(structinit (" + n.value;
        foreach (var c in n.children) {
            var cn = arena.Get(c);
            s += " " + cn.value + "=";
            s += Dump(arena, cn.children.Get(0));
        }
        return s + "))";
    }
    if (kind == "case") {
        var s = "(";
        foreach (var c in n.children) {
            var cn = arena.Get(c);
            if (cn.kind == "block") {
                s += " " + Dump(arena, c);
            } else {
                s += " case " + Dump(arena, c);
            }
        }
        return s + ")";
    }
    var generic = "(" + kind;
    foreach (var c in n.children) {
        generic += " " + Dump(arena, c);
    }
    return generic + ")";
}

var DumpDecl(arena, i) {
    var n = arena.Get(i);
    if (n.kind == "component" || n.kind == "struct") {
        var s = "(" + n.kind + " " + arena.Get(n.children.Get(0)).value;
        for (var k = 1; k < n.children.Count; k++) {
            var cn = arena.Get(n.children.Get(k));
            s += " (" + cn.value + " " + Dump(arena, cn.children.Get(0)) + ")";
        }
        return s + ")";
    }
    if (n.kind == "tag") {
        var s = "(tag " + arena.Get(n.children.Get(0)).value;
        if (n.children.Count > 1) {
            s += " : " + arena.Get(n.children.Get(1)).value;
        }
        return s + ")";
    }
    if (n.kind == "enum") {
        var s = "(enum " + arena.Get(n.children.Get(0)).value;
        for (var k = 1; k < n.children.Count; k++) {
            s += " " + arena.Get(n.children.Get(k)).value;
        }
        return s + ")";
    }
    if (n.kind == "const") {
        return "(const " + arena.Get(n.children.Get(0)).value + " " + Dump(arena, n.children.Get(1)) + ")";
    }
    if (n.kind == "system") {
        var s = "(system " + arena.Get(n.children.Get(0)).value;
        foreach (var c in n.children) {
            var cn = arena.Get(c);
            if (cn.kind == "with") {
                s += " with:" + cn.value;
            } else if (cn.kind == "without") {
                s += " without:" + cn.value;
            } else if (cn.kind == "attr") {
                s += " [" + arena.Get(n.children.Get(0)).value;
                if (cn.children.Count > 1) {
                    s += " ";
                    for (var k = 1; k < cn.children.Count; k++) {
                        if (k > 1) {
                            s += " ";
                        }
                        s += Dump(arena, cn.children.Get(k));
                    }
                }
                s += "]";
            } else if (cn.kind == "block") {
                s += " " + Dump(arena, c);
            }
        }
        return s + ")";
    }
    if (n.kind == "function" || n.kind == "extern") {
        var s = "(function " + arena.Get(n.children.Get(0)).value + " " + arena.Get(n.children.Get(1)).value;
        for (var k = 2; k < n.children.Count; k++) {
            var cn = arena.Get(n.children.Get(k));
            if (cn.kind == "param") {
                s += " " + cn.value;
            } else if (cn.kind == "block") {
                s += " " + Dump(arena, n.children.Get(k));
            }
        }
        return s + ")";
    }
    var generic = "(" + n.kind;
    foreach (var c in n.children) {
        generic += " " + Dump(arena, c);
    }
    return generic + ")";
}

/* ---------------- main ---------------- */


// ---- helpers ----

var Child(arena, n, i) {
    return arena.Get(n.children.Get(i));
}

var SplitFirst(s, sep) {
    var out = List<string>();
    for (var i = 0; i < s.Length; i++) {
        if (s.Substring(i, 1) == sep) {
            out.Add(s.Substring(0, i));
            out.Add(s.Substring(i + 1, s.Length - i - 1));
            return out;
        }
    }
    out.Add(s);
    out.Add("");
    return out;
}

var IntStr(v) {
    if (v == 0) return "0";
    var neg = false;
    if (v < 0) { neg = true; v = -v; }
    var d = "";
    while (v > 0) { d = "0123456789".Substring(v % 10, 1) + d; v = v / 10; }
    if (neg) d = "-" + d;
    return d;
}

var XType(val) { var sp = SplitFirst(val, " "); return sp.Get(0); }
var XVal(val) { var sp = SplitFirst(val, " "); return sp.Get(1); }
var ToI64(g, val) {
    if (XType(val) == "i64") return XVal(val);
    var ext = "%" + Lbl(g, "ext");
    if (XType(val) == "ptr") {
        Emit(g, "  " + ext + " = ptrtoint ptr " + XVal(val) + " to i64");
    } else {
        Emit(g, "  " + ext + " = sext i32 " + XVal(val) + " to i64");
    }
    return ext;
}

var Coerce(g, val, want) {
    var have = XType(val);
    var value = XVal(val);
    if (have == want) return value;
    var cast = "%" + Lbl(g, "cast");
    if (want == "ptr" && have == "i64") {
        Emit(g, "  " + cast + " = inttoptr i64 " + value + " to ptr");
        return cast;
    }
    if (want == "i64" && have == "ptr") {
        Emit(g, "  " + cast + " = ptrtoint ptr " + value + " to i64");
        return cast;
    }
    if (want == "i64" && have == "i32") {
        Emit(g, "  " + cast + " = sext i32 " + value + " to i64");
        return cast;
    }
    if (want == "i1" && have == "i64") {
        Emit(g, "  " + cast + " = icmp ne i64 " + value + ", 0");
        return cast;
    }
    if (want == "i64" && have == "i1") {
        Emit(g, "  " + cast + " = zext i1 " + value + " to i64");
        return cast;
    }
    return value;
}
var KxType(t) {
    if (t == "int" || t == "long") return "i64";
    if (t == "void") return "void";
    if (t == "string" || t == "ptr") return "ptr";
    if (t == "bool") return "i1";
    if (t == "float" || t == "double") return "double";
    return "i64";
}

var SplitAll(s, sep) {
    var out = List<string>();
    var cur = "";
    for (var i = 0; i < s.Length; i++) {
        var c = s.Substring(i, 1);
        if (c == sep) {
            out.Add(cur);
            cur = "";
        } else {
            cur += c;
        }
    }
    out.Add(cur);
    return out;
}

var JoinParts(parts, sep) {
    var out = "";
    for (var i = 0; i < parts.Count; i++) {
        if (i > 0) out += sep;
        out += parts.Get(i);
    }
    return out;
}

var SigRet(sig) {
    return SplitFirst(sig, "|").Get(0);
}

var SigParams(sig) {
    var p = SplitFirst(sig, "|").Get(1);
    if (p == "") return List<string>();
    return SplitAll(p, ",");
}

var FindStructWithField(g, fieldName) {
    for (var i = 0; i < g.structVars.Count; i++) {
        var sn = g.structVars.Get(i);
        var fields = SplitAll(g.structs.Get(sn), ",");
        for (var j = 0; j < fields.Count; j++) {
            if (fields.Get(j) == fieldName) return sn;
        }
    }
    return "";
}

var ParamIndex(g, fnName, paramName) {
    if (!g.sigs.Has(fnName)) return -1;
    var params = SigParams(g.sigs.Get(fnName));
    for (var i = 0; i < params.Count; i++) {
        if (params.Get(i) == paramName) return i;
    }
    return -1;
}

var SigSetParam(g, name, index, type) {
    if (!g.sigs.Has(name)) return 0;
    var sig = g.sigs.Get(name);
    var ret = SigRet(sig);
    var params = SigParams(sig);
    if (index >= params.Count) return 0;
    var old = params.Get(index);
    if (old == type || type == "unknown") return 0;
    var promote = (old == "i64" && type == "ptr") ||
                  (old == "i64" && type.StartsWith("struct:"));
    if (promote) {
        params.Set(index, type);
        g.sigs.Set(name, ret + "|" + JoinParts(params, ","));
    }
    return 0;
}

var SigSetRet(g, name, type) {
    if (!g.sigs.Has(name)) return 0;
    var sig = g.sigs.Get(name);
    var old = SigRet(sig);
    if (old == "i64" && type != "unknown") {
        var params = SigParams(sig);
        g.sigs.Set(name, type + "|" + JoinParts(params, ","));
    }
    return 0;
}

var InferExprType(g, e, arena, locals, fnName) {
    if (e.kind == "int") return "i32";
    if (e.kind == "long") return "i64";
    if (e.kind == "float" || e.kind == "double") return "double";
    if (e.kind == "string" || e.kind == "interpolated") return "ptr";
    if (e.kind == "bool") return "i1";
    if (e.kind == "identifier") {
        if (locals.Has(e.value)) return locals.Get(e.value);
        return "i64";
    }
    if (e.kind == "structinit") return "i64";
    if (e.kind == "is") {
        var base = InferExprType(g, Child(arena, e, 0), arena, locals, fnName);
        if (e.children.Count > 2) locals.Set(Child(arena, e, 2).value, base);
        return "i1";
    }
    if (e.kind == "member") {
        var baseNode = Child(arena, e, 0);
        var base = InferExprType(g, baseNode, arena, locals, fnName);
        var m = e.value;
        if (baseNode.kind == "call") {
            var innerCallee = Child(arena, baseNode, 0);
            if (innerCallee.kind == "identifier") {
                if (m == "kind" || m == "text") {
                    SigSetRet(g, innerCallee.value, "struct:Token");
                    return "ptr";
                }
                if (m == "value" || m == "children") {
                    SigSetRet(g, innerCallee.value, "struct:AstNode");
                    return m == "value" ? "ptr" : "i64";
                }
            }
        }
        if (base.StartsWith("struct:") && g.structs.Has(base.Substring(7))) {
            var fields2 = SplitAll(g.structs.Get(base.Substring(7)), ",");
            for (var fi2 = 0; fi2 < fields2.Count; fi2++) {
                if (fields2.Get(fi2) == m) {
                    if (m == "kind" || m == "text" || m == "value") return "ptr";
                    return "i64";
                }
            }
        }
        if (baseNode.kind == "identifier" && locals.Has(baseNode.value) && locals.Get(baseNode.value).StartsWith("struct:")) {
            if (m == "kind" || m == "text" || m == "value") return "ptr";
            return "i64";
        }
        if (baseNode.kind == "identifier" && locals.Has(baseNode.value) && locals.Get(baseNode.value) == "i64") {
            var found = FindStructWithField(g, m);
            if (found != "") {
                var pidx = ParamIndex(g, fnName, baseNode.value);
                locals.Set(baseNode.value, "struct:" + found);
                if (pidx >= 0) { SigSetParam(g, fnName, pidx, "struct:" + found); }
                if (m == "kind" || m == "text" || m == "value") return "ptr";
                return "i64";
            }
        }
        if (baseNode.kind == "member") {
            var innerBase = Child(arena, baseNode, 0);
            var innerM = baseNode.value;
            if (innerBase.kind == "identifier" && locals.Has(innerBase.value) && locals.Get(innerBase.value).StartsWith("struct:")) {
                return "i64";
            }
        }
        if (baseNode.kind == "identifier" && (m == "Length" || m == "Substring" ||
            m == "Contains" || m == "StartsWith" || m == "EndsWith" ||
            m == "Upper" || m == "Lower")) {
            locals.Set(baseNode.value, "ptr");
        }
        if (m == "Length" || m == "Count") return "i64";
        return base;
    }
    if (e.kind == "binary") {
        var left = Child(arena, e, 0);
        var right = Child(arena, e, 1);
        var lt = InferExprType(g, left, arena, locals, fnName);
        var rt = InferExprType(g, right, arena, locals, fnName);
        if (lt == "ptr" || rt == "ptr") {
            if (left.kind == "identifier") locals.Set(left.value, "ptr");
            if (right.kind == "identifier") locals.Set(right.value, "ptr");
            if (e.value == "add") return "ptr";
            if (e.value == "eq" || e.value == "ne" || e.value == "lt" ||
                e.value == "le" || e.value == "gt" || e.value == "ge") return "i1";
        }
        if (e.value == "and" || e.value == "or" || e.value == "eq" || e.value == "ne" ||
            e.value == "lt" || e.value == "le" || e.value == "gt" || e.value == "ge") return "i1";
        return "i64";
    }
    if (e.kind == "unary") {
        var t = InferExprType(g, Child(arena, e, 0), arena, locals, fnName);
        if (e.value == "not") return "i1";
        return t;
    }
    if (e.kind == "ternary") {
        InferExprType(g, Child(arena, e, 0), arena, locals, fnName);
        var a = InferExprType(g, Child(arena, e, 1), arena, locals, fnName);
        var b = InferExprType(g, Child(arena, e, 2), arena, locals, fnName);
        if (a == b) return a;
        if (a == "ptr" || b == "ptr") return "ptr";
        return "i64";
    }
    if (e.kind == "call") {
        var callee = Child(arena, e, 0);
        if (callee.kind == "member") {
            var base = Child(arena, callee, 0);
            var m = callee.value;
            if (base.kind == "identifier" && base.value == "std") {
                if (m == "readFile" || m == "readln") return "ptr";
                if (m == "args" || m == "rng") return "i64";
                if (m == "println" || m == "print" || m == "exit" || m == "stop") return "void";
            }
            var bt = InferExprType(g, base, arena, locals, fnName);
            if (base.kind == "identifier" && m == "Get" && g.listElem.Has(base.value)) {
                return "struct:" + g.listElem.Get(base.value);
            }
            if (base.kind == "call") {
                var innerCallee = Child(arena, base, 0);
                if (innerCallee.kind == "identifier") {
                    if (m == "kind" || m == "text") {
                        SigSetRet(g, innerCallee.value, "struct:Token");
                        return "ptr";
                    }
                    if (m == "value" || m == "children") {
                        SigSetRet(g, innerCallee.value, "struct:AstNode");
                        return m == "value" ? "ptr" : "i64";
                    }
                }
            }
            if (base.kind == "identifier" && locals.Has(base.value) && locals.Get(base.value).StartsWith("struct:")) {
                if (m == "kind" || m == "text" || m == "value") return "ptr";
                return "i64";
            }
            if (base.kind == "identifier" && (m == "Substring" || m == "Contains" ||
                m == "StartsWith" || m == "EndsWith" || m == "Upper" || m == "Lower")) {
                locals.Set(base.value, "ptr");
            }
            if (m == "Substring" || m == "Upper" || m == "Lower") return "ptr";
            if (m == "Contains" || m == "StartsWith" || m == "EndsWith") return "i1";
            if (m == "Get" || m == "Set" || m == "Add" || m == "Has") return "i64";
        }
        if (callee.kind == "identifier") {
            var name = callee.value;
            if (name == "List" || name == "Map") return "i64";
            if (name == "IntStr" || name == "CharAt") return "ptr";
            if (g.sigs.Has(name)) {
                var ps = SigParams(g.sigs.Get(name));
                for (var i = 1; i < e.children.Count && i <= ps.Count; i++) {
                    var arg = Child(arena, e, i);
                    if (arg.kind == "arg") arg = Child(arena, arg, 0);
                    var at = InferExprType(g, arg, arena, locals, fnName);
                    SigSetParam(g, name, i - 1, at);
                }
                return SigRet(g.sigs.Get(name));
            }
        }
        return "i64";
    }
    if (e.kind == "assign") {
        var value = InferExprType(g, Child(arena, e, 1), arena, locals, fnName);
        var lhs = Child(arena, e, 0);
        if (lhs.kind == "identifier") locals.Set(lhs.value, value);
        return value;
    }
    return "i64";
}

var InferStmt(g, s, arena, locals, fnName) {
    if (s.kind == "vardecl") {
        var name = Child(arena, s, 0).value;
        var rhs = Child(arena, s, 1);
        if (rhs.kind == "structinit") {
            locals.Set(name, "struct:" + rhs.value);
            return 0;
        }
        if (rhs.kind == "call") {
            var rc = Child(arena, rhs, 0);
            if (rc.kind == "identifier" && rc.value == "List" && rhs.children.Count > 1) {
                var ta = Child(arena, rhs, 1);
                if (ta.kind == "typearg" && g.structs.Has(ta.value)) {
                    g.listElem.Set(name, ta.value);
                }
            }
        }
        locals.Set(name, InferExprType(g, rhs, arena, locals, fnName));
        return 0;
    }
    if (s.kind == "expr") { InferExprType(g, Child(arena, s, 0), arena, locals, fnName); return 0; }
    if (s.kind == "return") {
        if (s.children.Count > 0) SigSetRet(g, fnName, InferExprType(g, Child(arena, s, 0), arena, locals, fnName));
        return 0;
    }
    if (s.kind == "block") {
        for (var i = 0; i < s.children.Count; i++) InferStmt(g, Child(arena, s, i), arena, locals, fnName);
        return 0;
    }
    if (s.kind == "if" || s.kind == "while") {
        InferExprType(g, Child(arena, s, 0), arena, locals, fnName);
        for (var i = 1; i < s.children.Count; i++) InferStmt(g, Child(arena, s, i), arena, locals, fnName);
        return 0;
    }
    if (s.kind == "for") {
        for (var i = 0; i < s.children.Count; i++) InferStmt(g, Child(arena, s, i), arena, locals, fnName);
        return 0;
    }
    if (s.kind == "foreach") {
        locals.Set(Child(arena, s, 0).value, "i64");
        InferExprType(g, Child(arena, s, 1), arena, locals, fnName);
        InferStmt(g, Child(arena, s, 2), arena, locals, fnName);
        return 0;
    }
    return 0;
}

var InferSignatures(g, root, arena) {
    for (var i = 0; i < root.children.Count; i++) {
        var d = Child(arena, root, i);
        if (d.kind == "function") {
            var name = Child(arena, d, 0).value;
            var ret = Child(arena, d, 1).value;
            var params = "";
            for (var j = 2; j < d.children.Count; j++) {
                var c = Child(arena, d, j);
                if (c.kind == "param") {
                    if (params != "") params += ",";
                    params += "i64";
                }
            }
            g.sigs.Set(name, (ret == "void" ? "void" : "i64") + "|" + params);
        }
    }
    for (var pass = 0; pass < 8; pass++) {
        for (var i = 0; i < root.children.Count; i++) {
            var d = Child(arena, root, i);
            if (d.kind == "function") {
                var name = Child(arena, d, 0).value;
                var locals = Map<string, string>();
                var ps = SigParams(g.sigs.Get(name));
                var pidx = 0;
                for (var j = 2; j < d.children.Count; j++) {
                    var c = Child(arena, d, j);
                    if (c.kind == "param") {
                        locals.Set(c.value, ps.Get(pidx));
                        pidx++;
                    }
                }
                InferStmt(g, Child(arena, d, d.children.Count - 1), arena, locals, name);
                pidx = 0;
                for (var j = 2; j < d.children.Count; j++) {
                    var c = Child(arena, d, j);
                    if (c.kind == "param") {
                        if (locals.Has(c.value)) SigSetParam(g, name, pidx, locals.Get(c.value));
                        pidx++;
                    }
                }
                var sig = g.sigs.Get(name);
                var currentParams = SigParams(sig);
                g.sigs.Set(name, SigRet(sig) + "|" + JoinParts(currentParams, ","));
            }
        }
    }
    return 0;
}

// ---- IR generator state ----

struct IR {
    var lines = List<string>();
    var strs = Map<string, string>(); var pending = List<string>();
    var sc = List<int>();
    var lc = List<int>();
    var lt = Map<string, string>();
    var ln = Map<string, string>();
    var structs = Map<string, string>();
    var structVars = List<string>();
    var listElem = Map<string, string>();
    var curFnRet = "";
    var curFnName = "";
    var sigs = Map<string, string>();
    var terminated = List<int>();
    var breakTargets = List<string>();
    var continueTargets = List<string>();
}

var NewIR() {
    var sc = List<int>(); sc.Add(0);
    var lc = List<int>(); lc.Add(0);
    var terminated = List<int>(); terminated.Add(0);
    return IR { lines = List<string>(), strs = Map<string, string>(), pending = List<string>(), sc = sc, lc = lc,
                lt = Map<string, string>(), ln = Map<string, string>(), structs = Map<string, string>(), structVars = List<string>(), listElem = Map<string, string>(), curFnRet = "", curFnName = "", sigs = Map<string, string>(), terminated = terminated, breakTargets = List<string>(), continueTargets = List<string>() };
}

var Emit(g, s) {
    if (g.terminated.Count > 0 && g.terminated.Get(0) == 1 && s != "}" && !s.EndsWith(":")) {
        g.lc.Set(0, g.lc.Get(0) + 1);
        g.lines.Add("dead." + IntStr(g.lc.Get(0)) + ":");
        g.terminated.Set(0, 0);
    }
    g.lines.Add(s);
    if (s.StartsWith("  br ") || s.StartsWith("  ret ") || s == "  unreachable") {
        g.terminated.Set(0, 1);
    } else if (s == "}" || s.EndsWith(":")) {
        g.terminated.Set(0, 0);
    }
    return 0;
}
var Lbl(g, p) { g.lc.Set(0, g.lc.Get(0) + 1); return p + "." + IntStr(g.lc.Get(0)); }

var EscStr(s) {
    var o = ""; var i = 0;
    while (i < s.Length) {
        var c = s.Substring(i, 1);
        if (c == "\\" && i + 1 < s.Length) {
            var n = s.Substring(i + 1, 1);
            if (n == "n") { o += "\\0A"; i += 2; continue; }
            if (n == "t") { o += "\\09"; i += 2; continue; }
            if (n == "\\") { o += "\\\\5C"; i += 2; continue; }
            if (n == "0") { o += "\\00"; i += 2; continue; }
            if (n == "\"") { o += "\\22"; i += 2; continue; }
        }
        if (c == "\"") { i++; continue; }
        if (c == "\n") { o += "\\0A"; i++; continue; }
        if (c == "\t") { o += "\\09"; i++; continue; }
        if (c == "\0") { o += "\\00"; i++; continue; }
        o += c; i++;
    }
    return o;
}

var GetStr(g, s) {
    if (g.strs.Has(s)) return g.strs.Get(s);
    g.sc.Set(0, g.sc.Get(0) + 1);
    var nm = "@.str." + IntStr(g.sc.Get(0));
    g.strs.Set(s, nm);
    var raw = "";
    var i = 0;
    while (i < s.Length) {
        var c = s.Substring(i, 1);
        if (c == "\"") { raw += "\\22"; }
        else if (c == "\n") { raw += "\\0A"; }
        else if (c == "\t") { raw += "\\09"; }
        else if (c == "\\") { raw += "\\5C"; }
        else { raw += c; }
        i++;
    }
    var size = s.Length + 1;
    g.pending.Add(nm + " = private unnamed_addr constant [" + IntStr(size) + " x i8] c\"" + raw + "\\00\"");
    return nm;
}

var EmitDecls(g) {
    Emit(g, "declare i64 @kx_println(ptr)");
    Emit(g, "declare i64 @kx_print(ptr)");
    Emit(g, "declare ptr @kx_read_file(ptr)");
    Emit(g, "declare i1 @kx_write_file(ptr, ptr)");
    Emit(g, "declare ptr @kx_int_str(i64)");
    Emit(g, "declare i64 @kx_system(ptr)");
    Emit(g, "declare void @kx_exit(i32)");
    Emit(g, "declare void @kx_panic(ptr)");
    Emit(g, "declare ptr @kx_readln()");
    Emit(g, "declare void @kx_save_args(i32, ptr)");
    Emit(g, "declare i64 @kx_args(i64)");
    Emit(g, "declare i64 @kx_list_new(i32)");
    Emit(g, "declare void @kx_list_add(i64, i64)");
    Emit(g, "declare i64 @kx_list_get(i64, i64)");
    Emit(g, "declare void @kx_list_set(i64, i64, i64)");
    Emit(g, "declare i64 @kx_list_size(i64)");
    Emit(g, "declare void @kx_list_remove_at(i64, i64)");
    Emit(g, "declare void @kx_list_clear(i64)");
    Emit(g, "declare i64 @kx_map_new(i32, i32)");
    Emit(g, "declare void @kx_map_set(i64, i64, i64)");
    Emit(g, "declare i64 @kx_map_get(i64, i64)");
    Emit(g, "declare i1 @kx_map_has(i64, i64)");
    Emit(g, "declare ptr @kx_str_len(ptr)");
    Emit(g, "declare ptr @kx_str_cat(ptr, ptr)");
    Emit(g, "declare i1 @kx_str_eq(ptr, ptr)");
    Emit(g, "declare i1 @kx_str_lt(ptr, ptr)");
    Emit(g, "declare i1 @kx_str_le(ptr, ptr)");
    Emit(g, "declare i1 @kx_str_gt(ptr, ptr)");
    Emit(g, "declare i1 @kx_str_ge(ptr, ptr)");
    Emit(g, "declare ptr @kx_str_substr(ptr, i64, i64)");
    Emit(g, "declare i1 @kx_str_contains(ptr, ptr)");
    Emit(g, "declare i1 @kx_str_starts_with(ptr, ptr)");
    Emit(g, "declare i1 @kx_str_ends_with(ptr, ptr)");
    Emit(g, "declare ptr @kx_str_upper(ptr)");
    Emit(g, "declare ptr @kx_str_lower(ptr)");
    Emit(g, "declare double @kx_rng_next_double(i64)");
    Emit(g, "declare i64 @kx_struct_new(i32)");
    Emit(g, "declare i64 @kx_struct_get(i64, i32)");
    Emit(g, "declare void @kx_struct_set(i64, i32, i64)");
    Emit(g, "");
    return 0;
}

// ---- expression codegen ----

var GenExpr(g, e, arena) {
    if (e.kind == "int") return "i32 " + e.value;
    if (e.kind == "long") return "i64 " + e.value;
    if (e.kind == "string") return "ptr " + GetStr(g, e.value);
    if (e.kind == "structinit") {
        var structName = e.value;
        if (g.structs.Has(structName)) {
            var fieldStr = g.structs.Get(structName);
            var fields = SplitAll(fieldStr, ",");
            if (fields.Get(0) == "") fields = List<string>();
            var size = fields.Count;
            if (size == 0) size = 1;
            var r = "%" + Lbl(g, "r");
            Emit(g, "  " + r + " = call i64 @kx_struct_new(i32 " + IntStr(size) + ")");
            for (var fi = 0; fi < e.children.Count; fi++) {
                var field = Child(arena, e, fi);
                if (field.kind == "field") {
                    var fname = field.value;
                    var fidx = -1;
                    for (var fj = 0; fj < fields.Count; fj++) {
                        if (fields.Get(fj) == fname) { fidx = fj; break; }
                    }
                    if (fidx >= 0) {
                        var fv = GenExpr(g, Child(arena, field, 0), arena);
                        Emit(g, "  call void @kx_struct_set(i64 " + r + ", i32 " + IntStr(fidx) + ", i64 " + ToI64(g, fv) + ")");
                    }
                }
            }
            return "i64 " + r;
        }
        return "i64 0";
    }
    if (e.kind == "interpolated") {
        var result = GetStr(g, e.value);
        for (var i = 0; i < e.children.Count; i++) {
            var child = Child(arena, e, i);
            var part = "";
            if (child.kind == "lit") {
                part = GetStr(g, child.value);
            } else if (child.kind == "interpexpr") {
                var expr = Child(arena, child, 0);
                var ev = GenExpr(g, expr, arena);
                if (XType(ev) == "i64") {
                    var r = "%" + Lbl(g, "r");
                    Emit(g, "  " + r + " = call ptr @kx_int_str(i64 " + XVal(ev) + ")");
                    part = r;
                } else if (XType(ev) == "i32") {
                    var ext = "%" + Lbl(g, "ext");
                    Emit(g, "  " + ext + " = sext i32 " + XVal(ev) + " to i64");
                    var r = "%" + Lbl(g, "r");
                    Emit(g, "  " + r + " = call ptr @kx_int_str(i64 " + ext + ")");
                    part = r;
                } else {
                    part = XVal(ev);
                }
            }
            if (part != "") {
                var r = "%" + Lbl(g, "r");
                Emit(g, "  " + r + " = call ptr @kx_str_cat(ptr " + result + ", ptr " + part + ")");
                result = r;
            }
        }
        return "ptr " + result;
    }
    if (e.kind == "bool") return "i1 " + (e.value == "true" ? "true" : "false");
    if (e.kind == "identifier") {
        if (e.value == "true") return "i1 true";
        if (e.value == "false") return "i1 false";
        if (g.ln.Has(e.value)) {
            var varType = g.lt.Get(e.value);
            var irType = varType;
            if (varType.StartsWith("struct:")) irType = "i64";
            var t = "%" + Lbl(g, "t");
            Emit(g, "  " + t + " = load " + irType + ", ptr " + g.ln.Get(e.value));
            if (varType == "ptr") return "ptr " + t;
            if (irType == "i64") return "i64 " + t;
            return irType + " " + t;
        }
        return "i64 0";
    }
    if (e.kind == "binary") {
        var lv = GenExpr(g, Child(arena, e, 0), arena);
        var rv = GenExpr(g, Child(arena, e, 1), arena);
        var lt = XType(lv); var rt = XType(rv);
        var la = XVal(lv); var ra = XVal(rv);
        if (lt != rt && lt != "ptr" && rt != "ptr") {
            if (lt == "i32" && rt == "i64") {
                var ext = "%" + Lbl(g, "ext");
                Emit(g, "  " + ext + " = sext i32 " + la + " to i64");
                la = ext; lt = "i64";
            } else if (lt == "i64" && rt == "i32") {
                var ext = "%" + Lbl(g, "ext");
                Emit(g, "  " + ext + " = sext i32 " + ra + " to i64");
                ra = ext; rt = "i64";
            }
        }
        var t = "%" + Lbl(g, "t");
         if (e.value == "add") {
            if (lt == "ptr" || rt == "ptr") {
                if (lt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = call ptr @kx_int_str(i64 " + la + ")"); la = ext; }
                if (rt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = call ptr @kx_int_str(i64 " + ra + ")"); ra = ext; }
                var r = "%" + Lbl(g, "r"); Emit(g, "  " + r + " = call ptr @kx_str_cat(ptr " + la + ", ptr " + ra + ")"); return "ptr " + r;
            }
            Emit(g, "  " + t + " = add " + lt + " " + la + ", " + ra); return lt + " " + t;
        }
        if (e.value == "sub") {
            if (lt == "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = ptrtoint ptr " + la + " to i64"); la = ext; lt = "i64"; }
            if (rt == "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = ptrtoint ptr " + ra + " to i64"); ra = ext; rt = "i64"; }
            Emit(g, "  " + t + " = sub " + lt + " " + la + ", " + ra); return lt + " " + t;
        }
        if (e.value == "mul") {
            if (lt == "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = ptrtoint ptr " + la + " to i64"); la = ext; lt = "i64"; }
            if (rt == "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = ptrtoint ptr " + ra + " to i64"); ra = ext; rt = "i64"; }
            Emit(g, "  " + t + " = mul " + lt + " " + la + ", " + ra); return lt + " " + t;
        }
        if (e.value == "div") {
            if (lt == "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = ptrtoint ptr " + la + " to i64"); la = ext; lt = "i64"; }
            if (rt == "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = ptrtoint ptr " + ra + " to i64"); ra = ext; rt = "i64"; }
            Emit(g, "  " + t + " = sdiv " + lt + " " + la + ", " + ra); return lt + " " + t;
        }
        if (e.value == "mod") {
            if (lt == "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = ptrtoint ptr " + la + " to i64"); la = ext; lt = "i64"; }
            if (rt == "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = ptrtoint ptr " + ra + " to i64"); ra = ext; rt = "i64"; }
            Emit(g, "  " + t + " = srem " + lt + " " + la + ", " + ra); return lt + " " + t;
        }
        if (e.value == "eq") {
            if (lt == "ptr" || rt == "ptr") {
                if (lt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + la + " to ptr"); la = ext; }
                if (rt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + ra + " to ptr"); ra = ext; }
                var r = "%" + Lbl(g, "r"); Emit(g, "  " + r + " = call i1 @kx_str_eq(ptr " + la + ", ptr " + ra + ")"); return "i1 " + r;
            }
            Emit(g, "  " + t + " = icmp eq " + lt + " " + la + ", " + ra); return "i1 " + t;
        }
        if (e.value == "lt") {
            if (lt == "ptr" || rt == "ptr") {
                if (lt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + la + " to ptr"); la = ext; }
                if (rt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + ra + " to ptr"); ra = ext; }
                var r = "%" + Lbl(g, "r"); Emit(g, "  " + r + " = call i1 @kx_str_lt(ptr " + la + ", ptr " + ra + ")"); return "i1 " + r;
            }
            Emit(g, "  " + t + " = icmp slt " + lt + " " + la + ", " + ra); return "i1 " + t;
        }
        if (e.value == "gt") {
            if (lt == "ptr" || rt == "ptr") {
                if (lt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + la + " to ptr"); la = ext; }
                if (rt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + ra + " to ptr"); ra = ext; }
                var r = "%" + Lbl(g, "r"); Emit(g, "  " + r + " = call i1 @kx_str_gt(ptr " + la + ", ptr " + ra + ")"); return "i1 " + r;
            }
            Emit(g, "  " + t + " = icmp sgt " + lt + " " + la + ", " + ra); return "i1 " + t;
        }
        if (e.value == "ne") {
            if (lt == "ptr" || rt == "ptr") {
                if (lt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + la + " to ptr"); la = ext; }
                if (rt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + ra + " to ptr"); ra = ext; }
                var r = "%" + Lbl(g, "r"); Emit(g, "  " + r + " = call i1 @kx_str_eq(ptr " + la + ", ptr " + ra + ")"); return "i1 " + r;
            }
            Emit(g, "  " + t + " = icmp ne " + lt + " " + la + ", " + ra); return "i1 " + t;
        }
         if (e.value == "le") {
            if (lt == "ptr" || rt == "ptr") {
                if (lt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + la + " to ptr"); la = ext; }
                if (rt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + ra + " to ptr"); ra = ext; }
                var r = "%" + Lbl(g, "r"); Emit(g, "  " + r + " = call i1 @kx_str_le(ptr " + la + ", ptr " + ra + ")"); return "i1 " + r;
            }
            Emit(g, "  " + t + " = icmp sle " + lt + " " + la + ", " + ra); return "i1 " + t;
        }
        if (e.value == "ge") {
            if (lt == "ptr" || rt == "ptr") {
                if (lt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + la + " to ptr"); la = ext; }
                if (rt != "ptr") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = inttoptr i64 " + ra + " to ptr"); ra = ext; }
                var r = "%" + Lbl(g, "r"); Emit(g, "  " + r + " = call i1 @kx_str_ge(ptr " + la + ", ptr " + ra + ")"); return "i1 " + r;
            }
            Emit(g, "  " + t + " = icmp sge " + lt + " " + la + ", " + ra); return "i1 " + t;
        }
        if (e.value == "and") {
            var lv2 = la; var rv2 = ra;
            if (lt == "i64") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = icmp ne i64 " + la + ", 0"); lv2 = ext; }
            if (rt == "i64") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = icmp ne i64 " + ra + ", 0"); rv2 = ext; }
            Emit(g, "  " + t + " = and i1 " + lv2 + ", " + rv2); return "i1 " + t;
        }
        if (e.value == "or") {
            var lv2 = la; var rv2 = ra;
            if (lt == "i64") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = icmp ne i64 " + la + ", 0"); lv2 = ext; }
            if (rt == "i64") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = icmp ne i64 " + ra + ", 0"); rv2 = ext; }
            Emit(g, "  " + t + " = or i1 " + lv2 + ", " + rv2); return "i1 " + t;
        }
        return lt + " " + t;
    }
    if (e.kind == "unary") {
        var v = GenExpr(g, Child(arena, e, 0), arena);
        var vt = XType(v); var va = XVal(v);
        var t = "%" + Lbl(g, "t");
        if (e.value == "neg") { Emit(g, "  " + t + " = sub " + vt + " 0, " + va); return vt + " " + t; }
        if (e.value == "not") {
            var nv = va;
            if (vt == "i64") { var ext = "%" + Lbl(g, "ext"); Emit(g, "  " + ext + " = icmp ne i64 " + va + ", 0"); nv = ext; }
            Emit(g, "  " + t + " = xor i1 " + nv + ", true");
            return "i1 " + t;
        }
        if (e.value == "postinc") {
            var child = Child(arena, e, 0);
            if (child.kind == "identifier" && g.ln.Has(child.value)) {
                var lhsType = g.lt.Get(child.value);
                var lhsPtr = g.ln.Get(child.value);
                var old = "%" + Lbl(g, "old");
                Emit(g, "  " + old + " = load " + lhsType + ", ptr " + lhsPtr);
                if (lhsType == "i64") {
                    var inc = "%" + Lbl(g, "inc");
                    Emit(g, "  " + inc + " = add i64 " + old + ", 1");
                    Emit(g, "  store i64 " + inc + ", ptr " + lhsPtr);
                    return "i64 " + old;
                } else {
                    var inc = "%" + Lbl(g, "inc");
                    Emit(g, "  " + inc + " = add i32 " + old + ", 1");
                    Emit(g, "  store i32 " + inc + ", ptr " + lhsPtr);
                    return "i32 " + old;
                }
            }
            return v;
        }
        if (e.value == "postdec") {
            var child = Child(arena, e, 0);
            if (child.kind == "identifier" && g.ln.Has(child.value)) {
                var lhsType = g.lt.Get(child.value);
                var lhsPtr = g.ln.Get(child.value);
                var old = "%" + Lbl(g, "old");
                Emit(g, "  " + old + " = load " + lhsType + ", ptr " + lhsPtr);
                if (lhsType == "i64") {
                    var dec = "%" + Lbl(g, "dec");
                    Emit(g, "  " + dec + " = sub i64 " + old + ", 1");
                    Emit(g, "  store i64 " + dec + ", ptr " + lhsPtr);
                    return "i64 " + old;
                } else {
