    if (e.kind == "arg") { return GenExpr(g, Child(arena, e, 0), arena); }
    if (e.kind == "is") {
        var base = GenExpr(g, Child(arena, e, 0), arena);
        var bt = XType(base);
        var bv = XVal(base);
        if (e.children.Count > 2) {
            var bind = Child(arena, e, 2).value;
            var bindPtr = "%" + Lbl(g, "is");
            if (bt == "ptr") {
