                g.lt.Set(bind, "ptr");
                g.ln.Set(bind, bindPtr);
            } else {
                Emit(g, "  " + bindPtr + " = alloca i64");
                Emit(g, "  store i64 " + bv + ", ptr " + bindPtr);
                g.lt.Set(bind, "i64");
                g.ln.Set(bind, bindPtr);
            }
        }
        var r = "%" + Lbl(g, "is");
        if (bt == "ptr") {
            Emit(g, "  " + r + " = icmp ne ptr " + bv + ", null");
