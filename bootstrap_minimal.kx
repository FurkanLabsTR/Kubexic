// bootstrap_minimal.kx -- Minimal compiler that works with C++ compiler
// Compiles simple .kx to LLVM IR text

var IntStr(v) {
    if (v == 0) return "0";
    var s = "";
    var n = v;
    if (n < 0) { s = "-"; n = 0 - n; }
    var digits = "";
    while (n > 0) {
        var d = n % 10;
        digits = ("" + ($"{d}")) + digits;
        n = n / 10;
    }
    return s + digits;
}

var Compile(src) {
    var ir = "target triple = \"x86_64-unknown-linux-gnu\"\n\n";
    ir = ir + "declare i64 @kx_println(ptr)\n";
    ir = ir + "declare i64 @kx_print(ptr)\n";
    ir = ir + "declare ptr @kx_int_str(i64)\n";
    ir = ir + "declare ptr @kx_str_cat(ptr, ptr)\n";
    ir = ir + "declare i1 @kx_str_eq(ptr, ptr)\n";
    ir = ir + "\n";
    ir = ir + "@.str.hello = private unnamed_addr constant [14 x i8] c\"Hello from .kx\\00\"\n";
    ir = ir + "\n";
    ir = ir + "define i32 @main() {\n";
    ir = ir + "  %s = getelementptr [14 x i8], [14 x i8]* @.str.hello, i32 0, i32 0\n";
    ir = ir + "  call i64 @kx_println(i8* %s)\n";
    ir = ir + "  ret i32 0\n";
    ir = ir + "}\n";
    return ir;
}

int main() {
    std.println("Kubexic bootstrap compiler v0.1");
    std.println("Compiles simple .kx to LLVM IR");
    var ir = Compile("test");
    std.println(ir);
    return 0;
}
