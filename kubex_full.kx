// kubex_full.kx -- Kubexic compiler (with variables, function calls, arithmetic)
extern int kx_argc();
extern string kx_argv(int i);
extern string kx_read_file(string path);
extern int kx_write_file(string path, string data);
extern int kx_println(string s);

var IntStr(v) {
    if (v == 0) return "0";
    var s = ""; var n = v;
    if (n < 0) { s = "-"; n = 0 - n; }
    var d = ""; while (n > 0) { d = ("" + ($"{n % 10}")) + d; n = n / 10; }
    return s + d;
}

var TokenKind(t) { var i = 0; while (i < t.Length && t.Substring(i, 1) != "|") { i = i + 1; } return t.Substring(0, i); }
var TokenText(t) { var i = 0; while (i < t.Length && t.Substring(i, 1) != "|") { i = i + 1; } var s = i + 1; i = s; while (i < t.Length && t.Substring(i, 1) != "|") { i = i + 1; } return t.Substring(s, i - s); }
var MakeToken(kind, text, line, col) { return kind + "|" + text + "|" + IntStr(line) + "|" + IntStr(col); }

var ContainsChar(s, ch) { var i = 0; while (i < s.Length) { if (s.Substring(i, 1) == ch) return true; i = i + 1; } return false; }
var IsLetter(c) { return ContainsChar("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", c); }
var IsDigit(c) { return ContainsChar("0123456789", c); }
var IsIdentPart(c) { return IsLetter(c) || IsDigit(c) || c == "_"; }
var CharAt(s, i) { if (i < 0 || i >= s.Length) return ""; return s.Substring(i, 1); }

var LexAll(src) {
    var tokens = List<string>();
    var pos = List<int>(); pos.Add(0); var line = 1; var col = 1; var n = src.Length;
    while (pos.Get(0) < n) {
        var c = CharAt(src, pos.Get(0));
        if (c == " " || c == "\t" || c == "\n") { pos.Set(0, pos.Get(0) + 1); col = col + 1; if (c == "\n") { line = line + 1; col = 1; } continue; }
        if (c == "/" && CharAt(src, pos.Get(0) + 1) == "/") { while (pos.Get(0) < n && CharAt(src, pos.Get(0)) != "\n") { pos.Set(0, pos.Get(0) + 1); col = col + 1; } continue; }
        if (IsLetter(c) || c == "_") {
            var start = pos.Get(0); var sc = col; var sl = line;
            while (pos.Get(0) < n && IsIdentPart(CharAt(src, pos.Get(0)))) { pos.Set(0, pos.Get(0) + 1); col = col + 1; }
            var text = src.Substring(start, pos.Get(0) - start);
            var kind = "id";
            if (text == "var" || text == "int" || text == "void" || text == "string" || text == "if" || text == "else" || text == "while" || text == "return" || text == "extern" || text == "component" || text == "system" || text == "struct") { kind = "kw"; }
            tokens.Add(MakeToken(kind, text, sl, sc));
            continue;
        }
        if (IsDigit(c)) { var start = pos.Get(0); while (pos.Get(0) < n && IsDigit(CharAt(src, pos.Get(0)))) { pos.Set(0, pos.Get(0) + 1); } tokens.Add(MakeToken("int", src.Substring(start, pos.Get(0) - start), line, col)); continue; }
        if (c == "\"") { pos.Set(0, pos.Get(0) + 1); var text = ""; while (pos.Get(0) < n && CharAt(src, pos.Get(0)) != "\"") { text = text + CharAt(src, pos.Get(0)); pos.Set(0, pos.Get(0) + 1); } pos.Set(0, pos.Get(0) + 1); tokens.Add(MakeToken("string", text, line, col)); continue; }
        var two = src.Substring(pos.Get(0), 2);
        if (two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||") {
            tokens.Add(MakeToken("op", two, line, col)); pos.Set(0, pos.Get(0) + 2); col = col + 2; continue;
        }
        tokens.Add(MakeToken("punct", c, line, col)); pos.Set(0, pos.Get(0) + 1);
    }
    tokens.Add(MakeToken("eof", "", line, col));
    return tokens;
}

var SkipBlock(tokens, pos) { var depth = 0; pos.Set(0, pos.Get(0) + 1); while (depth > 0 && pos.Get(0) < tokens.Count) { if (TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == "{") { depth = depth + 1; } if (TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == "}") { depth = depth - 1; } if (depth > 0) { pos.Set(0, pos.Get(0) + 1); } } pos.Set(0, pos.Get(0) + 1); return 0; }

// Simple expression parser - returns LLVM IR value string
var GenExpr(tokens, pos, locals, counter) {
    var t = TokenKind(tokens.Get(pos.Get(0)));
    var tx = TokenText(tokens.Get(pos.Get(0)));
    if (t == "int") { pos.Set(0, pos.Get(0) + 1); return "i32 " + tx; }
    if (t == "string") { pos.Set(0, pos.Get(0) + 1); return "ptr @.str"; }
    if (t == "id") {
        pos.Set(0, pos.Get(0) + 1);
        if (pos.Get(0) < tokens.Count && TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == "(") {
            pos.Set(0, pos.Get(0) + 1);
            var args = ""; var argCount = 0;
            while (pos.Get(0) < tokens.Count && !(TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == ")")) {
                var argVal = GenExpr(tokens, pos, locals, counter);
                if (argCount > 0) args = args + ", ";
                args = args + argVal; argCount = argCount + 1;
                if (pos.Get(0) < tokens.Count && TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == ",") { pos.Set(0, pos.Get(0) + 1); }
            }
            pos.Set(0, pos.Get(0) + 1);
            var r = "%r." + IntStr(counter.Get(0)); counter.Set(0, counter.Get(0) + 1);
            var lr = "%lr." + IntStr(counter.Get(0)); counter.Set(0, counter.Get(0) + 1);
            return "i32 " + lr;
        }
        if (locals.Has(tx)) {
            var v = locals.Get(tx);
            var r = "%v." + IntStr(counter.Get(0)); counter.Set(0, counter.Get(0) + 1);
            var lr = "%lr." + IntStr(counter.Get(0)); counter.Set(0, counter.Get(0) + 1);
            return "i32 " + lr;
        }
        return "i32 0";
    }
    pos.Set(0, pos.Get(0) + 1);
    return "i32 0";
}

int main() {
    var argc = kx_argc();
    if (argc < 2) { kx_println("kubex -- Kubexic compiler"); return 0; }
    var cmd = kx_argv(1);
    if (cmd == "build") {
        if (argc < 4) { kx_println("usage: kubex build <input.kx> <output.ll>"); return 1; }
        var src = kx_read_file(kx_argv(2));
        if (src == "") { kx_println("error: cannot read " + kx_argv(2)); return 1; }
        var tokens = LexAll(src);
        var ir = "target triple = \"x86_64-unknown-linux-gnu\"\n\n";
        ir = ir + "declare void @kx_save_args(i32, ptr)\n";
        ir = ir + "declare i64 @kx_println(ptr)\n";
        ir = ir + "\n";
        var pos = List<int>(); pos.Add(0);
    while (pos.Get(0) < tokens.Count && TokenKind(tokens.Get(pos.Get(0))) != "eof") {
            var t = TokenKind(tokens.Get(pos.Get(0)));
            var tx = TokenText(tokens.Get(pos.Get(0)));
            if (t == "kw" && (tx == "component" || tx == "system" || tx == "struct")) {
                pos.Set(0, pos.Get(0) + 1);
                while (pos.Get(0) < tokens.Count && !(TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == "{")) { pos.Set(0, pos.Get(0) + 1); }
                SkipBlock(tokens, pos); continue;
            }
        if (t == "kw" && (tx == "var" || tx == "int" || tx == "void" || tx == "string" || tx == "double")) {
                var retType = tx; pos.Set(0, pos.Get(0) + 1);
                var fnName = TokenText(tokens.Get(pos.Get(0))); pos.Set(0, pos.Get(0) + 1);
                if (pos.Get(0) < tokens.Count && TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == "(") {
                    pos.Set(0, pos.Get(0) + 1);
                    while (pos.Get(0) < tokens.Count && !(TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == ")")) { pos.Set(0, pos.Get(0) + 1); }
                    pos.Set(0, pos.Get(0) + 1);
                }
                var irRet = "i32";
                if (retType == "void") irRet = "void";
                else if (retType == "string") irRet = "ptr";
                else if (retType == "double") irRet = "double";
                var depth = 1; pos.Set(0, pos.Get(0) + 1);
                var locals = Map<string, string>();
                var counter = List<int>(); counter.Add(0);
                var bodyIr = "";
                while (depth > 0 && pos.Get(0) < tokens.Count) {
                    kx_println("TOK: " + TokenText(tokens.Get(pos.Get(0))));
                    kx_println("depth=" + IntStr(depth) + " pos=" + IntStr(pos.Get(0)) + " tok=" + TokenKind(tokens.Get(pos.Get(0))) + "|" + TokenText(tokens.Get(pos.Get(0))));
                    if (TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == "{") { depth = depth + 1; kx_println("depth: " + IntStr(depth)); }
                    if (TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == "}") { depth = depth - 1; }
                    if (TokenKind(tokens.Get(pos.Get(0))) == "kw" && TokenText(tokens.Get(pos.Get(0))) == "return" && depth == 1) {
                        pos.Set(0, pos.Get(0) + 1);
                        var valIr = GenExpr(tokens, pos, locals, counter);
                        if (pos.Get(0) < tokens.Count && TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == ";") { pos.Set(0, pos.Get(0) + 1); }
                        bodyIr = bodyIr + "  ret " + irRet + " " + valIr + "\n";
                    } else if (TokenKind(tokens.Get(pos.Get(0))) == "kw" && TokenText(tokens.Get(pos.Get(0))) == "var" && depth == 1) {
                        pos.Set(0, pos.Get(0) + 1);
                        var varName = TokenText(tokens.Get(pos.Get(0))); pos.Set(0, pos.Get(0) + 1);
                        if (pos.Get(0) < tokens.Count && TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == "=") { pos.Set(0, pos.Get(0) + 1); }
                        var valIr = GenExpr(tokens, pos, locals, counter);
                        if (pos.Get(0) < tokens.Count && TokenKind(tokens.Get(pos.Get(0))) == "punct" && TokenText(tokens.Get(pos.Get(0))) == ";") { pos.Set(0, pos.Get(0) + 1); }
                        var alloc = "%alloc." + varName;
                        bodyIr = bodyIr + "  " + alloc + " = alloca i32\n";
                        bodyIr = bodyIr + "  store i32 " + valIr + ", i32* " + alloc + "\n";
                        locals.Set(varName, alloc);
                    }
                    if (depth > 0) { pos.Set(0, pos.Get(0) + 1); }
                }
                pos.Set(0, pos.Get(0) + 1);
                ir = ir + "define " + irRet + " @" + fnName + "() {\nentry:\n" + bodyIr + "}\n\n";
                continue;
            }
            pos.Set(0, pos.Get(0) + 1);
        }
        kx_write_file(kx_argv(3), ir);
        kx_println("compiled " + kx_argv(2) + " -> " + kx_argv(3));
        return 0;
    }
    return 1;
}
