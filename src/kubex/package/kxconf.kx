// kxconf.kx — .kxconf parser for Kubexic, written in Kubexic.

struct KxConfEntry {
    var key = "";
    var value = "";
}

struct KxConfSection {
    var name = "";
    var entries = List<KxConfEntry>();
}

struct KxConf {
    var sections = List<KxConfSection>();
    var errors = List<string>();
}

var ParseKxConf(content) {
    var conf = KxConf {};
    var lines = content.Split("\n");
    var currentSection = "";
    var sectionEntries = List<KxConfEntry>();
    for (var i = 0; i < lines.Count; i++) {
        var line = lines.Get(i).Trim();
        if (line == "" || line.StartsWith("//")) {
            continue;
        }
        if (line.StartsWith("[")) {
            // Save previous section
            if (currentSection != "") {
                conf.sections.Add(KxConfSection { name = currentSection, entries = sectionEntries });
                sectionEntries = List<KxConfEntry>();
            }
            var end = line.IndexOf("]");
            if (end > 0) {
                currentSection = line.Substring(1, end - 1);
            }
            continue;
        }
        var eq = line.IndexOf("=");
        if (eq > 0) {
            var key = line.Substring(0, eq).Trim();
            var value = line.Substring(eq + 1).Trim();
            // Remove quotes
            if (value.Length >= 2 && value.StartsWith("\"") && value.EndsWith("\"")) {
                value = value.Substring(1, value.Length - 2);
            }
            sectionEntries.Add(KxConfEntry { key = key, value = value });
        }
    }
    // Save last section
    if (currentSection != "") {
        conf.sections.Add(KxConfSection { name = currentSection, entries = sectionEntries });
    }
    return conf;
}

var GetSection(conf, name) {
    for (var i = 0; i < conf.sections.Count; i++) {
        if (conf.sections.Get(i).name == name) {
            return conf.sections.Get(i);
        }
    }
    return KxConfSection {};
}

var GetEntry(section, key) {
    for (var i = 0; i < section.entries.Count; i++) {
        if (section.entries.Get(i).key == key) {
            return section.entries.Get(i).value;
        }
    }
    return "";
}
