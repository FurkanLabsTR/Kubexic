// parser.kx — the Kubexic recursive-descent parser, written in Kubexic.
// Produces an arena-indexed AST and dumps it in the exact format of
// 'kxc dump' so the two implementations can be diffed byte-for-byte.

struct Token {
    var kind = "";
    var text = "";
    var line = 0;
    var col = 0;
}

struct AstNode {
    var kind = "";
    var value = "";
    var line = 0;
    var col = 0;
    var children = List<int>();
}

/* ---------------- lexer ---------------- */

var IsDigit(c) {
    return c >= "0" && c <= "9";
}

var IsLetter(c) {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z");
}

var IsIdentPart(c) {
    return IsLetter(c) || IsDigit(c) || c == "_";
}

var IsSpace(c) {
    return c == " " || c == "\t" || c == "\n" || c == "\r";
}

var CharAt(s, i) {
    if (i < 0 || i >= s.Length) {
        return "";
    }
    return s.Substring(i, 1);
}

var LexAll(src) {
    var tokens = List<Token>();
    var pos = 0;
    var line = 1;
    var col = 1;
    var n = src.Length;
    while (pos < n) {
        var c = CharAt(src, pos);
        if (IsSpace(c)) {
            pos++;
            col++;
            if (c == "\n") {
                line++;
                col = 1;
            }
            continue;
        }
        if (c == "/" && CharAt(src, pos + 1) == "/") {
            while (pos < n && CharAt(src, pos) != "\n") {
                pos++;
                col++;
            }
            continue;
        }
        if (c == "/" && CharAt(src, pos + 1) == "*") {
            pos += 2;
            col += 2;
            while (pos < n && !(CharAt(src, pos) == "*" && CharAt(src, pos + 1) == "/")) {
                if (CharAt(src, pos) == "\n") {
                    line++;
                    col = 1;
                } else {
                    col++;
                }
                pos++;
            }
            pos += 2;
            col += 2;
            continue;
        }
        if (IsLetter(c) || c == "_") {
            var start = pos;
            var startCol = col;
            var startLine = line;
            while (pos < n && IsIdentPart(CharAt(src, pos))) {
                pos++;
                col++;
            }
            var text = src.Substring(start, pos - start);
            var kind = "id";
            if (text == "component" || text == "system" || text == "tag" ||
                text == "struct" || text == "enum" || text == "const" ||
                text == "var" || text == "void" || text == "int" ||
                text == "long" || text == "float" || text == "double" ||
                text == "bool" || text == "byte" || text == "string" ||
                text == "if" || text == "else" || text == "while" ||
                text == "for" || text == "foreach" || text == "in" ||
                text == "break" || text == "continue" || text == "return" ||
                text == "spawn" || text == "despawn" || text == "attach" ||
                text == "detach" || text == "self" || text == "with" ||
                text == "without" || text == "new" || text == "tags" ||
                text == "using" || text == "true" || text == "false" ||
                text == "is" || text == "exact" || text == "panic" ||
                text == "switch" || text == "case" || text == "default" ||
                text == "extern" || text == "pub") {
                kind = "kw";
            }
            tokens.Add(Token { kind = kind, text = text, line = startLine, col = startCol });
            continue;
        }
        if (IsDigit(c)) {
            var start = pos;
            var startCol = col;
            var startLine = line;
            var isFloat = false;
            while (pos < n && IsDigit(CharAt(src, pos))) {
                pos++;
                col++;
            }
            if (CharAt(src, pos) == "." && IsDigit(CharAt(src, pos + 1))) {
                isFloat = true;
                pos++;
                col++;
                while (pos < n && IsDigit(CharAt(src, pos))) {
                    pos++;
                    col++;
                }
            }
            var text = src.Substring(start, pos - start);
            tokens.Add(Token { kind = isFloat ? "float" : "int", text = text,
                               line = startLine, col = startCol });
            continue;
        }
        if (c == "$" && CharAt(src, pos + 1) == "\"") {
            var startCol = col;
            var startLine = line;
            pos += 2;
            col += 2;
            var text = "";
            var depth = 0;
            while (pos < n) {
                var dc = CharAt(src, pos);
                if (dc == "{") {
                    depth++;
                    text += dc;
                    pos++;
                    col++;
                    continue;
                }
                if (dc == "}") {
                    if (depth > 0) {
                        depth--;
                    }
                    text += dc;
                    pos++;
                    col++;
                    continue;
                }
                if (dc == "\"" && depth == 0) {
                    break;
                }
                text += dc;
                pos++;
                col++;
            }
            pos++;
            col++;
            tokens.Add(Token { kind = "dstr", text = text, line = startLine, col = startCol });
            continue;
        }
        if (c == "\"") {
            var startCol = col;
            var startLine = line;
            pos++;
            col++;
            var text = "";
            while (pos < n && CharAt(src, pos) != "\"") {
                if (CharAt(src, pos) == "\\" && pos + 1 < n) {
                    var esc = CharAt(src, pos + 1);
                    if (esc == "n") {
                        text += "\n";
                    } else if (esc == "t") {
                        text += "\t";
                    } else if (esc == "r") {
                        text += "\r";
                    } else if (esc == "\\") {
                        text += "\\";
                    } else if (esc == "\"") {
                        text += "\"";
                    } else {
                        text += "\\";
                        text += esc;
                    }
                    pos += 2;
                    col += 2;
                } else {
                    text += CharAt(src, pos);
                    pos++;
                    col++;
                }
            }
            pos++;
            col++;
            tokens.Add(Token { kind = "string", text = text, line = startLine, col = startCol });
            continue;
        }
        var two = src.Substring(pos, 2);
        if (two == "==" || two == "!=" || two == "<=" || two == ">=" ||
            two == "&&" || two == "||" || two == "+=" || two == "-=" ||
            two == "*=" || two == "/=" || two == "%=" || two == "++" ||
            two == "--" || two == "->") {
            tokens.Add(Token { kind = "op", text = two, line = line, col = col });
            pos += 2;
            col += 2;
            continue;
        }
        tokens.Add(Token { kind = "punct", text = c, line = line, col = col });
        pos++;
        col++;
    }
    tokens.Add(Token { kind = "eof", text = "", line = line, col = col });
    return tokens;
}

/* ---------------- arena helpers ---------------- */

var NewNode(arena, kind, value, line, col) {
    arena.Add(AstNode { kind = kind, value = value, line = line, col = col,
                        children = List<int>() });
    return arena.Count - 1;
}

var Node(arena, i) {
    return arena.Get(i);
}

void AddChild(arena, parent, child) {
    var children = arena.Get(parent).children;
    children.Add(child);
}

/* ---------------- cursor helpers ---------------- */

var Peek(tokens, pos) {
    return tokens.Get(pos.Get(0));
}

var CurKind(tokens, pos) {
    return Peek(tokens, pos).kind;
}

var CurText(tokens, pos) {
    return Peek(tokens, pos).text;
}

var CurLine(tokens, pos) {
    return Peek(tokens, pos).line;
}

var CurCol(tokens, pos) {
    return Peek(tokens, pos).col;
}

var AtEnd(tokens, pos) {
    return CurKind(tokens, pos) == "eof";
}

void Advance(tokens, pos) {
    pos.Set(0, pos.Get(0) + 1);
}

var IsKw(tokens, pos, w) {
    var t = Peek(tokens, pos);
    return t.kind == "kw" && t.text == w;
}

var IsPunct(tokens, pos, p) {
    var t = Peek(tokens, pos);
    return t.kind == "punct" && t.text == p;
}

var IsOp(tokens, pos, o) {
    var t = Peek(tokens, pos);
    return t.kind == "op" && t.text == o;
}

var IsNameTok(tokens, pos) {
    var t = Peek(tokens, pos);
    return t.kind == "id" || t.kind == "kw";
}

var MatchKw(tokens, pos, w) {
    if (IsKw(tokens, pos, w)) {
        Advance(tokens, pos);
        return true;
    }
    return false;
}

var MatchPunct(tokens, pos, p) {
    if (IsPunct(tokens, pos, p)) {
        Advance(tokens, pos);
        return true;
    }
    return false;
}

var MatchOp(tokens, pos, o) {
    if (IsOp(tokens, pos, o)) {
        Advance(tokens, pos);
        return true;
    }
    return false;
}

var ExpectPunct(tokens, pos, p, errors, what) {
    if (!MatchPunct(tokens, pos, p)) {
        errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected {what}");
        return false;
    }
    return true;
}

var ExpectName(tokens, pos, errors, what) {
    if (IsNameTok(tokens, pos)) {
        Advance(tokens, pos);
        return true;
    }
    errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected {what}");
    return false;
}

var PrevText(tokens, pos) {
    return tokens.Get(pos.Get(0) - 1).text;
}

/* ---------------- expression parsing ---------------- */

var ParseExpression(tokens, pos, arena, errors);

var ParsePrimary(tokens, pos, arena, errors) {
    var t = Peek(tokens, pos);
    if (t.kind == "int") {
        Advance(tokens, pos);
        return NewNode(arena, "int", t.text, t.line, t.col);
    }
    if (t.kind == "float") {
        Advance(tokens, pos);
        return NewNode(arena, "float", t.text, t.line, t.col);
    }
    if (t.kind == "string") {
        Advance(tokens, pos);
        return NewNode(arena, "string", t.text, t.line, t.col);
    }
    if (t.kind == "kw" && t.text == "true") {
        Advance(tokens, pos);
        return NewNode(arena, "bool", "true", t.line, t.col);
    }
    if (t.kind == "kw" && t.text == "false") {
        Advance(tokens, pos);
        return NewNode(arena, "bool", "false", t.line, t.col);
    }
    if (t.kind == "kw" && t.text == "self") {
        Advance(tokens, pos);
        return NewNode(arena, "identifier", "self", t.line, t.col);
    }
    if (t.kind == "id") {
        Advance(tokens, pos);
        if (IsPunct(tokens, pos, "{")) {
            Advance(tokens, pos);
            var node = NewNode(arena, "structinit", t.text, t.line, t.col);
            while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
                if (!IsNameTok(tokens, pos)) {
                    break;
                }
                var fname = CurText(tokens, pos);
                Advance(tokens, pos);
                if (!ExpectPunct(tokens, pos, "=", errors, "'=' in initializer")) {
                    break;
                }
                var initNode = NewNode(arena, "field", fname, t.line, t.col);
                AddChild(arena, initNode, ParseExpression(tokens, pos, arena, errors));
                AddChild(arena, node, initNode);
                if (!MatchPunct(tokens, pos, ",")) {
                    break;
                }
            }
            ExpectPunct(tokens, pos, "}", errors, "'}' to close initializer");
            return node;
        }
        if (IsPunct(tokens, pos, "(")) {
            Advance(tokens, pos);
            var callNode = NewNode(arena, "call", t.text, t.line, t.col);
            while (!IsPunct(tokens, pos, ")") && !AtEnd(tokens, pos)) {
                AddChild(arena, callNode, ParseExpression(tokens, pos, arena, errors));
                if (!MatchPunct(tokens, pos, ",")) {
                    break;
                }
            }
            ExpectPunct(tokens, pos, ")", errors, "')' after call arguments");
            return callNode;
        }
        return NewNode(arena, "identifier", t.text, t.line, t.col);
    }
    if (IsPunct(tokens, pos, "(")) {
        Advance(tokens, pos);
        var inner = ParseExpression(tokens, pos, arena, errors);
        ExpectPunct(tokens, pos, ")", errors, "')'");
        return inner;
    }
    errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: unexpected token");
    Advance(tokens, pos);
    return NewNode(arena, "error", "", t.line, t.col);
}

var ParseBinary(tokens, pos, arena, errors, minPrec) {
    var left = ParsePrimary(tokens, pos, arena, errors);
    while (true) {
        var t = Peek(tokens, pos);
        var prec = 0;
        if (t.kind == "op") {
            if (t.text == "==" || t.text == "!=" || t.text == "<" ||
                t.text == ">" || t.text == "<=" || t.text == ">=") {
                prec = 2;
            } else if (t.text == "+" || t.text == "-") {
                prec = 3;
            } else if (t.text == "*" || t.text == "/" || t.text == "%") {
                prec = 4;
            } else if (t.text == "&&") {
                prec = 1;
            } else if (t.text == "||") {
                prec = 1;
            }
        }
        if (prec < minPrec) {
            break;
        }
        var op = t.text;
        Advance(tokens, pos);
        var right = ParseBinary(tokens, pos, arena, errors, prec + 1);
        var binNode = NewNode(arena, "binary", op, t.line, t.col);
        AddChild(arena, binNode, left);
        AddChild(arena, binNode, right);
        left = binNode;
    }
    return left;
}

ParseExpression = (tokens, pos, arena, errors) -> {
    return ParseBinary(tokens, pos, arena, errors, 0);
};

/* ---------------- statement parsing ---------------- */

var ParseStatement(tokens, pos, arena, errors) {
    var t = Peek(tokens, pos);
    if (IsKw(tokens, pos, "return")) {
        Advance(tokens, pos);
        var retNode = NewNode(arena, "return", "", t.line, t.col);
        if (!AtEnd(tokens, pos) && !IsKw(tokens, pos, "return")) {
            AddChild(arena, retNode, ParseExpression(tokens, pos, arena, errors));
        }
        ExpectPunct(tokens, pos, ";", errors, "';' after return");
        return retNode;
    }
    if (IsKw(tokens, pos, "var")) {
        Advance(tokens, pos);
        var name = CurText(tokens, pos);
        ExpectName(tokens, pos, errors, "variable name");
        ExpectPunct(tokens, pos, "=", errors, "'=' in var declaration");
        var val = ParseExpression(tokens, pos, arena, errors);
        ExpectPunct(tokens, pos, ";", errors, "';' after var declaration");
        var decl = NewNode(arena, "vardecl", name, t.line, t.col);
        AddChild(arena, decl, val);
        return decl;
    }
    if (IsKw(tokens, pos, "if")) {
        Advance(tokens, pos);
        ExpectPunct(tokens, pos, "(", errors, "'(' after 'if'");
        var cond = ParseExpression(tokens, pos, arena, errors);
        ExpectPunct(tokens, pos, ")", errors, "')' after condition");
        var thenBlock = ParseBlock(tokens, pos, arena, errors);
        var ifNode = NewNode(arena, "if", "", t.line, t.col);
        AddChild(arena, ifNode, cond);
        AddChild(arena, ifNode, thenBlock);
        if (MatchKw(tokens, pos, "else")) {
            AddChild(arena, ifNode, ParseBlock(tokens, pos, arena, errors));
        }
        return ifNode;
    }
    if (IsKw(tokens, pos, "while")) {
        Advance(tokens, pos);
        ExpectPunct(tokens, pos, "(", errors, "'(' after 'while'");
        var cond = ParseExpression(tokens, pos, arena, errors);
        ExpectPunct(tokens, pos, ")", errors, "')' after condition");
        var body = ParseBlock(tokens, pos, arena, errors);
        var whileNode = NewNode(arena, "while", "", t.line, t.col);
        AddChild(arena, whileNode, cond);
        AddChild(arena, whileNode, body);
        return whileNode;
    }
    if (IsKw(tokens, pos, "break")) {
        Advance(tokens, pos);
        ExpectPunct(tokens, pos, ";", errors, "';' after break");
        return NewNode(arena, "break", "", t.line, t.col);
    }
    if (IsKw(tokens, pos, "continue")) {
        Advance(tokens, pos);
        ExpectPunct(tokens, pos, ";", errors, "';' after continue");
        return NewNode(arena, "continue", "", t.line, t.col);
    }
    if (IsPunct(tokens, pos, "{")) {
        return ParseBlock(tokens, pos, arena, errors);
    }
    var expr = ParseExpression(tokens, pos, arena, errors);
    ExpectPunct(tokens, pos, ";", errors, "';' after expression");
    return NewNode(arena, "exprstmt", "", t.line, t.col);
}

var ParseBlock(tokens, pos, arena, errors) {
    ExpectPunct(tokens, pos, "{", errors, "'{' to start block");
    var block = NewNode(arena, "block", "", CurLine(tokens, pos), CurCol(tokens, pos));
    while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
        AddChild(arena, block, ParseStatement(tokens, pos, arena, errors));
    }
    ExpectPunct(tokens, pos, "}", errors, "'}' to close block");
    return block;
}

/* ---------------- declaration parsing ---------------- */

var ParseDecl(tokens, pos, arena, errors) {
    var t = Peek(tokens, pos);
    if (IsKw(tokens, pos, "component")) {
        Advance(tokens, pos);
        var name = CurText(tokens, pos);
        ExpectName(tokens, pos, errors, "component name");
        var compNode = NewNode(arena, "component", name, t.line, t.col);
        ExpectPunct(tokens, pos, "{", errors, "'{' to start component");
        while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
            if (MatchKw(tokens, pos, "var")) {
                var fieldName = CurText(tokens, pos);
                ExpectName(tokens, pos, errors, "field name");
                ExpectPunct(tokens, pos, "=", errors, "'=' in field default");
                var fieldVal = ParseExpression(tokens, pos, arena, errors);
                ExpectPunct(tokens, pos, ";", errors, "';' after field");
                var fieldNode = NewNode(arena, "field", fieldName, t.line, t.col);
                AddChild(arena, fieldNode, fieldVal);
                AddChild(arena, compNode, fieldNode);
            } else {
                Advance(tokens, pos);
            }
        }
        ExpectPunct(tokens, pos, "}", errors, "'}' to close component");
        return compNode;
    }
    if (IsKw(tokens, pos, "system")) {
        Advance(tokens, pos);
        var name = CurText(tokens, pos);
        ExpectName(tokens, pos, errors, "system name");
        var sysNode = NewNode(arena, "system", name, t.line, t.col);
        // Parse optional with/without clauses
        while (MatchKw(tokens, pos, "with") || MatchKw(tokens, pos, "without")) {
            var clause = NewNode(arena, "clause", PrevText(tokens, pos), t.line, t.col);
            ExpectPunct(tokens, pos, "(", errors, "'(' after with/without");
            while (!IsPunct(tokens, pos, ")") && !AtEnd(tokens, pos)) {
                var compName = CurText(tokens, pos);
                ExpectName(tokens, pos, errors, "component name");
                AddChild(arena, clause, NewNode(arena, "identifier", compName, t.line, t.col));
                MatchPunct(tokens, pos, ",");
            }
            ExpectPunct(tokens, pos, ")", errors, "')' after with/without list");
            AddChild(arena, sysNode, clause);
        }
        var body = ParseBlock(tokens, pos, arena, errors);
        AddChild(arena, sysNode, body);
        return sysNode;
    }
    if (IsKw(tokens, pos, "tag")) {
        Advance(tokens, pos);
        var name = CurText(tokens, pos);
        ExpectName(tokens, pos, errors, "tag name");
        var tagNode = NewNode(arena, "tag", name, t.line, t.col);
        if (MatchPunct(tokens, pos, ":")) {
            var parent = CurText(tokens, pos);
            ExpectName(tokens, pos, errors, "parent tag name");
            AddChild(arena, tagNode, NewNode(arena, "identifier", parent, t.line, t.col));
        }
        ExpectPunct(tokens, pos, ";", errors, "';' after tag");
        return tagNode;
    }
    if (IsKw(tokens, pos, "struct")) {
        Advance(tokens, pos);
        var name = CurText(tokens, pos);
        ExpectName(tokens, pos, errors, "struct name");
        var structNode = NewNode(arena, "struct", name, t.line, t.col);
        ExpectPunct(tokens, pos, "{", errors, "'{' to start struct");
        while (!IsPunct(tokens, pos, "}") && !AtEnd(tokens, pos)) {
            if (MatchKw(tokens, pos, "var")) {
                var fieldName = CurText(tokens, pos);
                ExpectName(tokens, pos, errors, "field name");
                ExpectPunct(tokens, pos, "=", errors, "'=' in field default");
                var fieldVal = ParseExpression(tokens, pos, arena, errors);
                ExpectPunct(tokens, pos, ";", errors, "';' after field");
                var fieldNode = NewNode(arena, "field", fieldName, t.line, t.col);
                AddChild(arena, fieldNode, fieldVal);
                AddChild(arena, structNode, fieldNode);
            } else {
                Advance(tokens, pos);
            }
        }
        ExpectPunct(tokens, pos, "}", errors, "'}' to close struct");
        return structNode;
    }
    // Function declaration (var/void/int/long/float/double/string/bool)
    if (IsKw(tokens, pos, "var") || IsKw(tokens, pos, "void") ||
        IsKw(tokens, pos, "int") || IsKw(tokens, pos, "long") ||
        IsKw(tokens, pos, "float") || IsKw(tokens, pos, "double") ||
        IsKw(tokens, pos, "string") || IsKw(tokens, pos, "bool")) {
        var retType = t.text;
        Advance(tokens, pos);
        var name = CurText(tokens, pos);
        ExpectName(tokens, pos, errors, "function name");
        ExpectPunct(tokens, pos, "(", errors, "'(' after function name");
        var funcNode = NewNode(arena, "function", name, t.line, t.col);
        AddChild(arena, funcNode, NewNode(arena, "rettype", retType, t.line, t.col));
        // Parameters
        while (!IsPunct(tokens, pos, ")") && !AtEnd(tokens, pos)) {
            var paramName = CurText(tokens, pos);
            ExpectName(tokens, pos, errors, "parameter name");
            AddChild(arena, funcNode, NewNode(arena, "param", paramName, t.line, t.col));
            MatchPunct(tokens, pos, ",");
        }
        ExpectPunct(tokens, pos, ")", errors, "')' after parameters");
        // Check for expression body (-> expr;)
        if (MatchOp(tokens, pos, "->")) {
            var exprBody = ParseExpression(tokens, pos, arena, errors);
            ExpectPunct(tokens, pos, ";", errors, "';' after expression body");
            var bodyBlock = NewNode(arena, "block", "", t.line, t.col);
            var retStmt = NewNode(arena, "return", "", t.line, t.col);
            AddChild(arena, retStmt, exprBody);
            AddChild(arena, bodyBlock, retStmt);
            AddChild(arena, funcNode, bodyBlock);
        } else {
            AddChild(arena, funcNode, ParseBlock(tokens, pos, arena, errors));
        }
        return funcNode;
    }
    errors.Add($"{CurLine(tokens, pos)}:{CurCol(tokens, pos)}: expected declaration");
    Advance(tokens, pos);
    return NewNode(arena, "error", "", t.line, t.col);
}

/* ---------------- program parsing ---------------- */

var ParseProgram(tokens, arena, errors) {
    var pos = List<int>();
    pos.Add(0);
    var program = NewNode(arena, "program", "", 1, 1);
    while (!AtEnd(tokens, pos)) {
        AddChild(arena, program, ParseDecl(tokens, pos, arena, errors));
    }
    return program;
}

/* ---------------- pretty printer ---------------- */

var Indent(level) {
    var s = "";
    for (var i = 0; i < level; i++) {
        s += "  ";
    }
    return s;
}

void DumpNode(arena, nodeIdx, out, level) {
    var n = Node(arena, nodeIdx);
    var pad = Indent(level);
    if (n.kind == "program") {
        out.Add($"{pad}(program");
        for (var i = 0; i < n.children.Count; i++) {
            DumpNode(arena, n.children.Get(i), out, level + 1);
        }
        out.Add($"{pad})");
    } else if (n.kind == "component") {
        out.Add($"{pad}(component {n.value}");
        for (var i = 0; i < n.children.Count; i++) {
            DumpNode(arena, n.children.Get(i), out, level + 1);
        }
        out.Add($"{pad})");
    } else if (n.kind == "system") {
        out.Add($"{pad}(system {n.value}");
        for (var i = 0; i < n.children.Count; i++) {
            DumpNode(arena, n.children.Get(i), out, level + 1);
        }
        out.Add($"{pad})");
    } else if (n.kind == "function") {
        out.Add($"{pad}(function {n.value}");
        for (var i = 0; i < n.children.Count; i++) {
            DumpNode(arena, n.children.Get(i), out, level + 1);
        }
        out.Add($"{pad})");
    } else if (n.kind == "block") {
        out.Add($"{pad}(block");
        for (var i = 0; i < n.children.Count; i++) {
            DumpNode(arena, n.children.Get(i), out, level + 1);
        }
        out.Add($"{pad})");
    } else if (n.kind == "return") {
        out.Add($"{pad}(return");
        for (var i = 0; i < n.children.Count; i++) {
            DumpNode(arena, n.children.Get(i), out, level + 1);
        }
        out.Add($"{pad})");
    } else if (n.kind == "int" || n.kind == "float" || n.kind == "string" || n.kind == "bool") {
        out.Add($"{pad}({n.kind} {n.value})");
    } else if (n.kind == "identifier") {
        out.Add($"{pad}(identifier {n.value})");
    } else if (n.kind == "binary") {
        out.Add($"{pad}(binary {n.value}");
        for (var i = 0; i < n.children.Count; i++) {
            DumpNode(arena, n.children.Get(i), out, level + 1);
        }
        out.Add($"{pad})");
    } else if (n.kind == "call") {
        out.Add($"{pad}(call {n.value}");
        for (var i = 0; i < n.children.Count; i++) {
            DumpNode(arena, n.children.Get(i), out, level + 1);
        }
        out.Add($"{pad})");
    } else {
        out.Add($"{pad}({n.kind} {n.value})");
    }
}

/* ---------------- main ---------------- */

int main() {
    var args = std.args();
    if (args.Count < 2) {
        std.println("usage: parser <file.kx>");
        return 1;
    }
    var src = std.readFile(args.Get(1));
    if (src == "") {
        std.println($"error: could not read {args.Get(1)}");
        return 1;
    }
    var tokens = LexAll(src);
    var arena = List<AstNode>();
    var errors = List<string>();
    var program = ParseProgram(tokens, arena, errors);
    if (errors.Count > 0) {
        for (var i = 0; i < errors.Count; i++) {
            std.println(errors.Get(i));
        }
        return 1;
    }
    var lines = List<string>();
    DumpNode(arena, program, lines, 0);
    for (var i = 0; i < lines.Count; i++) {
        std.println(lines.Get(i));
    }
    return 0;
}
