// llvm_bindings.kx — extern declarations for LLVM C API
// Used by codegen.kx to generate native code via LLVM

// Module operations
extern handle LLVMModuleCreateWithName(string name);
extern void LLVMDisposeModule(handle m);
extern void LLVMSetTarget(handle m, string triple);
extern string  LLVMGetTarget(handle m);
extern void LLVMDumpModule(handle m);

// Type operations
extern handle LLVMInt1Type();
extern handle LLVMInt8Type();
extern handle LLVMInt16Type();
extern handle LLVMInt32Type();
extern handle LLVMInt64Type();
extern handle LLVMFloatType();
extern handle LLVMDoubleType();
extern handle LLVMVoidType();
extern handle LLVMPointerType(handle ty, unsigned addressSpace);
extern handle LLVMFunctionType(handle retTy, handle paramTypes, int paramCount, int isVarArg);
extern handle LLVMStructType(handle elementTypes, int elementCount, int packed);
extern handle LLVMArrayType(handle elemTy, int count);

// Function operations
extern handle LLVMAddFunction(handle m, string name, handle fnTy);
extern handle LLVMGetNamedFunction(handle m, string name);
extern handle LLVMAppendBasicBlock(handle fn, string name);
extern void LLVMDeleteFunction(handle fn);

// Builder operations
extern handle LLVMCreateBuilder();
extern void LLVMDisposeBuilder(handle builder);
extern void LLVMPositionBuilderAtEnd(handle builder, handle block);
extern handle LLVMGetInsertBlock(handle builder);

// Instruction building
extern handle LLVMBuildAlloca(handle builder, handle ty, string name);
extern handle LLVMBuildStore(handle builder, handle val, handle ptr);
extern handle LLVMBuildLoad(handle builder, handle ty, handle ptr, string name);
extern handle LLVMBuildAdd(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildSub(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildMul(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildSDiv(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildSRem(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildFAdd(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildFSub(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildFMul(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildFDiv(handle builder, handle lhs, handle rhs, string name);
extern handle LLVMBuildRet(handle builder, handle val);
extern handle LLVMBuildRetVoid(handle builder);
extern handle LLVMBuildBr(handle builder, handle dest);
extern handle LLVMBuildCondBr(handle builder, handle cond, handle then, handle otherwise);
extern handle LLVMBuildICmp(handle builder, int pred, handle lhs, handle rhs, string name);
extern handle LLVMBuildFCmp(handle builder, int pred, handle lhs, handle rhs, string name);
extern handle LLVMBuildCall(handle builder, handle fn, handle args, int argCount, string name);
extern handle LLVMBuildGEP(handle builder, handle ty, handle pointer, handle indices, int numIndices, string name);
extern handle LLVMBuildStructGEP(handle builder, handle ty, handle pointer, int index, string name);
extern handle LLVMBuildGlobalStringPtr(handle builder, string str, string name);
extern handle LLVMBuildBitCast(handle builder, handle val, handle ty, string name);
extern handle LLVMBuildSExt(handle builder, handle val, handle ty, string name);
extern handle LLVMBuildTrunc(handle builder, handle val, handle ty, string name);
extern handle LLVMBuildSIToFP(handle builder, handle val, handle ty, string name);
extern handle LLVMBuildFPTrunc(handle builder, handle val, handle ty, string name);
extern handle LLVMBuildFPExt(handle builder, handle val, handle ty, string name);
extern handle LLVMBuildNot(handle builder, handle val, string name);
extern handle LLVMBuildNeg(handle builder, handle val, string name);
extern handle LLVMBuildFNeg(handle builder, handle val, string name);
extern handle LLVMBuildSelect(handle builder, handle cond, handle then, handle otherwise, string name);
extern handle LLVMBuildPHI(handle builder, handle ty, string name);
extern void LLVMAddIncoming(handle phi, handle val, handle block);

// Constant operations
extern handle LLVMConstInt(handle ty, long val, int signExtend);
extern handle LLVMConstReal(handle ty, double val);
extern handle LLVMConstString(string str, int length, int dontNullTerminate);
extern handle LLVMConstNull(handle ty);
extern handle LLVMGetUndef(handle ty);

// Global variable operations
extern handle LLVMAddGlobal(handle m, handle ty, string name);
extern void LLVMSetGlobalConstant(handle global, int isConstant);
extern void LLVMSetInitializer(handle global, handle constant);

// Target machine operations
extern handle LLVMCreateTargetMachine(handle target, string triple, string cpu, string features, int relocMode, int codeModel, int optimizationLevel);
extern void LLVMDisposeTargetMachine(handle tm);
extern int LLVMTargetMachineEmitToFile(handle tm, handle m, string filename, int fileType, handle errorMessage);

// Analysis
extern int LLVMVerifyModule(handle m, int action, handle errorMessage);

// Initialization
extern void LLVMInitializeX86TargetInfo();
extern void LLVMInitializeX86Target();
extern void LLVMInitializeX86TargetMC();
extern void LLVMInitializeX86AsmPrinter();
extern void LLVMInitializeAArch64TargetInfo();
extern void LLVMInitializeAArch64Target();
extern void LLVMInitializeAArch64TargetMC();
extern void LLVMInitializeAArch64AsmPrinter();
