            }
            if (m == "Clear") {
                Emit(g, "  call void @kx_list_clear(i64 " + bv + ")");
                return "void 0";
            }
            if (m == "Length") {
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call i64 @kx_str_len(ptr " + bv + ")");
                return "i64 " + r;
            }
            if (m == "Substring") {
                var a1 = GenExpr(g, Child(arena, e, 1), arena);
                var bv2 = bv;
                if (bt == "i64") { g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0)); Emit(g, "  " + ext + " = inttoptr i64 " + bv + " to ptr"); bv2 = ext; }
                var a1v = XVal(a1);
                if (XType(a1) == "i32") { g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0)); Emit(g, "  " + ext + " = sext i32 " + a1v + " to i64"); a1v = ext; }
                var a2v = "";
                if (e.children.Count > 2) {
                    var a2 = GenExpr(g, Child(arena, e, 2), arena);
                    a2v = XVal(a2);
                    if (XType(a2) == "i32") { g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0)); Emit(g, "  " + ext + " = sext i32 " + a2v + " to i64"); a2v = ext; }
                } else {
                    g.lc.Set(0, g.lc.Get(0) + 1); var lenr = "%r." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + lenr + " = call i64 @kx_str_len(ptr " + bv2 + ")");
                    g.lc.Set(0, g.lc.Get(0) + 1); var subr = "%r." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + subr + " = call ptr @kx_str_substr(ptr " + bv2 + ", i64 " + a1v + ", i64 " + lenr + ")");
                    return "ptr " + subr;
                }
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call ptr @kx_str_substr(ptr " + bv2 + ", i64 " + a1v + ", i64 " + a2v + ")");
                return "ptr " + r;
            }
            if (m == "Contains") {
                var a = GenExpr(g, Child(arena, e, 1), arena);
                var bv2 = bv;
                if (bt == "i64") { g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0)); Emit(g, "  " + ext + " = inttoptr i64 " + bv + " to ptr"); bv2 = ext; }
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call i1 @kx_str_contains(ptr " + bv2 + ", ptr " + XVal(a) + ")");
                return "i1 " + r;
            }
            if (m == "StartsWith") {
                var a = GenExpr(g, Child(arena, e, 1), arena);
                var bv2 = bv;
                if (bt == "i64") { g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0)); Emit(g, "  " + ext + " = inttoptr i64 " + bv + " to ptr"); bv2 = ext; }
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call i1 @kx_str_starts_with(ptr " + bv2 + ", ptr " + XVal(a) + ")");
                return "i1 " + r;
            }
            if (m == "EndsWith") {
                var a = GenExpr(g, Child(arena, e, 1), arena);
                var bv2 = bv;
                if (bt == "i64") { g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0)); Emit(g, "  " + ext + " = inttoptr i64 " + bv + " to ptr"); bv2 = ext; }
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call i1 @kx_str_ends_with(ptr " + bv2 + ", ptr " + XVal(a) + ")");
                return "i1 " + r;
            }
            if (m == "Upper") {
                var bv2 = bv;
                if (bt == "i64") { g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0)); Emit(g, "  " + ext + " = inttoptr i64 " + bv + " to ptr"); bv2 = ext; }
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call ptr @kx_str_upper(ptr " + bv2 + ")");
                return "ptr " + r;
            }
            if (m == "Lower") {
                var bv2 = bv;
                if (bt == "i64") { g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0)); Emit(g, "  " + ext + " = inttoptr i64 " + bv + " to ptr"); bv2 = ext; }
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call ptr @kx_str_lower(ptr " + bv2 + ")");
                return "ptr " + r;
            }
        }
        if (callee.kind == "identifier") {
             if (callee.value == "IntStr") {
                var a = GenExpr(g, Child(arena, e, 1), arena);
                var av = XVal(a);
                if (XType(a) == "i32") {
                    g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + ext + " = sext i32 " + av + " to i64");
                    av = ext;
                } else if (XType(a) == "ptr") {
                    g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + ext + " = ptrtoint ptr " + av + " to i64");
                    av = ext;
                }
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call ptr @kx_int_str(i64 " + av + ")");
                return "ptr " + r;
            }
            if (callee.value == "List") {
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call i64 @kx_list_new(i32 0)");
                return "i64 " + r;
            }
            if (callee.value == "Map") {
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call i64 @kx_map_new(i32 0, i32 0)");
                return "i64 " + r;
            }
            if (callee.value == "panic") {
                var a = GenExpr(g, Child(arena, e, 1), arena);
                Emit(g, "  call void @kx_panic(ptr " + XVal(a) + ")");
                return "void 0";
            }
            if (callee.value == "exit") {
                var a = GenExpr(g, Child(arena, e, 1), arena);
                Emit(g, "  call void @kx_exit(i32 " + XVal(a) + ")");
                return "void 0";
            }
            if (callee.value == "Chr") {
                var a = GenExpr(g, Child(arena, e, 1), arena);
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call ptr @kx_int_str(i64 " + XVal(a) + ")");
                return "ptr " + r;
            }
            if (callee.value == "Ord") {
                var a = GenExpr(g, Child(arena, e, 1), arena);
                g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
                Emit(g, "  " + r + " = call i64 @kx_str_len(ptr " + XVal(a) + ")");
                return "i64 " + r;
            }
            var signature = g.sigs.Has(callee.value) ? g.sigs.Get(callee.value) : "i64|";
            var callRet = SigRet(signature);
            var callParams = SigParams(signature);
            var argStr = "";
            for (var ai = 1; ai < e.children.Count; ai = ai + 1) {
                if (ai > 1) argStr = argStr + ", ";
                var a = GenExpr(g, Child(arena, e, ai), arena);
                var wantSemantic = ai - 1 < callParams.Count ? callParams.Get(ai - 1) : XType(a);
                var want = KxType(wantSemantic);
                var av = Coerce(g, a, want);
                argStr = argStr + want + " " + av;
            }
            g.lc.Set(0, g.lc.Get(0) + 1); var r = "%r." + IntStr(g.lc.Get(0));
            var callRetIR = KxType(callRet);
            if (callRetIR == "void") {
                Emit(g, "  call void @" + callee.value + "(" + argStr + ")");
                return "void 0";
            }
            Emit(g, "  " + r + " = call " + callRetIR + " @" + callee.value + "(" + argStr + ")");
            return callRetIR + " " + r;
        }
         return "i64 0";
    }
    if (e.kind == "ternary") {
        var cond = GenExpr(g, Child(arena, e, 0), arena);
        var cv = XVal(cond);
        if (XType(cond) == "i64") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = icmp ne i64 " + cv + ", 0");
            cv = ext;
        }
        g.lc.Set(0, g.lc.Get(0) + 1); var tl = "tern.then." + IntStr(g.lc.Get(0)); g.lc.Set(0, g.lc.Get(0) + 1); var el = "tern.else." + IntStr(g.lc.Get(0)); g.lc.Set(0, g.lc.Get(0) + 1); var ml = "tern.merge." + IntStr(g.lc.Get(0));
        Emit(g, "  br i1 " + cv + ", label %" + tl + ", label %" + el);
        Emit(g, tl + ":");
        var tv = GenExpr(g, Child(arena, e, 1), arena);
        Emit(g, "  br label %" + ml);
        Emit(g, el + ":");
        var fv = GenExpr(g, Child(arena, e, 2), arena);
        var tt = XType(tv);
        var ft = XType(fv);
        if (tt != ft && tt == "i64" && ft == "ptr") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = ptrtoint ptr " + XVal(fv) + " to i64");
            fv = "i64 " + ext;
        } else if (tt != ft && tt == "i64" && ft == "i32") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = sext i32 " + XVal(fv) + " to i64");
            fv = "i64 " + ext;
        } else if (tt != ft && tt == "i64" && ft == "i1") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = zext i1 " + XVal(fv) + " to i64");
            fv = "i64 " + ext;
        } else if (tt != ft && tt == "i32" && ft == "i64") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = trunc i64 " + XVal(fv) + " to i32");
            fv = "i32 " + ext;
        } else if (tt != ft && tt == "i1" && ft == "i64") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = icmp ne i64 " + XVal(fv) + ", 0");
            fv = "i1 " + ext;
        } else if (tt != ft && tt == "ptr" && ft == "i64") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = inttoptr i64 " + XVal(fv) + " to ptr");
            fv = "ptr " + ext;
        }
        Emit(g, "  br label %" + ml);
        Emit(g, ml + ":");
        g.lc.Set(0, g.lc.Get(0) + 1); var t = "%phi." + IntStr(g.lc.Get(0));
        Emit(g, "  " + t + " = phi " + XType(tv) + " [" + XVal(tv) + ", %" + tl + "], [" + XVal(fv) + ", %" + el + "]");
        return XType(tv) + " " + t;
    }
    if (e.kind == "assign") {
        var rhs = GenExpr(g, Child(arena, e, 1), arena);
        var lhs = Child(arena, e, 0);
        if (lhs.kind == "identifier" && g.ln.Has(lhs.value)) {
            var lhsType = g.lt.Get(lhs.value);
            var rhsType = XType(rhs);
            var rhsVal = XVal(rhs);
            if (lhsType != rhsType) {
                if (lhsType == "i64" && rhsType == "i32") {
                    g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + ext + " = sext i32 " + rhsVal + " to i64");
                    rhsVal = ext; rhsType = "i64";
                } else if (lhsType == "i32" && rhsType == "i64") {
                    g.lc.Set(0, g.lc.Get(0) + 1); var trunc = "%trunc." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + trunc + " = trunc i64 " + rhsVal + " to i32");
                    rhsVal = trunc; rhsType = "i32";
                } else if (lhsType == "ptr" && rhsType == "i64") {
                    g.lc.Set(0, g.lc.Get(0) + 1); var cast = "%inttoptr." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + cast + " = inttoptr i64 " + rhsVal + " to ptr");
                    rhsVal = cast; rhsType = "ptr";
                } else if (lhsType == "i64" && rhsType == "ptr") {
                    g.lc.Set(0, g.lc.Get(0) + 1); var cast = "%ptrtoint." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + cast + " = ptrtoint ptr " + rhsVal + " to i64");
                    rhsVal = cast; rhsType = "i64";
                }
            }
            Emit(g, "  store " + rhsType + " " + rhsVal + ", ptr " + g.ln.Get(lhs.value));
            return lhsType + " " + rhsVal;
        }
        return rhs;
    }
    return "i64 0";
}

// ---- statement codegen ----

var GenStmt(g, s, arena) {
    if (s.kind == "vardecl") {
        var nm = Child(arena, s, 0).value;
        var rhs = GenExpr(g, Child(arena, s, 1), arena);
        var rt = XType(rhs);
        var rv = XVal(rhs);
        var uniqueNm = nm + "." + IntStr(g.vc.Get(0));
        g.vc.Set(0, g.vc.Get(0) + 1);
        if (Child(arena, s, 1).kind == "structinit") {
            var structName = Child(arena, s, 1).value;
            if (g.structs.Has(structName)) {
                Emit(g, "  %" + uniqueNm + " = alloca i64");
                Emit(g, "  store i64 " + rv + ", ptr %" + uniqueNm);
                g.lt.Set(nm, "struct:" + structName);
                g.ln.Set(nm, "%" + uniqueNm);
                return 0;
            }
        }
        Emit(g, "  %" + uniqueNm + " = alloca " + rt);
        Emit(g, "  store " + rt + " " + rv + ", ptr %" + uniqueNm);
        g.lt.Set(nm, rt); g.ln.Set(nm, "%" + uniqueNm);
        var rhsNode = Child(arena, s, 1);
        if (rhsNode.kind == "call" && rhsNode.children.Count > 0) {
            var callee = Child(arena, rhsNode, 0);
            if (callee.kind == "identifier" && callee.value == "List" && rhsNode.children.Count > 1) {
                var ta = Child(arena, rhsNode, 1);
                if (ta.kind == "typearg") {
                    g.listElem.Set(nm, ta.value);
                }
            }
        }
        return 0;
    }
    if (s.kind == "expr") { GenExpr(g, Child(arena, s, 0), arena); return 0; }
     if (s.kind == "return") {
        if (s.children.Count > 0) {
            var v = GenExpr(g, Child(arena, s, 0), arena);
            var vt = XType(v);
            var vv = XVal(v);
            if (g.curFnRet == "i64" && vt == "i1") {
                g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                Emit(g, "  " + ext + " = zext i1 " + vv + " to i64");
                vv = ext; vt = "i64";
            } else if (g.curFnRet == "i64" && vt == "i32") {
                g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                Emit(g, "  " + ext + " = sext i32 " + vv + " to i64");
                vv = ext; vt = "i64";
            } else if (g.curFnRet == "i64" && vt == "ptr") {
                g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                Emit(g, "  " + ext + " = ptrtoint ptr " + vv + " to i64");
                vv = ext; vt = "i64";
            } else if (g.curFnRet == "i1" && vt == "i64") {
                g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                Emit(g, "  " + ext + " = icmp ne i64 " + vv + ", 0");
                vv = ext; vt = "i1";
            } else if (g.curFnRet == "i32" && vt == "i64") {
                g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                Emit(g, "  " + ext + " = trunc i64 " + vv + " to i32");
                vv = ext; vt = "i32";
            } else if (g.curFnRet == "i32" && vt == "i1") {
                g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                Emit(g, "  " + ext + " = zext i1 " + vv + " to i32");
                vv = ext; vt = "i32";
            } else if (g.curFnRet == "ptr" && vt == "i64") {
                g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
                Emit(g, "  " + ext + " = inttoptr i64 " + vv + " to ptr");
                vv = ext; vt = "ptr";
            }
            Emit(g, "  ret " + vt + " " + vv);
        } else { Emit(g, "  ret void"); }
        return 0;
    }
    if (s.kind == "block") {
        for (var i = 0; i < s.children.Count; i = i + 1) { GenStmt(g, Child(arena, s, i), arena); }
        return 0;
    }
    if (s.kind == "if") {
        var c = GenExpr(g, Child(arena, s, 0), arena);
        var cv = XVal(c);
        if (XType(c) == "i64") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = icmp ne i64 " + cv + ", 0");
            cv = ext;
        }
        g.lc.Set(0, g.lc.Get(0) + 1); var tl = "if.then." + IntStr(g.lc.Get(0)); g.lc.Set(0, g.lc.Get(0) + 1); var ml = "if.merge." + IntStr(g.lc.Get(0));
        if (s.children.Count > 2) {
            g.lc.Set(0, g.lc.Get(0) + 1); var el = "if.else." + IntStr(g.lc.Get(0));
            Emit(g, "  br i1 " + cv + ", label %" + tl + ", label %" + el);
            Emit(g, tl + ":"); GenStmt(g, Child(arena, s, 1), arena); Emit(g, "  br label %" + ml);
            Emit(g, el + ":"); GenStmt(g, Child(arena, s, 2), arena); Emit(g, "  br label %" + ml);
        } else {
            Emit(g, "  br i1 " + cv + ", label %" + tl + ", label %" + ml);
            Emit(g, tl + ":"); GenStmt(g, Child(arena, s, 1), arena); Emit(g, "  br label %" + ml);
        }
        Emit(g, ml + ":");
        return 0;
    }
    if (s.kind == "while") {
        g.lc.Set(0, g.lc.Get(0) + 1); var cl = "w.cond." + IntStr(g.lc.Get(0)); g.lc.Set(0, g.lc.Get(0) + 1); var bl = "w.body." + IntStr(g.lc.Get(0)); g.lc.Set(0, g.lc.Get(0) + 1); var el = "w.end." + IntStr(g.lc.Get(0));
        Emit(g, "  br label %" + cl); Emit(g, cl + ":");
        var c = GenExpr(g, Child(arena, s, 0), arena);
        var cv = XVal(c);
        if (XType(c) == "i64") {
            g.lc.Set(0, g.lc.Get(0) + 1); var ext = "%ext." + IntStr(g.lc.Get(0));
            Emit(g, "  " + ext + " = icmp ne i64 " + cv + ", 0");
            cv = ext;
        }
        Emit(g, "  br i1 " + cv + ", label %" + bl + ", label %" + el);
        Emit(g, bl + ":");
        g.breakTargets.Add(el);
        g.continueTargets.Add(cl);
        GenStmt(g, Child(arena, s, 1), arena);
        g.breakTargets.RemoveAt(g.breakTargets.Count - 1);
        g.continueTargets.RemoveAt(g.continueTargets.Count - 1);
        Emit(g, "  br label %" + cl);
        Emit(g, el + ":");
        return 0;
    }
    if (s.kind == "for") {
        var bodyIdx = s.children.Count - 1;
        g.lc.Set(0, g.lc.Get(0) + 1); var condLabel = "for.cond." + IntStr(g.lc.Get(0));
        g.lc.Set(0, g.lc.Get(0) + 1); var bodyLabel = "for.body." + IntStr(g.lc.Get(0));
        g.lc.Set(0, g.lc.Get(0) + 1); var incLabel = "for.inc." + IntStr(g.lc.Get(0));
        g.lc.Set(0, g.lc.Get(0) + 1); var endLabel = "for.end." + IntStr(g.lc.Get(0));
        var i = 0;
        if (s.children.Count > 1 && arena.Get(s.children.Get(0)).kind == "vardecl") {
            GenStmt(g, Child(arena, s, 0), arena);
            i = 1;
        }
        Emit(g, "  br label %" + condLabel);
        Emit(g, condLabel + ":");
        if (i < bodyIdx) {
            var cond = GenExpr(g, Child(arena, s, i), arena);
            Emit(g, "  br i1 " + XVal(cond) + ", label %" + bodyLabel + ", label %" + endLabel);
            i = i + 1;
        } else {
            Emit(g, "  br label %" + bodyLabel);
        }
        Emit(g, bodyLabel + ":");
        g.breakTargets.Add(endLabel);
        g.continueTargets.Add(incLabel);
        GenStmt(g, Child(arena, s, bodyIdx), arena);
        g.breakTargets.RemoveAt(g.breakTargets.Count - 1);
        g.continueTargets.RemoveAt(g.continueTargets.Count - 1);
        Emit(g, "  br label %" + incLabel);
        Emit(g, incLabel + ":");
        if (i < bodyIdx) {
            GenExpr(g, Child(arena, s, i), arena);
        }
        Emit(g, "  br label %" + condLabel);
        Emit(g, endLabel + ":");
        return 0;
    }
    if (s.kind == "foreach") {
        var varNm = Child(arena, s, 0).value;
        var container = GenExpr(g, Child(arena, s, 1), arena);
        var cv = XVal(container);
        g.lc.Set(0, g.lc.Get(0) + 1); var idxVar = "%fe.idx." + IntStr(g.lc.Get(0));
        g.lc.Set(0, g.lc.Get(0) + 1); var elemVar = "%fe.elem." + IntStr(g.lc.Get(0));
        Emit(g, "  " + elemVar + " = alloca i64");
        Emit(g, "  " + idxVar + " = alloca i64");
        Emit(g, "  store i64 0, ptr " + idxVar);
        g.lc.Set(0, g.lc.Get(0) + 1); var cl = "fe.cond." + IntStr(g.lc.Get(0));
        g.lc.Set(0, g.lc.Get(0) + 1); var bl = "fe.body." + IntStr(g.lc.Get(0));
        g.lc.Set(0, g.lc.Get(0) + 1); var el = "fe.end." + IntStr(g.lc.Get(0));
        Emit(g, "  br label %" + cl);
        Emit(g, cl + ":");
        g.lc.Set(0, g.lc.Get(0) + 1); var idx = "%idx." + IntStr(g.lc.Get(0));
        Emit(g, "  " + idx + " = load i64, ptr " + idxVar);
        g.lc.Set(0, g.lc.Get(0) + 1); var len = "%len." + IntStr(g.lc.Get(0));
        Emit(g, "  " + len + " = call i64 @kx_list_size(i64 " + cv + ")");
        g.lc.Set(0, g.lc.Get(0) + 1); var cmp = "%cmp." + IntStr(g.lc.Get(0));
        Emit(g, "  " + cmp + " = icmp slt i64 " + idx + ", " + len);
        Emit(g, "  br i1 " + cmp + ", label %" + bl + ", label %" + el);
        Emit(g, bl + ":");
        g.lc.Set(0, g.lc.Get(0) + 1); var elem = "%elem." + IntStr(g.lc.Get(0));
        Emit(g, "  " + elem + " = call i64 @kx_list_get(i64 " + cv + ", i64 " + idx + ")");
        Emit(g, "  store i64 " + elem + ", ptr " + elemVar);
        g.lt.Set(varNm, "i64"); g.ln.Set(varNm, elemVar);
        g.breakTargets.Add(el);
        g.continueTargets.Add(cl);
        GenStmt(g, Child(arena, s, 2), arena);
        g.breakTargets.RemoveAt(g.breakTargets.Count - 1);
        g.continueTargets.RemoveAt(g.continueTargets.Count - 1);
        g.lc.Set(0, g.lc.Get(0) + 1); var nextIdx = "%next." + IntStr(g.lc.Get(0));
        Emit(g, "  " + nextIdx + " = add i64 " + idx + ", 1");
        Emit(g, "  store i64 " + nextIdx + ", ptr " + idxVar);
        Emit(g, "  br label %" + cl);
        Emit(g, el + ":");
        return 0;
    }
    if (s.kind == "switch") {
        var cond = GenExpr(g, Child(arena, s, 0), arena);
        g.lc.Set(0, g.lc.Get(0) + 1); var endLabel = "sw.end." + IntStr(g.lc.Get(0));
        var defaultLabel = endLabel;
        var caseLabels = List<string>();
        for (var ci = 1; ci < s.children.Count; ci = ci + 1) {
            g.lc.Set(0, g.lc.Get(0) + 1); caseLabels.Add("sw.case." + IntStr(g.lc.Get(0)));
        }
        var hasDefault = false;
        for (var ci = 1; ci < s.children.Count; ci = ci + 1) {
            var caseNode = Child(arena, s, ci);
            var blockChild = -1;
            for (var k = 0; k < caseNode.children.Count; k = k + 1) {
                if (arena.Get(caseNode.children.Get(k)).kind == "block") {
                    blockChild = k;
                    break;
                }
            }
            if (blockChild >= 0) {
                var last = -1;
                var blk = Child(arena, caseNode, blockChild);
                if (blk.children.Count > 0) {
                    last = blk.children.Count - 1;
                    var lastStmt = arena.Get(blk.children.Get(last));
                    if (lastStmt.kind == "return" || lastStmt.kind == "break") {
                    } else { last = -1; }
                }
            }
        }
        for (var ci = 1; ci < s.children.Count; ci = ci + 1) {
            var caseNode = Child(arena, s, ci);
            Emit(g, "  br label %" + caseLabels.Get(ci - 1));
            Emit(g, caseLabels.Get(ci - 1) + ":");
            for (var k = 0; k < caseNode.children.Count; k = k + 1) {
                var child = Child(arena, caseNode, k);
                if (child.kind == "block") {
                    GenStmt(g, child, arena);
                } else {
                    var cv = GenExpr(g, child, arena);
                    g.lc.Set(0, g.lc.Get(0) + 1); var cmp = "%cmp." + IntStr(g.lc.Get(0));
                    Emit(g, "  " + cmp + " = icmp eq " + XType(cond) + " " + XVal(cond) + ", " + XVal(cv));
                    g.lc.Set(0, g.lc.Get(0) + 1); var trueLabel = "sw.true." + IntStr(g.lc.Get(0));
                    Emit(g, "  br i1 " + cmp + ", label %" + trueLabel + ", label %" + caseLabels.Get(ci));
                    Emit(g, trueLabel + ":");
                }
            }
        }
        Emit(g, endLabel + ":");
        return 0;
    }
    if (s.kind == "spawn") {
        // spawn { Component { field = value } }
        // For now, spawn with tag mask 0 (would need proper tag computation)
        g.lc.Set(0, g.lc.Get(0) + 1); var entity = "%entity." + IntStr(g.lc.Get(0));
        Emit(g, "  " + entity + " = call i64 @kx_spawn(i64 0)");
        // Set result for later use
        g.ln.Set("spawn_result", entity);
        g.lt.Set("spawn_result", "i64");
        return 0;
    }
    if (s.kind == "attach") {
        // attach(entity, Component)
        if (s.children.Count >= 2) {
            var entityExpr = GenExpr(g, Child(arena, s, 0), arena);
            var compName = Child(arena, s, 1).value;
            var compIdx = GetCompIdx(g, compName);
            if (compIdx >= 0) {
                Emit(g, "  call void @kx_attach(i64 " + XVal(entityExpr) + ", i32 " + IntStr(compIdx) + ")");
            }
        }
        return 0;
    }
    if (s.kind == "detach") {
        // detach(entity, Component)
        if (s.children.Count >= 2) {
            var entityExpr = GenExpr(g, Child(arena, s, 0), arena);
            var compName = Child(arena, s, 1).value;
            var compIdx = GetCompIdx(g, compName);
            if (compIdx >= 0) {
                Emit(g, "  call void @kx_detach(i64 " + XVal(entityExpr) + ", i32 " + IntStr(compIdx) + ")");
            }
        }
        return 0;
    }
    if (s.kind == "despawn") {
        // despawn entity
        if (s.children.Count >= 1) {
            var entityExpr = GenExpr(g, Child(arena, s, 0), arena);
            Emit(g, "  call void @kx_despawn(i64 " + XVal(entityExpr) + ")");
        }
        return 0;
    }
    if (s.kind == "break") {
        if (g.breakTargets.Count > 0) Emit(g, "  br label %" + g.breakTargets.Get(g.breakTargets.Count - 1));
        return 0;
    }
    if (s.kind == "continue") {
        if (g.continueTargets.Count > 0) Emit(g, "  br label %" + g.continueTargets.Get(g.continueTargets.Count - 1));
        return 0;
    }
    return 0;
}

var GetCompIdx(g, name) {
    // Would need to track component indices from declarations
    // For now return -1 (not found)
    return -1;
}

// ---- function codegen ----

var GenFunc(g, decl, arena) {
    var nm = Child(arena, decl, 0).value;
    var ret = Child(arena, decl, 1).value;
    var params = List<string>();
    for (var i = 2; i < decl.children.Count; i = i + 1) {
        var c = Child(arena, decl, i);
        if (c.kind == "param") params.Add(c.value);
    }
    var sig = g.sigs.Has(nm) ? g.sigs.Get(nm) : KxType(ret) + "|";
    var sigParams = SigParams(sig);
    var irRet = KxType(SigRet(sig)); if (nm == "main") irRet = "i32";
    g.curFnRet = irRet;
    g.curFnName = nm;
    var irP = "";
    if (nm == "main") {
        irP = "i32 %argc, ptr %argv";
    } else {
        for (var i = 0; i < params.Count; i = i + 1) {
            if (i > 0) irP = irP + ", ";
            irP = irP + KxType(sigParams.Get(i)) + " %" + params.Get(i);
        }
    }
    Emit(g, "define " + irRet + " @" + nm + "(" + irP + ") {");
    Emit(g, "entry:");
    g.lt = Map<string, string>(); g.ln = Map<string, string>();
    g.breakTargets = List<string>();
    g.continueTargets = List<string>();
    g.terminated.Set(0, 0);
    if (nm == "main") {
        Emit(g, "  call void @kx_save_args(i32 %argc, ptr %argv)");
    }
    for (var i = 0; i < params.Count; i = i + 1) {
        var p = params.Get(i);
        var pType = KxType(sigParams.Get(i));
        var allocaNm = "%" + p + ".addr";
        Emit(g, "  " + allocaNm + " = alloca " + pType);
        Emit(g, "  store " + pType + " %" + p + ", ptr " + allocaNm);
        g.lt.Set(p, sigParams.Get(i)); g.ln.Set(p, allocaNm);
    }
    GenStmt(g, Child(arena, decl, decl.children.Count - 1), arena);
    if (ret == "void") {
        Emit(g, "  ret void");
    } else if (nm == "main") {
        Emit(g, "  ret i32 0");
    } else if (irRet == "ptr") {
        Emit(g, "  ret ptr null");
    } else if (irRet == "i1") {
        Emit(g, "  ret i1 false");
    } else {
        Emit(g, "  ret " + irRet + " 0");
    }
    Emit(g, "}"); Emit(g, "");
    return 0;
}

// ---- package manager helpers ----

var FindProjectRoot() {
    var dir = kx_system("pwd");
    // Would need to walk up looking for .kxconf
    return dir;
}

var ParseKxConf(path) {
    var content = kx_read_file(path);
    if (content == "") return Map<string, string>();
    var conf = Map<string, string>();
    var lines = SplitAll(content, "\n");
    var section = "";
    for (var i = 0; i < lines.Count; i = i + 1) {
        var line = lines.Get(i).Trim();
        if (line == "" || line.StartsWith("//")) continue;
        if (line.StartsWith("[")) {
            var end = line.IndexOf("]");
            if (end > 0) section = line.Substring(1, end - 1);
            continue;
        }
        var eq = line.IndexOf("=");
        if (eq > 0) {
            var key = line.Substring(0, eq).Trim();
            var val = line.Substring(eq + 1, line.Length - eq - 1).Trim();
            if (val.Length >= 2 && val.StartsWith("\"") && val.EndsWith("\"")) {
                val = val.Substring(1, val.Length - 2);
            }
            conf.Set(section + "." + key, val);
        }
    }
    return conf;
}

var CmdInit(name) {
    var dir = name;
    kx_system($"mkdir -p {dir}");
    var conf = $"[package]\nname = \"{name}\"\nversion = \"0.1.0\"\n\ntarget\nkind = \"binary\"\nentry = \"main.kx\"\n\ndependencies\n";
    kx_write_file($"{dir}/.kxconf", conf);
    kx_write_file($"{dir}/main.kx", "int main() {\n    kx_println(\"Hello from " + name + "!\");\n    return 0;\n}\n");
    kx_println($"created project {name}");
    return 0;
}

var CmdBuild(dir) {
    var conf = ParseKxConf("" + dir + ".kxconf");
    var entry = "";
    if (conf.Has("entry")) { entry = conf.Get("entry") + ""; }
    if (entry == "") { entry = "main.kx"; }
    var src = kx_read_file("" + dir + "/" + entry);
    if (src == "") {
        src = kx_read_file(dir);
        if (src == "") { kx_println($"error: cannot read {dir}/{entry}"); return 1; }
        entry = dir;
    }
    var tokens = LexAll(src);
    var pos = List<int>(); pos.Add(0);
    var arena = List<AstNode>();
    var errors = List<string>();
    var rootIdx = ParseProgram(tokens, pos, arena, errors, entry);
    if (errors.Count > 0) { for (var _ei = 0; _ei < errors.Count; _ei = _ei + 1) { kx_println(errors.Get(_ei)); } return 1; }
    var root = arena.Get(rootIdx);
    var g = NewIR();
    Emit(g, "target triple = \"x86_64-unknown-linux-gnu\"");
    Emit(g, "");
    EmitDecls(g);
    InferSignatures(g, root, arena);
    for (var i = 0; i < root.children.Count; i = i + 1) {
        var d = Child(arena, root, i);
        if (d.kind == "struct") {
            var sname = Child(arena, d, 0).value;
            var fieldStr = "";
            for (var fi = 1; fi < d.children.Count; fi = fi + 1) {
                var f = Child(arena, d, fi);
                if (f.kind == "field") {
                    if (fieldStr != "") fieldStr = fieldStr + ",";
                    fieldStr = fieldStr + f.value;
                }
            }
            g.structs.Set(sname, fieldStr);
        }
        if (d.kind == "function") GenFunc(g, d, arena);
        if (d.kind == "extern") {
            // Skip - EmitDecls already covers all runtime functions
        }
    }
    var out = "";
    for (var i = 0; i < g.lines.Count; i = i + 1) { out = out + g.lines.Get(i) + "\n"; }
    for (var pi = 0; pi < g.pending.Count; pi = pi + 1) { out = out + g.pending.Get(pi) + "\n"; }
    var _pname = "output";
    if (conf.Has("package.name")) _pname = conf.Get("package.name");
    var _base = dir;
    var _sl = dir.Length - 1;
    while (_sl >= 0 && dir.Substring(_sl, 1) != "/") { _sl = _sl - 1; }
    var _dirName = dir.Substring(_sl + 1, dir.Length - _sl - 1);
    var _ext = "";
    if (_dirName.Length > 3 && _dirName.Substring(_dirName.Length - 3, 3) == ".kx") { _ext = ".kx"; _base = dir.Substring(0, dir.Length - 3); }
    var buildDir = _base + ".build";
    kx_system($"mkdir -p {buildDir}");
    var llPath = $"{buildDir}/output.ll";
    var objPath = $"{buildDir}/output.o";
    var binPath = $"{buildDir}/{_pname}";
    kx_write_file(llPath, out);
    kx_println($"compiled {entry} -> {llPath}");
    var linkCmd = $"llc-21 {llPath} -filetype=obj -o {objPath} 2>&1 && gcc -no-pie {objPath} runtime/runtime.c -lm -o {binPath} 2>&1";
    var rc = kx_system(linkCmd);
    if (rc != 0) { kx_println("linking failed"); return 1; }
    kx_println($"built {binPath}");
    return 0;
}

var CmdRun(dir) {
    var conf = ParseKxConf($"{dir}/.kxconf");
    var name = "";
    if (conf.Has("package.name")) name = conf.Get("package.name");
    if (name == "") name = "output";
    var rc = CmdBuild(dir);
    if (rc != 0) return rc;
    return kx_system($"{dir}/build/{name}");
}

var CmdCheck(dir) {
    var entry = "main.kx";
    var src = kx_read_file($"{dir}/{entry}");
    if (src == "") { kx_println($"error: cannot read {dir}/{entry}"); return 1; }
    var tokens = LexAll(src);
    var pos = List<int>(); pos.Add(0);
    var arena = List<AstNode>();
    var errors = List<string>();
    var rootIdx = ParseProgram(tokens, pos, arena, errors, entry);
    if (errors.Count > 0) { for (var _ei = 0; _ei < errors.Count; _ei = _ei + 1) { kx_println(errors.Get(_ei)); } return 1; }
    kx_println("check: OK");
    return 0;
}

var CmdNew(name) {
    return CmdInit(name);
}

var CmdPublish() {
    var conf = ParseKxConf(".kxconf");
    var name = "";
    if (conf.Has("package.name")) name = conf.Get("package.name");
    var version = "";
    if (conf.Has("package.version")) version = conf.Get("package.version");
    if (name == "" || version == "") {
        kx_println("error: .kxconf must have package.name and package.version");
        return 1;
    }
    kx_println($"publishing {name}@{version}...");
    kx_println("(publish requires registry connection)");
    return 0;
}

var CmdInstall(pkg) {
    kx_println($"installing {pkg}...");
    kx_println("(install requires registry connection)");
    return 0;
}

var CmdSearch(query) {
    kx_println($"searching for {query}...");
    kx_println("(search requires registry connection)");
    return 0;
}

var CmdLogin() {
    kx_println("login requires registry connection");
    return 0;
}

var CmdKeygen() {
    kx_println("generating signing key...");
    kx_system("openssl ecparam -genkey -name ed25519 -out ~/.kubex/key.pem 2>/dev/null");
    kx_println("key generated at ~/.kubex/key.pem");
    return 0;
}

var CmdSbom() {
    kx_println("generating SBOM...");
    kx_println("(SBOM generation not yet implemented)");
    return 0;
}

var CmdAudit() {
    kx_println("scanning for vulnerabilities...");
    kx_system("osv-scanner 2>/dev/null || echo 'osv-scanner not installed'");
    return 0;
}

var PrintUsage() {
    kx_println("kubex -- Kubexic compiler and package manager");
    kx_println("");
    kx_println("compiler commands:");
    kx_println("  build <dir>      Compile .kx files to native executable");
    kx_println("  run <dir>        Compile and execute");
    kx_println("  check <dir>      Type-check a project");
    kx_println("  new <name>       Create a new project");
    kx_println("  init <name>      Create a new project");
    kx_println("");
    kx_println("package commands:");
    kx_println("  publish          Publish to registry");
    kx_println("  install <pkg>    Install a package");
    kx_println("  search <query>   Search packages");
    kx_println("  login            Authenticate");
    kx_println("  keygen           Generate signing keys");
    kx_println("  sbom             Generate SBOM");
    kx_println("  audit            Scan for vulnerabilities");
    kx_println("");
    kx_println("options:");
    kx_println("  --help, -h       Show this help");
    kx_println("  --version        Show version");
    return 0;
}

// ---- main ----

int main() {
    var args = List<string>();
    var _ac = kx_argc();
    var _ai = 0;
    while (_ai < _ac) { args.Add(kx_argv(_ai)); _ai = _ai + 1; }
    if (args.Count < 2) { PrintUsage(); return 0; }
    var cmd = args.Get(1);
    if (cmd == "--help" || cmd == "-h") { PrintUsage(); return 0; }
    if (cmd == "--version") { kx_println("kubex 0.1.0"); return 0; }
    if (cmd == "init" || cmd == "new") {
        if (args.Count < 3) { kx_println("usage: kubex init <name>"); return 1; }
        return CmdInit(args.Get(2));
    }
    if (cmd == "build") {
        var dir = args.Count > 2 ? args.Get(2) : ".";
        return CmdBuild(dir);
    }
    if (cmd == "run") {
        var dir = args.Count > 2 ? args.Get(2) : ".";
        return CmdRun(dir);
    }
    if (cmd == "check") {
        var dir = args.Count > 2 ? args.Get(2) : ".";
        return CmdCheck(dir);
    }
    if (cmd == "publish") { return CmdPublish(); }
    if (cmd == "install") {
        if (args.Count < 3) { kx_println("usage: kubex install <pkg>"); return 1; }
        return CmdInstall(args.Get(2));
    }
    if (cmd == "search") {
        if (args.Count < 3) { kx_println("usage: kubex search <query>"); return 1; }
        return CmdSearch(args.Get(2));
    }
    if (cmd == "login") { return CmdLogin(); }
    if (cmd == "keygen") { return CmdKeygen(); }
    if (cmd == "sbom") { return CmdSbom(); }
    if (cmd == "audit") { return CmdAudit(); }
    kx_println($"unknown command: {cmd}");
    kx_println("run 'kubex --help' for usage");
    return 1;
}
