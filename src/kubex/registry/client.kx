// client.kx — HTTP registry client for Kubexic, written in Kubexic.
// Communicates with the package registry via curl shell-outs.

var CurlGet(url) {
    var tmpFile = "/tmp/kubex_http_resp";
    var cmd = $"curl -s -o {tmpFile} '{url}'";
    std.system(cmd);
    return std.readFile(tmpFile);
}

var CurlPost(url, data, token) {
    var tmpFile = "/tmp/kubex_http_resp";
    var authHeader = "";
    if (token != "") {
        authHeader = $" -H 'Authorization: Bearer {token}'";
    }
    var cmd = $"curl -s -X POST -H 'Content-Type: application/json'{authHeader} -d '{data}' -o {tmpFile} '{url}'";
    std.system(cmd);
    return std.readFile(tmpFile);
}

var CurlPut(url, data, token) {
    var tmpFile = "/tmp/kubex_http_resp";
    var authHeader = "";
    if (token != "") {
        authHeader = $" -H 'Authorization: Bearer {token}'";
    }
    var cmd = $"curl -s -X PUT -H 'Content-Type: application/json'{authHeader} -d '{data}' -o {tmpFile} '{url}'";
    std.system(cmd);
    return std.readFile(tmpFile);
}

var GetRegistryUrl() {
    return "https://registry.kubexic.furkanlabs.tr/v1";
}

var RegistrySearch(query) {
    var url = $"{GetRegistryUrl()}/packages?q={query}";
    return CurlGet(url);
}

var RegistryGetPackage(name) {
    var url = $"{GetRegistryUrl()}/packages/{name}";
    return CurlGet(url);
}

var RegistryGetVersion(name, version) {
    var url = $"{GetRegistryUrl()}/packages/{name}/{version}";
    return CurlGet(url);
}

var RegistryDownload(name, version, destPath) {
    var url = $"{GetRegistryUrl()}/packages/{name}/{version}/download";
    var cmd = $"curl -s -o '{destPath}' '{url}'";
    std.system(cmd);
    return true;
}

var RegistryPublishSigned(name, version, archivePath, signature, publicKey) {
    var url = $"{GetRegistryUrl()}/packages/{name}/{version}";
    var cmd = $"curl -s -X PUT -F 'archive=@{archivePath}' -F 'signature={signature}' -F 'public_key={publicKey}' '{url}'";
    var rc = std.system(cmd);
    return rc == 0;
}
